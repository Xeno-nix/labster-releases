<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLMS.Agent.Views.MainPage" Title="CLMS Agent settings">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="CLMS Agent" FontSize="28" FontAttributes="Bold" />
            <Label Text="This PC connects in the background. Authorized staff can view its screen through CLMS Web. No local preview or recording is created." />
            <Label Text="Device setup" FontAttributes="Bold" />
            <Label Text="Enter the server address and device key supplied by your administrator. Saving setup starts the connection automatically." />
            <Entry x:Name="ServerAddressEntry" Placeholder="HTTPS server address" Keyboard="Url" />
            <Entry x:Name="DeviceKeyEntry" Placeholder="Device key for this unit" IsPassword="True" />
            <Button x:Name="SaveSetupButton" Text="Save setup and connect" Clicked="OnSaveSetupClicked" />
            <Label x:Name="SetupStatusLabel" Text="Loading setup" />
            <Label Text="Agent status" FontAttributes="Bold" />
            <Label x:Name="RuntimeStatusLabel" />
            <Label x:Name="ConnectionStatusLabel" />
            <HorizontalStackLayout Spacing="12">
                <Button x:Name="ConnectButton" Text="Reconnect" Clicked="OnConnectClicked" />
                <Button x:Name="DisconnectButton" Text="Pause connection" Clicked="OnDisconnectClicked" />
            </HorizontalStackLayout>
            <Label x:Name="SharingStatusLabel" Text="Not sharing with a viewer" />
            <Button x:Name="StopSharingButton" Text="Stop screen sharing" Clicked="OnStopSharingClicked" IsEnabled="False" />
            <Label Text="Startup" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="12">
                <Switch x:Name="StartupSwitch" Toggled="OnStartupToggled" />
                <Label Text="Start when this OS user signs in" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label x:Name="StartupStatusLabel" />
            <HorizontalStackLayout Spacing="12">
                <Switch x:Name="StartHiddenSwitch" IsToggled="True" Toggled="OnStartHiddenToggled" />
                <Label Text="Open in the background after setup" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Use the CLMS tray or menu-bar indicator to reopen settings. Hide keeps the connection active; Quit stops it. Setup and startup apply to the current OS user." />
            <HorizontalStackLayout Spacing="12">
                <Button Text="Hide settings" Clicked="OnHideClicked" />
                <Button Text="Quit agent" Clicked="OnQuitClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
