<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLMS.Agent.Views.MainPage" x:Name="RegistrationPage" Title="CLMS Agent">
    <ScrollView><VerticalStackLayout Padding="32" Spacing="18" MaximumWidthRequest="640">
        <Label Text="Computer Laboratory Management System" FontSize="24" FontAttributes="Bold" />
        <Label x:Name="PhaseLabel" Text="Starting agent" FontSize="20" FontAttributes="Bold" />
        <Label x:Name="MessageLabel" Text="Loading this user's enrollment." FontSize="14" />
        <Label x:Name="ErrorLabel" IsVisible="False" TextColor="#B91C1C" />
        <VerticalStackLayout x:Name="ServerPanel" IsVisible="False" Spacing="10">
            <Label Text="HTTPS server address" /><Entry x:Name="ServerEntry" Placeholder="https://clms.lab:7443" Keyboard="Url" />
            <Button x:Name="ConfigureButton" Text="Connect to server" Clicked="ConfigureClicked" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="RegistrationPanel" IsVisible="False" Spacing="10">
            <Label Text="Laboratory" />
            <Picker x:Name="LaboratoryPicker" Title="Select a laboratory"
                    ItemsSource="{Binding Laboratories, Source={x:Reference RegistrationPage}}"
                    ItemDisplayBinding="{Binding Name}" SelectedIndexChanged="LaboratoryChanged" />
            <Label x:Name="LaboratoriesMessageLabel" IsVisible="False" FontSize="14" />
            <Button x:Name="LaboratoriesButton" Text="Reload laboratories" Clicked="LaboratoriesClicked" />
            <Label Text="Unit number (1–255)" /><Entry x:Name="UnitNumberEntry" Placeholder="1" Keyboard="Numeric" MaxLength="3" />
            <Button x:Name="RegisterButton" Text="Request registration" Clicked="RegisterClicked" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="CodePanel" IsVisible="False" Spacing="10">
            <Label Text="Show this code on this physical computer to the laboratory administrator:" />
            <Label x:Name="CodeLabel" FontSize="38" FontAttributes="Bold" CharacterSpacing="5" HorizontalTextAlignment="Center" />
            <Label x:Name="ExpiryLabel" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <Label x:Name="UnitLabel" IsVisible="False" />
        <Button x:Name="RetryButton" Text="Start a new registration" IsVisible="False" Clicked="RetryClicked" />
        <Button x:Name="RefreshStatusButton" Text="Refresh status" Clicked="RefreshClicked" />
        <Label x:Name="RuntimeLabel" />
        <Label x:Name="ConnectionLabel" />
        <Label x:Name="SharingLabel" />
        <Label x:Name="MonitoringLabel" />
        <Label Text="Desktop notifications" FontAttributes="Bold" />
        <Label x:Name="NotificationsLabel" />
        <Button x:Name="NotificationsButton" Text="Enable desktop notifications" Clicked="NotificationsClicked" />
        <Button x:Name="ConnectButton" Text="Reconnect" Clicked="ConnectClicked" />
        <Button x:Name="PauseButton" Text="Pause connection" Clicked="PauseClicked" />
        <Button x:Name="StopSharingButton" Text="Stop screen sharing" Clicked="StopSharingClicked" />
        <Button x:Name="RotateButton" Text="Rotate device key" Clicked="RotateClicked" />
        <Button x:Name="ResetButton" Text="Reset local enrollment" Clicked="ResetClicked" />
        <Label Text="Start at this user's login" /><Switch x:Name="StartupSwitch" Toggled="StartupChanged" />
        <Label x:Name="StartupLabel" />
        <Label Text="Start with settings hidden after enrollment" /><Switch x:Name="HiddenSwitch" Toggled="HiddenChanged" />
        <Button Text="Hide settings" Clicked="HideClicked" />
        <Button Text="Quit agent" Clicked="QuitClicked" />
        <ActivityIndicator x:Name="Activity" IsVisible="False" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
