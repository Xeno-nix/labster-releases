@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject CLMS.Web.Authentication.HumanAuthorizationCache AuthorizationCache
@inject ILogger<MainLayout> Logger
@using CLMS.Web.Components.Notification
@using CLMS.Web.Components.Modals
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

@if (!_authorizationReady)
{
    <AuthenticationLoading />
}
else if (_authorizationError is not null)
{
    <main class="min-h-screen flex items-center justify-center p-6" role="alert">@_authorizationError</main>
}
else
{
<ToastContainer/>
<Dialog/>

<div class="app-shell flex h-screen overflow-hidden @(_sidebarCollapsed ? "sidebar-collapsed" : "")" @onkeydown="HandleKeyDown">

    @if (_mobileSidebarOpen)
    {
        <button type="button" class="sidebar-overlay" aria-label="Close navigation" @onclick="CloseMobileSidebar"></button>
    }

    @* Sidebar — fixed/slide-in on mobile, normal flex on lg+ *@
    <aside id="main-sidebar" aria-label="Main navigation"
           class="sidebar @(_mobileSidebarOpen ? "sidebar-mobile-open" : "") bg-white border-r border-black/10 flex flex-col flex-shrink-0">

        @* Logo + mobile close *@
        <div class="sidebar-header border-b border-black/10 flex items-center justify-between">
            <div class="sidebar-brand flex items-center gap-3">
                <div class="sidebar-logo w-10 h-10 bg-primary rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="14" x="2" y="3" rx="2" />
                        <path d="M8 21h8m-4-4v4" />
                    </svg>
                </div>
                <div class="sidebar-brand-text">
                    <p class="text-primary font-heading font-semibold text-base leading-tight">CLMS</p>
                    <p class="text-xs text-muted">USeP</p>
                </div>
            </div>
            <button type="button" class="sidebar-mobile-close p-1.5 rounded-lg hover:bg-surface transition-colors cursor-pointer"
                    aria-label="Close navigation" aria-controls="main-sidebar" @onclick="CloseMobileSidebar">
                <svg class="w-5 h-5 text-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18" />
                    <path d="m6 6 12 12" />
                </svg>
            </button>
            <button type="button" class="sidebar-desktop-toggle p-1.5 rounded-lg hover:bg-surface transition-colors cursor-pointer"
                    title="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                    aria-label="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                    aria-expanded="@(!_sidebarCollapsed ? "true" : "false")" aria-controls="main-sidebar" @onclick="ToggleSidebar">
                <svg class="w-5 h-5 text-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M9 3v18" />
                </svg>
            </button>
        </div>

        @* Navigation *@
        <nav class="sidebar-nav flex-1 p-4 overflow-y-auto">
            <ul class="space-y-1">
                <AuthorizeView Policy="@(Privileges.Prefix + Privileges.DashboardView)"><li>
                    <a href="/" title="Dashboard" aria-label="Dashboard" @onclick="CloseMobileSidebar" class="@NavClass("/", exact: true)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="7" height="9" x="3" y="3" rx="1" />
                            <rect width="7" height="5" x="14" y="3" rx="1" />
                            <rect width="7" height="9" x="14" y="12" rx="1" />
                            <rect width="7" height="5" x="3" y="16" rx="1" />
                        </svg>
                        <span class="sidebar-link-text">Dashboard</span>
                    </a>
                </li></AuthorizeView>
                <AuthorizeView Policy="@(Privileges.Prefix + Privileges.LogbookView)"><li>
                    <a href="/logbook" title="Logbook" aria-label="Logbook" @onclick="CloseMobileSidebar" class="@NavClass("/logbook", exact: true)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                        </svg>
                        <span class="sidebar-link-text">Logbook</span>
                    </a>
                </li></AuthorizeView>
                <AuthorizeView Policy="@(Privileges.Prefix + Privileges.UnitsView)"><li>
                    <a href="/unit-monitoring" title="Unit Monitoring" aria-label="Unit Monitoring" @onclick="CloseMobileSidebar" class="@NavClass("/unit-monitoring", exact: true)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="3" width="20" height="14" rx="2" />
                            <path d="M8 21h8m-4-4v4" />
                        </svg>
                        <span class="sidebar-link-text">Unit Monitoring</span>
                    </a>
                </li></AuthorizeView>
                <AuthorizeView Policy="@(Privileges.Prefix + Privileges.UsersView)"><li>
                    <a href="/admin/users" title="Users" aria-label="Users" @onclick="CloseMobileSidebar" class="@NavClass("/admin/users", exact: false)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <span class="sidebar-link-text">Users</span>
                    </a>
                </li></AuthorizeView>
                <AuthorizeView Policy="@(Privileges.Prefix + Privileges.ClassListsView)"><li>
                    <a href="/class-lists" title="Class Management" aria-label="Class Management" @onclick="CloseMobileSidebar" class="@NavClass("/class-lists", exact: false)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <span class="sidebar-link-text">Class Management</span>
                    </a>
                </li></AuthorizeView>
                <li>
                    <a href="/instructors" title="Instructors" aria-label="Instructors" @onclick="CloseMobileSidebar" class="@NavClass("/instructors", exact: false)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        <span class="sidebar-link-text">Instructors</span>
                    </a>
                </li>
                <AuthorizeView Policy="@(Privileges.Prefix + Privileges.BookingsView)"><li>
                    <a href="/bookings" title="Schedule &amp; Booking" aria-label="Schedule &amp; Booking" @onclick="CloseMobileSidebar" class="@NavClass("/bookings", exact: true)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 2v4" />
                            <path d="M16 2v4" />
                            <rect width="18" height="18" x="3" y="4" rx="2" />
                            <path d="M3 10h18" />
                        </svg>
                        <span class="sidebar-link-text">Schedule &amp; Booking</span>
                    </a>
                </li></AuthorizeView>
                <AuthorizeView Policy="@(Privileges.Prefix + Privileges.InventoryView)"><li>
                    <a href="/inventory" title="Inventory" aria-label="Inventory" @onclick="CloseMobileSidebar" class="@NavClass("/inventory", exact: true)">
                        <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m7.5 4.27 9 5.15" />
                            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                            <path d="m3.3 7 8.7 5 8.7-5" />
                            <path d="M12 22V12" />
                        </svg>
                        <span class="sidebar-link-text">Inventory</span>
                    </a>
                </li></AuthorizeView>

                    <AuthorizeView Policy="@(Privileges.Prefix + Privileges.MonitoringConfigure)"><li><a href="/admin/applications" @onclick="CloseMobileSidebar" class="@NavClass("/admin/applications", exact: true)"><span class="sidebar-link-text">Application Registry</span></a></li></AuthorizeView>
                    <AuthorizeView Policy="@(Privileges.Prefix + Privileges.UnitsManage)"><li>
                        <a href="/admin/unit-registry" title="Unit Registry" aria-label="Unit Registry" @onclick="CloseMobileSidebar" class="@NavClass("/admin/unit-registry", exact: true)">
                            <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="13" rx="2" /><path d="M8 21h8m-4-5v5m-5-10 3 3 6-6" /></svg>
                            <span class="sidebar-link-text">Unit Registry</span>
                        </a>
                    </li></AuthorizeView>
                    <AuthorizeView Policy="@(Privileges.Prefix + Privileges.BackupsView)"><li>
                        <a href="/admin/database-backups" class="@NavClass("/admin/database-backups", exact: true)">
                            <svg class="w-5 h-5 flex-shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0" />
                            </svg>
                            Backup &amp; Restore
                        </a>
                    </li></AuthorizeView>

            </ul>
        </nav>

        @* Profile — no auth wired up yet, so these show the same fallback values
           Laravel's session('user_name', 'Administrator') etc. would show when
           unauthenticated. Logout button is not yet wired to anything. *@
        <div class="sidebar-footer p-4 border-t border-black/10">
            <a href="/account/settings" class="block px-4 py-2 text-sm text-primary">Account settings</a>
            <div class="sidebar-profile flex items-center gap-3 px-4 py-3">
                <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center text-white text-xs font-semibold flex-shrink-0">
                    AD
                </div>
                <div class="sidebar-profile-details flex-1 min-w-0">
                    <p class="text-sm font-medium text-[#2c2c2c] truncate">Administrator</p>
                    <p class="text-xs text-muted truncate">admin@usep.edu.ph</p>
                </div>
                <form
                    method="post"
                    action="/auth/cookie-logout">
                    <AntiforgeryToken />
                    <button type="submit" title="Logout"
                            class="p-2 rounded-lg hover:bg-surface transition-colors flex-shrink-0 cursor-pointer">
                        <svg class="w-4 h-4 text-primary" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" x2="9" y1="12" y2="12" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    @* Main Content *@
    <main class="main-content flex-1 min-w-0 @(IsUnitMonitoring ? "flex min-h-0 flex-col overflow-hidden" : "overflow-auto")">

        @* Mobile top bar (only visible < lg) *@
        <div class="lg:hidden sticky top-0 z-30 bg-white border-b border-black/10 flex shrink-0 items-center gap-3 px-4 py-3">
            <button type="button" class="p-2 -ml-2 rounded-lg hover:bg-surface transition-colors cursor-pointer"
                    aria-label="Open navigation" aria-controls="main-sidebar"
                    aria-expanded="@(_mobileSidebarOpen ? "true" : "false")" @onclick="OpenMobileSidebar">
                <svg class="w-6 h-6 text-primary" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" x2="20" y1="12" y2="12" />
                    <line x1="4" x2="20" y1="6" y2="6" />
                    <line x1="4" x2="20" y1="18" y2="18" />
                </svg>
            </button>
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 bg-primary rounded flex items-center justify-center">
                    <svg class="w-4 h-4 text-white" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="14" x="2" y="3" rx="2" />
                        <path d="M8 21h8m-4-4v4" />
                    </svg>
                </div>
                <p class="text-primary font-heading font-semibold text-sm">CLMS</p>
            </div>
        </div>

        <div class="@(IsUnitMonitoring ? "flex min-h-0 flex-1 flex-col p-4 lg:p-5" : "p-4 sm:p-6 lg:p-8")">
            @Body
        </div>
    </main>

</div>

}

@* <div id="blazor-error-ui" data-nosnippet> *@
@*     An unhandled error has occurred. *@
@*     <a href="." class="reload">Reload</a> *@
@*     <span class="dismiss">🗙</span> *@
@* </div> *@

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private bool _authorizationReady;
    private string? _authorizationError;
    private int _authorizationVersion;
    private bool _sidebarCollapsed;
    private bool _mobileSidebarOpen;

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;
    private void OpenMobileSidebar() => _mobileSidebarOpen = true;
    private void CloseMobileSidebar() => _mobileSidebarOpen = false;

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseMobileSidebar();
    }
    private bool IsUnitMonitoring => string.Equals(
        new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'), "/unit-monitoring", StringComparison.OrdinalIgnoreCase);

    // Mirrors Laravel's request()->routeIs(...) ternary per nav item. Recomputed on
    // every navigation via NavigationManager, both for full page loads (static SSR
    // pages) and in-circuit navigation (interactive pages).
    private string NavClass(string path, bool exact)
    {
        var current = new Uri(Navigation.Uri).AbsolutePath;
        if (current.Length > 1 && current.EndsWith('/'))
            current = current.TrimEnd('/');

        var isClassManagement = path == "/class-lists" && (current.Equals("/courses", StringComparison.OrdinalIgnoreCase) || current.Equals("/school-semesters", StringComparison.OrdinalIgnoreCase));
        var isScheduleManagement = path == "/bookings" && current.Equals("/schedules", StringComparison.OrdinalIgnoreCase);
        var isActive = isClassManagement || isScheduleManagement || (exact
            ? string.Equals(current, path, StringComparison.OrdinalIgnoreCase)
            : current.StartsWith(path, StringComparison.OrdinalIgnoreCase));

        const string baseClasses = "sidebar-link flex items-center gap-3 px-4 py-3 rounded-lg transition-colors text-sm font-medium";
        return isActive
            ? $"{baseClasses} bg-primary text-white"
            : $"{baseClasses} text-[#2c2c2c] hover:bg-surface";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var version = ++_authorizationVersion;
        _authorizationReady = false;
        string? error = null;
        try
        {
            var state = await (AuthenticationState ?? AuthenticationStateProvider.GetAuthenticationStateAsync());
            if (state.User.Identity?.IsAuthenticated == true && await AuthorizationCache.GetAsync(state.User) is null)
                error = "Access Denied";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to prepare the navigation's authorization state.");
            error = "Unable to verify access. Please reload the page.";
        }
        if (version == _authorizationVersion)
        {
            _authorizationError = error;
            _authorizationReady = true;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _mobileSidebarOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ++_authorizationVersion;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
