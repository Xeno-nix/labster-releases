@* Standalone document for account forms rendered directly by the controller, without an interactive circuit. *@
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@Title — Labster</title>
    <style>
        body { margin:0; background:#f8f8f8; color:#313131; font:16px/1.6 system-ui; min-height:100vh; display:grid; place-items:center; }
        main { box-sizing:border-box; width:min(32rem,calc(100% - 2rem)); margin:1rem; padding:2rem; background:white; border:1px solid #ddd; border-radius:12px; overflow-wrap:anywhere; }
        h1 { font-size:1.6rem; margin-top:0; } h1,a { color:#8b1538; }
        label,input { display:block; } input { box-sizing:border-box; width:100%; font:inherit; margin:.25rem 0 1rem; padding:.6rem; border:1px solid #aaa; border-radius:6px; }
        button { font:inherit; border:0; padding:.7rem 1rem; border-radius:6px; background:#8b1538; color:white; cursor:pointer; }
        .secondary { margin-top:.75rem; background:#eee; color:#333; } [role=alert] { padding:.75rem; background:#fff0f0; color:#9d1616; border-radius:6px; }
    </style>
</head>
<body><main>@ChildContent</main></body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
