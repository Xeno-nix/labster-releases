@page "/"

@using CLMS.Application.Services
@rendermode InteractiveServer
@attribute [Authorize(Policy = Privileges.Prefix + Privileges.DashboardView)]
@using System.Security.Claims
@using CLMS.Application.DTOs.Dashboard

@using Microsoft.AspNetCore.Components.Authorization
@inject DashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard</PageTitle>

@if (snapshot is null)
{
    <p class="text-sm text-muted">Loading dashboard…</p>
}
else
{
    <div class="page-help-heading dashboard-help-heading">
        <h1 class="text-2xl font-heading font-semibold text-primary">Dashboard</h1>
        <PageHelp Guide="dashboard" />
    </div>
    <div class="dashboard-metrics">
        <div class="dashboard-metric" title="People currently in laboratories">
            <p class="text-sm text-muted">People in labs now</p>
            <p class="text-2xl font-heading font-semibold text-gray-800">@snapshot.ActiveNow</p>
        </div>
        <div class="dashboard-metric" title="Sessions today">
            <p class="text-sm text-muted">Sessions today</p>
            <p class="text-2xl font-heading font-semibold text-gray-800">@snapshot.SessionsToday</p>
        </div>
        <div class="dashboard-metric" title="Classes running now">
            <p class="text-sm text-muted">Classes running now</p>
            <p class="text-2xl font-heading font-semibold text-gray-800">@snapshot.ClassesRunningNow</p>
        </div>
        <a class="dashboard-metric" href="#dashboard-attention">
            <p class="text-sm text-muted">Needs attention</p>
            <p class="text-2xl font-heading font-semibold @(snapshot.AttentionCount > 0 ? "text-error" : "text-success")">
                @snapshot.AttentionCount
            </p>
        </a>
    </div>

    <SchedulingOverview />
    <div class="dashboard-columns">
        <div id="dashboard-attention" class="min-w-0 bg-white border border-gray-200 rounded-lg p-5">
            <h4 class="text-base font-heading font-semibold text-gray-800 mb-3">Needs attention</h4>
            @if (snapshot.Attention.Count == 0)
            {
                <p class="text-sm text-success">All good — nothing needs attention.</p>
            }
            else
            {
                <div class="flex flex-col gap-3">
                    @foreach (var item in snapshot.Attention)
                    {
                        <a href="@item.Href"
                           class="flex items-start gap-2 py-2 border-b border-gray-100 last:border-b-0 text-sm text-gray-700 hover:text-primary transition-colors">
                            <span class="w-6 h-6 shrink-0 rounded-full bg-error/10 text-error text-xs font-semibold flex items-center justify-center">
                                @item.Count
                            </span>
                            <span class="min-w-0 break-words">@item.Label</span>
                        </a>
                    }
                </div>
            }
        </div>
        <div class="min-w-0 bg-white border border-gray-200 rounded-lg p-5">
            <h4 class="text-base font-heading font-semibold text-gray-800 mb-4">Today's timeline</h4>
            @if (snapshot.Timeline.Count == 0)
            {
                <p class="text-sm text-muted">Nothing scheduled today.</p>
            }
            else
            {
                @foreach (var item in snapshot.Timeline)
                {
                    <div class="min-w-0 border-b border-gray-100 py-3 last:border-b-0 @(item.IsNow ? "border-l-4 border-primary pl-3 bg-surface rounded-r-lg" : "")">
                        <div class="min-w-0 break-words">
                            <p class="text-sm text-gray-800 @(item.IsNow ? "font-semibold" : "")"><span class="font-medium whitespace-nowrap">@item.StartTime.ToString("hh:mm tt")</span> — @item.Title</p>
                            <p class="mt-1 text-xs text-muted">@item.Subtitle · @item.LabName</p>
                        </div>
                        <div class="mt-2 flex flex-wrap gap-1">
                        <span class="text-xs px-2 py-0.5 rounded-full shrink-0 @(item.IsClass ? "bg-info/10 text-info" : "bg-accent/20 text-gray-800")">
                            @(item.IsClass ? "Class" : "Booking")
                        </span>
                        @if (item.IsNow)
                        {
                            <span class="text-xs px-2 py-0.5 rounded-full bg-primary text-white shrink-0">Now</span>
                        }
                        </div>
                    </div>
                }
            }
        </div>
        <div class="dashboard-availability min-w-0">
            <UnitAvailabilityPanel />
        </div>

        <div class="min-w-0 bg-white border border-gray-200 rounded-lg p-5">
            <h4 class="text-base font-heading font-semibold text-gray-800 mb-4">Lab occupancy</h4>
            @if (snapshot.Occupancy.Count == 0)
            {
                <p class="text-sm text-muted">No laboratories registered.</p>
            }
            else
            {
                <div class="divide-y divide-gray-100">
                    @foreach (var lab in snapshot.Occupancy)
                    {
                        <div class="min-w-0 py-3 first:pt-0 last:pb-0">
                            <div class="flex flex-wrap justify-between gap-2 text-sm">
                                <span class="text-gray-700 break-words">@lab.LabName</span>
                                <span class="text-muted whitespace-nowrap">@lab.Active / @lab.TotalUnits units</span>
                            </div>
                            <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface"
                                 role="progressbar" aria-label="@($"{lab.LabName} occupancy")"
                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@lab.Percent"
                                 aria-valuetext="@($"{lab.Active} of {lab.TotalUnits} units")">
                                <div class="h-full rounded-full bg-primary transition-all" style="width: @lab.Percent%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
}



@code {
    private DashboardSnapshotDTO? snapshot;

    protected override async Task OnInitializedAsync()
    {
        // The service derives visibility from the authenticated account.
        snapshot = await DashboardService.GetSnapshotAsync();
    }
}
