@using CLMS.Application.DTOs.Booking
@using CLMS.Application.Services
@using CLMS.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization

@inject ClassListService ClassListService
@inject IJSRuntime JS

@if (IsLoading)
{
    <p class="text-muted text-sm py-4">Loading roster...</p>
}
else
{
    <button type="button"
            class="mb-4 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700"
            @onclick="OnBack">
        ← All classes
    </button>

    <div class="bg-white rounded-lg border border-black/10 shadow-sm">
        <div class="p-6 border-b border-black/10">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                <div class="min-w-0">
                    <h2 class="text-primary text-xl font-semibold">@Class.CourseCode — @Class.CourseName</h2>
                    <p class="text-sm text-muted mt-1">
                        @if (Class.IsGrouped)
                        {
                            <span>Year @Class.YearLevel &middot; Section @Class.Section</span>
                        }
                        else
                        {
                            <span>Year &amp; section not set</span>
                        }
                        <span>&nbsp;&middot;&nbsp;@Class.SlotsLabel</span>
                    </p>
                    @if (IsAdmin)
                    {
                        <p class="text-sm text-muted mt-0.5">Instructor: @Class.InstructorName</p>
                    }
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                    <span class="inline-block px-2.5 py-1 rounded text-xs font-medium bg-primary/10 text-primary">@Roster.Count students</span>
                    <button type="button"
                            class="flex items-center gap-2 px-4 py-2 border border-black/10 rounded-lg bg-surface text-sm font-medium text-[#2c2c2c] hover:bg-black/5 transition-colors"
                            title="Import students from a CSV file"
                            @onclick="OpenImportModal">
                        <i data-lucide="file-up" class="w-4 h-4"></i>
                        @(Roster.Count > 0 ? "Import more students" : "Import CSV")
                    </button>
                    <button type="button"
                            class="px-4 py-2.5 bg-[#7a1f2b] text-white border-none rounded-md text-sm cursor-pointer hover:bg-[#651923] transition-colors"
                            @onclick="OpenAddModal">
                        + Add Student
                    </button>
                </div>
            </div>
        </div>

        <div class="p-6">
            @if (SyncStatus is not null)
            {
                <div class="mb-4">
                    <ClassListSyncBadge Status="SyncStatus"
                                        Slots="@Class.Slots"
                                        OnSyncNow="SyncNowAsync"
                                        IsSyncing="IsSyncing" />
                </div>
            }

            <div class="flex items-center gap-3 mb-4">
                <div class="relative flex-1 max-w-sm">
                    <input @bind="SearchQuery"
                           @bind:event="oninput"
                           placeholder="Search by ID or name..."
                           class="w-full px-4 py-2.5 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(FlashMessage))
            {
                <div class="mb-4 px-4 py-3 rounded-lg bg-[#e8f5ec] border border-[#b7e3c4] text-sm text-[#1f7a3f]">@FlashMessage</div>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="mb-4 px-4 py-3 rounded-lg bg-[#fdecea] border border-[#f5c2c0] text-sm text-[#b3261e]">@ErrorMessage</div>
            }

            @if (FilteredRoster.Count == 0)
            {
                <div class="py-10 text-center text-sm text-muted">
                    <p>
                        @(string.IsNullOrWhiteSpace(SearchQuery)
                            ? "No students enrolled yet. Add or import the first student with the buttons above."
                            : "No students match your search.")
                    </p>
                </div>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wide text-muted border-b border-black/10">
                            <th class="py-2.5 pr-4 font-medium">Student ID</th>
                            <th class="py-2.5 pr-4 font-medium">Name</th>
                            <th class="py-2.5 w-16 text-right font-medium">Remove</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in FilteredRoster)
                        {
                            <tr class="border-b border-black/5 last:border-0 hover:bg-surface/60">
                                <td class="py-3 pr-4 font-mono text-xs">@student.StudentId</td>
                                <td class="py-3 pr-4">@student.DisplayName</td>
                                <td class="py-3 text-right">
                                    <button type="button"
                                            class="p-1.5 rounded-lg text-muted hover:text-[#b3261e] hover:bg-red-50 transition-colors"
                                            title="Remove from class"
                                            @onclick="() => RemoveTarget = student">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="p-4 border-t border-black/10 flex justify-end">
            <button type="button"
                    class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-[#b3261e] hover:bg-red-50 rounded-lg transition-colors"
                    @onclick="() => ShowDeleteConfirm = true">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                Delete class list
            </button>
        </div>
    </div>

    <AddStudentModal Show="ShowAddModal"
                     ScheduleId="@Class.RepresentativeScheduleId"
                     UserId="@UserId"
                     Role="@Role"
                     OnDismiss="CloseAddModal"
                     OnAdded="OnStudentAdded" />

    <ClassListImportModal Show="ShowImportModal"
                          ScheduleId="@Class.RepresentativeScheduleId"
                          UserId="@UserId"
                          Role="@Role"
                          OnDismiss="CloseImportModal"
                          OnCommitted="OnImportCommitted" />

    <ConfirmModal Show="RemoveTarget is not null"
                  Title="Remove student from class?"
                  ConfirmLabel="Remove"
                  ConfirmButtonClass="bg-[#b3261e] text-white"
                  IconBgClass="bg-red-50"
                  OnCancel="CloseRemoveConfirm"
                  OnConfirm="ConfirmRemoveAsync">
        <IconContent>
            <i data-lucide="trash-2" class="w-5 h-5 text-[#b3261e]"></i>
        </IconContent>
        <Body>
            <p class="text-sm text-muted mb-1">
                This removes <span class="font-medium text-[#2c2c2c]">@RemoveTarget?.DisplayName</span>
                (<span class="font-mono text-xs">@RemoveTarget?.StudentId</span>) from every meeting of this class.
            </p>
            <p class="text-sm text-muted">This cannot be undone.</p>
        </Body>
    </ConfirmModal>

    <ConfirmModal Show="ShowDeleteConfirm"
                  Title="Delete this class list?"
                  ConfirmLabel="Delete class list"
                  ConfirmButtonClass="bg-[#b3261e] text-white"
                  IconBgClass="bg-red-50"
                  OnCancel="CloseDeleteConfirm"
                  OnConfirm="ConfirmDeleteClassListAsync">
        <IconContent>
            <i data-lucide="alert-triangle" class="w-5 h-5 text-[#b3261e]"></i>
        </IconContent>
        <Body>
            <p class="text-sm text-muted mb-1">
                This removes @Roster.Count @(Roster.Count == 1 ? "student" : "students")
                from every meeting of this class. Student records are kept and can be imported again later.
            </p>
            <p class="text-sm text-muted">This cannot be undone.</p>
        </Body>
    </ConfirmModal>
}

@code {
    [Parameter] public ClassListClassDTO Class { get; set; } = null!;
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public Role Role { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnClassChanged { get; set; }

    private IReadOnlyList<EnrolledStudentDTO> Roster { get; set; } = [];
    private SyncStatusDTO? SyncStatus { get; set; }
    private bool IsSyncing { get; set; }
    private bool ShowDeleteConfirm { get; set; }
    private string SearchQuery { get; set; } = string.Empty;
    private string? FlashMessage { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool ShowAddModal { get; set; }
    private bool ShowImportModal { get; set; }
    private EnrolledStudentDTO? RemoveTarget { get; set; }

    private bool IsAdmin => Role == Role.Admin;

    private IReadOnlyList<EnrolledStudentDTO> FilteredRoster
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchQuery))
                return Roster;

            var query = SearchQuery.Trim();
            return Roster
                .Where(s => s.StudentId.Contains(query, StringComparison.OrdinalIgnoreCase)
                            || s.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRosterAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ClassList.razor also re-runs this; icons inside modals and rows arrive after the
        // initial page render, so re-scan after every render.
        await JS.InvokeVoidAsync("lucide.createIcons");
    }

    private async Task LoadRosterAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Roster = await ClassListService.GetRosterAsync(UserId, Role, Class.RepresentativeScheduleId);
        }
        catch (Exception ex)
        {
            // A sync-status failure must not hide the roster, so it is read separately.
            ErrorMessage = $"Could not load the roster. {ex.Message}";
            Roster = [];
        }

        try
        {
            SyncStatus = await ClassListService.GetSyncStatusAsync(UserId, Role, Class.RepresentativeScheduleId);
        }
        catch
        {
            SyncStatus = null;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenAddModal() => ShowAddModal = true;

    private void CloseAddModal() => ShowAddModal = false;

    private void OpenImportModal() => ShowImportModal = true;

    private void CloseImportModal() => ShowImportModal = false;

    private void CloseRemoveConfirm() => RemoveTarget = null;

    /// <summary>
    /// The modal stays open on its result step; the roster behind it is refreshed at once.
    /// </summary>
    private async Task OnImportCommitted(ClassListImportResult result)
    {
        FlashMessage = result.Message;
        await LoadRosterAsync();
        await OnClassChanged.InvokeAsync();
    }

    private async Task OnStudentAdded(string message)
    {
        FlashMessage = message;
        ShowAddModal = false;
        await LoadRosterAsync();
        await OnClassChanged.InvokeAsync();
    }

    private async Task ConfirmRemoveAsync()
    {
        if (RemoveTarget is null)
            return;

        var target = RemoveTarget;
        RemoveTarget = null;

        try
        {
            var removed = await ClassListService.RemoveStudentAsync(
                UserId, Role, Class.RepresentativeScheduleId, target.StudentId);

            FlashMessage = removed > 0
                ? $"Removed {target.DisplayName} from the class."
                : $"{target.DisplayName} wasn't on this roster.";

            await LoadRosterAsync();
            await OnClassChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    /// <summary>Copy the group's roster into every meeting — the "Sync now" fix.</summary>
    private async Task SyncNowAsync()
    {
        IsSyncing = true;
        ErrorMessage = null;

        try
        {
            var result = await ClassListService.SyncNowAsync(UserId, Role, Class.RepresentativeScheduleId);

            await LoadRosterAsync();

            FlashMessage = result.AlreadySynced
                ? "The class roster is already in sync."
                : $"Synced — every meeting now shares {result.RosterSize} students.";

            await OnClassChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSyncing = false;
        }
    }

    private void CloseDeleteConfirm() => ShowDeleteConfirm = false;

    /// <summary>Clears the roster of every meeting of the class in one transaction.</summary>
    private async Task ConfirmDeleteClassListAsync()
    {
        ShowDeleteConfirm = false;

        try
        {
            var removed = await ClassListService.DeleteClassListAsync(
                UserId, Role, Class.RepresentativeScheduleId);

            FlashMessage = removed > 0
                ? $"Class list deleted — removed {removed} enrollment{(removed == 1 ? "" : "s")}."
                : "Class list deleted — it had no enrollments.";

            await LoadRosterAsync();
            await OnClassChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
}