@page "/class-lists"

@using CLMS.Application.DTOs.Booking
@using CLMS.Application.Services
@using CLMS.Domain.Enums
@using CLMS.Web.Components.Pages.ClassListUi
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@attribute [Authorize(Roles = "Admin,Faculty")]
@rendermode InteractiveServer

@inject ClassListService ClassListService
@inject AcademicTermService TermService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>CLMS — Class Lists</PageTitle>

<div class="space-y-6">

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-sm text-red-700">@ErrorMessage</p>
        </div>
    }

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-primary text-2xl mb-1">Class Lists</h1>
            <p class="text-muted text-sm">Student rosters per class. Import a list or manage students one at a time.</p>
        </div>
        <div class="flex items-center gap-3">
            <label class="text-sm text-muted" for="term-picker">Term</label>
            <select id="term-picker"
                    value="@SelectedTermId"
                    @onchange="OnTermChanged"
                    class="px-3 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none cursor-pointer">
                @foreach (var term in Terms)
                {
                    <option value="@term.Id">@TermLabel(term)</option>
                }
            </select>
        </div>
    </div>

    @if (IsLoading)
    {
        <p class="text-muted text-sm py-4">Loading classes...</p>
    }
    else if (Terms.Count == 0)
    {
        <div class="bg-white rounded-lg border border-black/10 shadow-sm py-12 px-6 text-center">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-surface flex items-center justify-center">
                <i data-lucide="calendar-x" class="w-6 h-6 text-muted"></i>
            </div>
            <h3 class="text-sm font-medium text-[#2c2c2c]">No academic terms yet</h3>
            <p class="text-xs text-muted mt-1.5">Class lists are grouped by term. Ask an admin to add a term first.</p>
        </div>
    }
    else if (Classes.Count == 0)
    {
        <div class="bg-white rounded-lg border border-black/10 shadow-sm py-12 px-6 text-center">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-surface flex items-center justify-center">
                <i data-lucide="users" class="w-6 h-6 text-muted"></i>
            </div>
            <h3 class="text-sm font-medium text-[#2c2c2c]">No classes for this term</h3>
            <p class="text-xs text-muted mt-1.5">
                @if (IsAdmin)
                {
                    <span>No class schedules exist in @SelectedTermLabel.</span>
                }
                else
                {
                    <span>You have no classes assigned in @SelectedTermLabel.</span>
                }
            </p>
        </div>
    }
    else
    {
        @if (SelectedClass is not null)
        {
            <ClassRosterPanel Class="SelectedClass"
                              UserId="@UserId"
                              Role="@CurrentRole"
                              OnBack="CloseClass"
                              OnClassChanged="RefreshClassesAfterChange" />
        }
        else
        {
            <div class="flex items-center justify-between">
                <p class="text-sm text-muted">
                    @Classes.Count @(Classes.Count == 1 ? "class" : "classes")
                    @if (TotalStudents > 0)
                    {
                        <span> · @TotalStudents student@(TotalStudents == 1 ? "" : "s")</span>
                    }
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                @foreach (var cls in Classes)
                {
                    <button type="button"
                            class="bg-white rounded-lg border border-black/10 shadow-sm p-5 text-left hover:border-primary/40 hover:shadow-md transition-all cursor-pointer w-full"
                            @onclick="() => OpenClass(cls)">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-primary font-semibold truncate">@cls.CourseCode</p>
                                <p class="text-sm text-muted truncate">@cls.CourseName</p>
                            </div>
                            @if (cls.StudentCount > 0)
                            {
                                <span class="inline-block px-2 py-1 rounded text-xs font-medium bg-primary/10 text-primary flex-shrink-0">
                                    @cls.StudentCount
                                </span>
                            }
                        </div>

                        <div class="mt-4 pt-4 border-t border-black/10 space-y-2">
                            <div class="flex items-start gap-2 text-sm text-[#2c2c2c]">
                                <i data-lucide="layers" class="w-4 h-4 text-muted flex-shrink-0 mt-0.5"></i>
                                <span class="min-w-0">
                                    @if (cls.IsGrouped)
                                    {
                                        <span>Year @cls.YearLevel &middot; Section @cls.Section</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Year &amp; section not set</span>
                                    }
                                </span>
                            </div>

                            <div class="flex items-start gap-2 text-sm text-[#2c2c2c]">
                                <i data-lucide="clock" class="w-4 h-4 text-muted flex-shrink-0 mt-0.5"></i>
                                <span class="min-w-0">@cls.SlotsLabel</span>
                            </div>

                            <div class="flex items-start gap-2 text-sm text-[#2c2c2c]">
                                <i data-lucide="flask-conical" class="w-4 h-4 text-muted flex-shrink-0 mt-0.5"></i>
                                <span class="min-w-0 truncate">@LabLabel(cls)</span>
                            </div>

                            @if (IsAdmin)
                            {
                                <div class="flex items-start gap-2 text-sm text-[#2c2c2c]">
                                    <i data-lucide="user" class="w-4 h-4 text-muted flex-shrink-0 mt-0.5"></i>
                                    <span class="min-w-0 truncate">@cls.InstructorName</span>
                                </div>
                            }
                        </div>

                        <div class="mt-3 pt-3 border-t border-black/10 flex items-center justify-between gap-3">
                            <ClassListSyncBadge Compact="true" Slots="@cls.Slots" />
                            <span class="text-xs font-medium text-primary flex items-center gap-1 flex-shrink-0">
                                @if (cls.StudentCount > 0)
                                {
                                    <span>View roster (@cls.StudentCount)</span>
                                }
                                else
                                {
                                    <span>View roster</span>
                                }
                                <span aria-hidden="true">→</span>
                            </span>
                        </div>
                    </button>
                }
            </div>
        }
    }

</div>

@code {
    private IReadOnlyList<ClassListClassDTO> Classes = [];
    private IReadOnlyList<AcademicTermDTO> Terms = [];

    private int SelectedTermId { get; set; }
    private Guid UserId { get; set; }
    private Role CurrentRole { get; set; } = Role.Admin;

    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private bool IsAdmin => CurrentRole == Role.Admin;

    private string SelectedTermLabel =>
        Terms.FirstOrDefault(t => t.Id == SelectedTermId) is { } term
            ? $"{term.Semester} Semester {term.AcademicYear}".Trim()
            : "the selected term";

    private int TotalStudents => Classes.Sum(c => c.StudentCount);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (Guid.TryParse(idClaim, out var parsedId))
                UserId = parsedId;

            var roleClaim = user.FindFirst(ClaimTypes.Role)?.Value;
            if (Enum.TryParse<Role>(roleClaim, ignoreCase: true, out var parsedRole))
                CurrentRole = parsedRole;
        }

        await LoadTermsAsync();
    }

    private async Task LoadTermsAsync(int? preferredTermId = null)
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            Terms = (await TermService.GetAllAsync())
                .OrderByDescending(t => t.Id)
                .ToList();

            var firstTermId = Terms.FirstOrDefault()?.Id ?? 0;

            if (preferredTermId.HasValue && Terms.Any(t => t.Id == preferredTermId.Value))
            {
                // User picked from the dropdown: keep their choice.
                SelectedTermId = preferredTermId.Value;
            }
            else
            {
                // Default to the current term, falling back to the newest.
                var current = await ClassListService.GetClassesAsync(UserId, CurrentRole);
                SelectedTermId = current.Count > 0
                    ? current[0].AcademicTermId
                    : firstTermId;
            }

            if (SelectedTermId == 0)
            {
                Classes = [];
                return;
            }

            Classes = await ClassListService.GetClassesAsync(UserId, CurrentRole, SelectedTermId);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Could not load class lists. {ex.Message}";
            Classes = [];
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnTermChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var termId))
        {
            SelectedClass = null;
            await LoadTermsAsync(preferredTermId: termId);
        }
    }

    private ClassListClassDTO? SelectedClass { get; set; }

    private void OpenClass(ClassListClassDTO cls) => SelectedClass = cls;

    private void CloseClass() => SelectedClass = null;

    /// <summary>
    /// Called after a roster add/remove: reloads classes so card counts update, then points
    /// the panel at the refreshed copy of the open class.
    /// </summary>
    private async Task RefreshClassesAfterChange()
    {
        if (SelectedClass is null)
            return;

        var representativeId = SelectedClass.RepresentativeScheduleId;

        await LoadTermsAsync(preferredTermId: SelectedTermId);

        SelectedClass = Classes.FirstOrDefault(c => c.RepresentativeScheduleId == representativeId)
            ?? SelectedClass;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // data-lucide tags are converted to SVGs client-side; Blazor re-renders add new tags
        // (cards, roster rows, modals), so re-scan after every render — same as Inventory.
        await JS.InvokeVoidAsync("lucide.createIcons");
    }

    private static string TermLabel(AcademicTermDTO term) =>
        $"{term.Semester} Semester {term.AcademicYear}".Trim();

    private static string LabLabel(ClassListClassDTO cls) =>
        cls.Slots.Select(s => s.LaboratoryName).Distinct().Count() == 1
            ? cls.Slots[0].LaboratoryName
            : string.Join(", ", cls.Slots.Select(s => s.LaboratoryName).Distinct());
}