@inject CLMS.Web.Services.ToastService Toasts
@attribute [Authorize]
@using CLMS.Application.Services
@using CLMS.Web.Services
@inject BookingService BookingService
@inject LaboratoryService LaboratoryService
@inject DialogService Dialogs

<div class="space-y-6">
    @HeaderTemplate(HeaderActions)

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @errorMessage
        </div>
    }

    <div class="filter-bar mobile-search-filters items-center">
        <input type="text"
               @bind="bookingSearch"
               @bind:event="oninput"
               @bind:after="ResetBookingPage"
               placeholder="Search requestor, email, or purpose..."
               class="w-full rounded-lg border border-black/10 bg-white px-3 py-2.5 text-sm outline-none focus:border-primary sm:max-w-sm" />

        <ResponsiveFilters Fields="BookingFilters" OnApply="ApplyBookingFilters" />

        <span class="text-sm text-muted sm:ml-auto">
            @FilteredBookings.Count() booking(s)
        </span>
    </div>

    <div class="overflow-hidden rounded-xl border border-black/10 bg-white">
        <p class="table-hint">Scroll sideways for more details.</p>
        <div class="table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable records">
            <table role="table" class="responsive-records data-table w-full min-w-[850px] text-left">
                <thead class="border-b border-black/10 bg-gray-50">
                    <tr class="text-xs font-semibold uppercase tracking-wide text-muted">
                        <th class="px-5 py-4">Requestor</th>
                        <th class="px-5 py-4">Contact</th>
                        <th class="px-5 py-4">Laboratory</th>
                        <th class="px-5 py-4">Date</th>
                        <th class="px-5 py-4">Time</th>
                        <th class="px-5 py-4">Purpose <span class="row-actions-caption">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-black/5">
                    @if (isLoadingBookings)
                    {
                        <tr>
                            <td colspan="6" class="px-5 py-12 text-center text-sm text-muted">
                                Loading bookings...
                            </td>
                        </tr>
                    }
                    else if (!FilteredBookings.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-5 py-14 text-center">
                                <div class="flex flex-col items-center gap-2">
                                    <span class="text-2xl">📅</span>
                                    <p class="font-medium text-[#2c2c2c]">
                                        @(bookings.Any() ? "No matching bookings" : "No bookings added yet")
                                    </p>
                                    <p class="text-sm text-muted">
                                        @(bookings.Any() ? "Try changing your search or filters." : "Add your first laboratory booking to get started.")
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var booking in BookingPageItems)
                        {
                            RenderFragment rowActions = @<text>
                                <button type="button"
                                    @onclick="() => OpenEditBooking(booking.Id)"
                                    title="Edit booking"
                                    class="rounded-lg p-2 text-muted hover:bg-gray-100 hover:text-primary">
                                    <i aria-hidden="true" class="fa-solid fa-pen"></i> Edit
                                </button>
                                <button type="button"
                                    @onclick="() => DeleteBooking(booking.Id)"
                                    disabled="@(deletingBookingId == booking.Id)"
                                    class="rounded-lg p-2 text-red-600 hover:bg-red-50 disabled:opacity-50">
                                    <i aria-hidden="true" class="fa-solid fa-trash-can"></i> @(deletingBookingId == booking.Id ? "Deleting..." : "Delete")
                                </button>
                            </text>;
                            <tr role="row" class="transition-colors hover:bg-gray-50/70">
                                <td role="cell" class="px-5 py-4 text-sm font-medium text-[#2c2c2c]">
                                    <div class="row-identity">
                                        <span class="record-identity">@booking.RequestorName</span>
                                    </div>
                                </td>
                                <td role="cell" class="px-5 py-4 text-sm text-muted" data-label="Contact">@booking.Email</td>
                                <td role="cell" class="px-5 py-4 text-sm text-[#2c2c2c]" data-label="Laboratory">@GetLaboratoryName(booking.LaboratoryId)</td>
                                <td role="cell" class="whitespace-nowrap px-5 py-4 text-sm" data-label="Date">@booking.Date.ToString("MMM dd, yyyy")</td>
                                <td role="cell" class="whitespace-nowrap px-5 py-4 text-sm" data-label="Time">@booking.StartTime.ToString("hh:mm tt") - @booking.EndTime.ToString("hh:mm tt")</td>
                                <td role="cell" class="max-w-[200px] px-5 py-4 text-sm text-muted row-end-cell" data-label="Purpose">
                                    <div class="row-end-content">
                                        <div class="row-end-value"><span class="block truncate" title="@booking.Purpose">
                                                                    @booking.Purpose
                                                                </span></div>
                                        <div class="row-end-actions"><ActionMenu Label="@($"Actions for {booking.RequestorName}")">@rowActions</ActionMenu></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!isLoadingBookings && FilteredBookings.Any())
        {
            <div class="flex flex-col justify-between gap-3 border-t border-black/10 px-5 py-3 sm:flex-row sm:items-center">
                <p class="text-xs text-muted">
                    Showing @BookingFirstItem–@BookingLastItem of @FilteredBookings.Count() bookings
                </p>
                <div class="flex items-center gap-2">
                    <button type="button"
                            @onclick="() => ChangeBookingPage(bookingPage - 1)"
                            disabled="@(bookingPage <= 1)"
                            class="rounded-lg border border-black/10 px-3 py-2 text-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40">
                        Previous
                    </button>
                    <span class="text-sm text-muted">
                        Page @bookingPage of @BookingTotalPages
                    </span>
                    <button type="button"
                            @onclick="() => ChangeBookingPage(bookingPage + 1)"
                            disabled="@(bookingPage >= BookingTotalPages)"
                            class="rounded-lg border border-black/10 px-3 py-2 text-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>

    @if (showBookingModal)
    {
        <BookingModal @key="editingBookingId"
            BookingId="@editingBookingId"
            OnClose="CloseBookingModal"
            OnSaved="HandleBookingSaved" />
    }
</div>

@code {
    private ResponsiveFilterField[] BookingFilters =>
        [new("Laboratory", "All labs", "", bookingLabFilter, laboratories.Select(lab => (lab.Id.ToString(), lab.Name)))];

    private void ApplyBookingFilters(string[] values)
    {
        bookingLabFilter = values[0];
        ResetBookingPage();
    }

    [Parameter, EditorRequired]
    public RenderFragment<RenderFragment> HeaderTemplate { get; set; } = default!;

    private RenderFragment HeaderActions => @<div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <button type="button"
                @onclick="OpenCreateBooking"
                class="flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90">
            + New Booking
        </button>
    </div>;

    private const int PageSize = 10;

    private IEnumerable<BookingDTO> bookings = Enumerable.Empty<BookingDTO>();

    private List<(int Id, string Name)> laboratories = new();

    private bool isLoadingBookings = true;

    private bool showBookingModal;

    private int? editingBookingId;

    private int? deletingBookingId;

    private string? errorMessage;

    private string bookingSearch = "";

    private string bookingLabFilter = "";

    private int bookingPage = 1;

    private IEnumerable<BookingDTO> FilteredBookings =>
        bookings.Where(b =>
            (string.IsNullOrWhiteSpace(bookingSearch) ||
             (b.RequestorName?.Contains(bookingSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (b.Email?.Contains(bookingSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (b.Purpose?.Contains(bookingSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             GetLaboratoryName(b.LaboratoryId).Contains(bookingSearch, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrWhiteSpace(bookingLabFilter) ||
             b.LaboratoryId.ToString() == bookingLabFilter));

    private int BookingTotalPages =>
        Math.Max(1, (int)Math.Ceiling(FilteredBookings.Count() / (double)PageSize));

    private IEnumerable<BookingDTO> BookingPageItems =>
        FilteredBookings.Skip((bookingPage - 1) * PageSize).Take(PageSize);

    private int BookingFirstItem =>
        FilteredBookings.Any() ? ((bookingPage - 1) * PageSize) + 1 : 0;

    private int BookingLastItem =>
        Math.Min(bookingPage * PageSize, FilteredBookings.Count());

    protected override async Task OnInitializedAsync()
    {
        await LoadLaboratories();
        await LoadBookings();
    }

    private async Task LoadLaboratories()
    {
        try
        {
            var result = await LaboratoryService.GetAllAsync();
            laboratories = result.Select(l => (Id: l.Id, Name: l.Name)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load laboratories.";
            Console.WriteLine(ex);
        }
    }

    private string GetLaboratoryName(int id) =>
        laboratories.FirstOrDefault(l => l.Id == id).Name ?? $"Lab {id}";

    private async Task LoadBookings()
    {
        isLoadingBookings = true;

        try
        {
            bookings = (await BookingService.GetAllAsync()).ToList();
            bookingPage = Math.Min(bookingPage, BookingTotalPages);
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load bookings.";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoadingBookings = false;
        }
    }

    private void ResetBookingPage() => bookingPage = 1;

    private void ChangeBookingPage(int page) =>
        bookingPage = Math.Clamp(page, 1, BookingTotalPages);

    private void OpenCreateBooking()
    {
        editingBookingId = null;
        showBookingModal = true;
    }

    private void OpenEditBooking(int id)
    {
        editingBookingId = id;
        showBookingModal = true;
    }

    private void CloseBookingModal()
    {
        showBookingModal = false;
        editingBookingId = null;
    }

    private async Task HandleBookingSaved()
    {
        var wasEditing = editingBookingId is not null;

        showBookingModal = false;
        await LoadBookings();

        Toasts.Show(wasEditing
            ? "Booking updated successfully."
            : "Booking added successfully.", ToastService.ToastType.Success);
    }

    private async Task DeleteBooking(int id)
    {
         var confirmed = await Dialogs.ShowConfirmDialogAsync(
        "Are you sure you want to delete this booking? This cannot be undone.",
        "Delete Booking");

        if (!confirmed)
            return;

        deletingBookingId = id;
        errorMessage = null;

        try
        {
            await BookingService.DeleteAsync(id);
            await LoadBookings();
            Toasts.Show("Booking deleted successfully.", ToastService.ToastType.Success);
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to delete booking.";
            Console.WriteLine(ex);
        }
        finally
        {
            deletingBookingId = null;
        }
    }
}
