@inject CLMS.Web.Services.ToastService Toasts
@attribute [Authorize]
@using CLMS.Application.Services
@using CLMS.Web.Services
@inject ClassScheduleService ScheduleService
@inject LaboratoryService LaboratoryService
@inject DialogService Dialogs

<div class="space-y-6">
    @HeaderTemplate(HeaderActions)

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @errorMessage
        </div>
    }

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <input type="text"
               @bind="scheduleSearch"
               @bind:event="oninput"
               @bind:after="ResetSchedulePage"
               placeholder="Search course, instructor, or laboratory..."
               class="w-full rounded-lg border border-black/10 bg-white px-3 py-2.5 text-sm outline-none focus:border-primary sm:max-w-sm" />

        <select @bind="scheduleDayFilter"
                @bind:after="ResetSchedulePage"
                class="rounded-lg border border-black/10 bg-white px-3 py-2.5 text-sm outline-none focus:border-primary">
            <option value="">All Days</option>
            @foreach (var day in Enum.GetNames<DayOfWeek>())
            {
                <option value="@day">@day</option>
            }
        </select>

        <select @bind="scheduleLabFilter"
                @bind:after="ResetSchedulePage"
                class="rounded-lg border border-black/10 bg-white px-3 py-2.5 text-sm outline-none focus:border-primary">
            <option value="">All Laboratories</option>
            @foreach (var lab in laboratories)
            {
                <option value="@lab.Name">@lab.Name</option>
            }
        </select>

        <span class="text-sm text-muted sm:ml-auto">
            @FilteredSchedules.Count() schedule(s)
        </span>
    </div>

    <div class="overflow-hidden rounded-xl border border-black/10 bg-white">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[850px] text-left">
                <thead class="border-b border-black/10 bg-gray-50">
                    <tr class="text-xs font-semibold uppercase tracking-wide text-muted">
                        <th class="px-5 py-4">Course</th>
                        <th class="px-5 py-4">Instructor</th>
                        <th class="px-5 py-4">Laboratory</th>
                        <th class="px-5 py-4">Day</th>
                        <th class="px-5 py-4">Time</th>
                        <th class="px-5 py-4">Term</th>
                        <th class="px-5 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-black/5">
                    @if (isLoadingSchedules)
                    {
                        <tr>
                            <td colspan="7" class="px-5 py-12 text-center text-sm text-muted">
                                Loading schedules...
                            </td>
                        </tr>
                    }
                    else if (!FilteredSchedules.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-5 py-14 text-center">
                                <div class="flex flex-col items-center gap-2">
                                    <p class="font-medium text-[#2c2c2c]">
                                        @(schedules.Any() ? "No matching schedules" : "No class schedules added yet")
                                    </p>
                                    <p class="text-sm text-muted">
                                        @(schedules.Any() ? "Try changing your search or filters." : "Add your first class schedule to get started.")
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var schedule in SchedulePageItems)
                        {
                            <tr class="transition-colors hover:bg-gray-50/70">
                                <td class="px-5 py-4">
                                    <p class="text-sm font-medium text-[#2c2c2c]">
                                        @schedule.CourseCode
                                    </p>
                                    <p class="mt-1 text-xs text-muted">
                                        @schedule.CourseName
                                    </p>
                                </td>
                                <td class="px-5 py-4 text-sm">
                                    @schedule.InstructorName
                                </td>
                                <td class="px-5 py-4 text-sm">
                                    @schedule.LaboratoryName
                                </td>
                                <td class="px-5 py-4 text-sm">
                                    @schedule.DayOfWeek
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-sm">
                                    @schedule.TimeStart.ToString("hh:mm tt") - @schedule.TimeEnd.ToString("hh:mm tt")
                                </td>
                                <td class="px-5 py-4 text-sm">
                                    <p>@schedule.Semester semester</p>
                                    <p class="mt-1 text-xs text-muted">@schedule.AcademicYear</p>
                                </td>
                                <td class="px-5 py-4">
                                    <div class="flex justify-end gap-1">
                                        <button type="button"
                                                @onclick="() => OpenEditSchedule(schedule.Id)"
                                                class="rounded-lg p-2 text-muted hover:bg-gray-100 hover:text-primary">
                                            Edit
                                        </button>
                                        <button type="button"
                                                @onclick="() => DeleteSchedule(schedule.Id)"
                                                disabled="@(deletingScheduleId == schedule.Id)"
                                                class="rounded-lg p-2 text-red-600 hover:bg-red-50 disabled:opacity-50">
                                            @(deletingScheduleId == schedule.Id ? "Deleting..." : "Delete")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!isLoadingSchedules && FilteredSchedules.Any())
        {
            <div class="flex flex-col justify-between gap-3 border-t border-black/10 px-5 py-3 sm:flex-row sm:items-center">
                <p class="text-xs text-muted">
                    Showing @ScheduleFirstItem–@ScheduleLastItem of @FilteredSchedules.Count() schedules
                </p>
                <div class="flex items-center gap-2">
                    <button type="button"
                            @onclick="() => ChangeSchedulePage(schedulePage - 1)"
                            disabled="@(schedulePage <= 1)"
                            class="rounded-lg border border-black/10 px-3 py-2 text-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40">
                        Previous
                    </button>
                    <span class="text-sm text-muted">
                        Page @schedulePage of @ScheduleTotalPages
                    </span>
                    <button type="button"
                            @onclick="() => ChangeSchedulePage(schedulePage + 1)"
                            disabled="@(schedulePage >= ScheduleTotalPages)"
                            class="rounded-lg border border-black/10 px-3 py-2 text-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>

    @if (showScheduleModal)
    {
        <ClassScheduleModal @key="editingScheduleId"
            ScheduleId="@editingScheduleId"
            OnClose="CloseScheduleModal"
            OnSaved="HandleScheduleSaved" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment<RenderFragment> HeaderTemplate { get; set; } = default!;

    private RenderFragment HeaderActions => @<div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <button type="button"
                @onclick="OpenCreateSchedule"
                class="flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90">
            + Add Class Schedule

        </button>
    </div>;

    private const int PageSize = 10;

    private IEnumerable<ClassScheduleDTO> schedules = Enumerable.Empty<ClassScheduleDTO>();

    private List<(int Id, string Name)> laboratories = new();

    private bool isLoadingSchedules = true;

    private bool showScheduleModal;

    private int? editingScheduleId;

    private int? deletingScheduleId;

    private string? errorMessage;

    private string scheduleSearch = "";

    private string scheduleDayFilter = "";

    private string scheduleLabFilter = "";

    private int schedulePage = 1;

    private IEnumerable<ClassScheduleDTO> FilteredSchedules =>
        schedules.Where(s =>
            (string.IsNullOrWhiteSpace(scheduleSearch) ||
             (s.CourseCode?.Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (s.CourseName?.Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (s.InstructorName?.Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (s.LaboratoryName?.Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase) ?? false))
            &&
            (string.IsNullOrWhiteSpace(scheduleDayFilter) ||
             s.DayOfWeek.ToString().Equals(scheduleDayFilter, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrWhiteSpace(scheduleLabFilter) ||
             s.LaboratoryName == scheduleLabFilter));

    private int ScheduleTotalPages =>
        Math.Max(1, (int)Math.Ceiling(FilteredSchedules.Count() / (double)PageSize));

    private IEnumerable<ClassScheduleDTO> SchedulePageItems =>
        FilteredSchedules.Skip((schedulePage - 1) * PageSize).Take(PageSize);

    private int ScheduleFirstItem =>
        FilteredSchedules.Any() ? ((schedulePage - 1) * PageSize) + 1 : 0;

    private int ScheduleLastItem =>
        Math.Min(schedulePage * PageSize, FilteredSchedules.Count());

    protected override async Task OnInitializedAsync()
    {
        await LoadLaboratories();
        await LoadSchedules();
    }

    private async Task LoadLaboratories()
    {
        try
        {
            var result = await LaboratoryService.GetAllAsync();
            laboratories = result.Select(l => (Id: l.Id, Name: l.Name)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load laboratories.";
            Console.WriteLine(ex);
        }
    }

    private async Task LoadSchedules()
    {
        isLoadingSchedules = true;

        try
        {
            schedules = (await ScheduleService.GetAllAsync()).ToList();
            schedulePage = Math.Min(schedulePage, ScheduleTotalPages);
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load class schedules.";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoadingSchedules = false;
        }
    }

    private void ResetSchedulePage() => schedulePage = 1;

    private void ChangeSchedulePage(int page) =>
        schedulePage = Math.Clamp(page, 1, ScheduleTotalPages);

    private void OpenCreateSchedule()
    {
        editingScheduleId = null;
        showScheduleModal = true;
    }

    private void OpenEditSchedule(int id)
    {
        editingScheduleId = id;
        showScheduleModal = true;
    }

    private void CloseScheduleModal()
    {
        showScheduleModal = false;
        editingScheduleId = null;
    }

    private async Task HandleScheduleSaved()
    {
        var wasEditing = editingScheduleId is not null;

        showScheduleModal = false;
        await LoadSchedules();

        Toasts.Show(wasEditing
            ? "Class schedule updated successfully."
            : "Class schedule added successfully.", ToastService.ToastType.Success);
    }

    private async Task DeleteSchedule(int id)
    {
        var confirmed = await Dialogs.ShowConfirmDialogAsync(
        "Are you sure you want to delete this class schedule? This cannot be undone.",
        "Delete Class Schedule");

        if (!confirmed)
        return;

        deletingScheduleId = id;
        errorMessage = null;

        try
        {
            await ScheduleService.DeleteAsync(id);
            await LoadSchedules();
            Toasts.Show("Class schedule deleted successfully.", ToastService.ToastType.Success);
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to delete class schedule.";
            Console.WriteLine(ex);
        }
        finally
        {
            deletingScheduleId = null;
        }
    }
}
