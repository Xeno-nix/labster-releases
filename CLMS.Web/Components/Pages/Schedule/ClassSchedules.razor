@page "/schedules"
@attribute [Authorize]
@using CLMS.Application.Services
@rendermode InteractiveServer
@inject ClassScheduleService ScheduleService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Class Schedules</PageTitle>

<div class="p-8 relative">

    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="fixed top-6 right-6 flex items-center gap-2.5 bg-[#1f7a3f] text-white px-[1.1rem] py-3 rounded-lg text-sm font-medium shadow-lg z-[2000] animate-[toast-in_0.2s_ease-out]">
            <span class="inline-flex items-center justify-center w-[18px] h-[18px] rounded-full bg-white/25 text-xs font-bold">✓</span>
            <span>@toastMessage</span>
        </div>
    }

    <div class="flex justify-between items-center mb-6">
        <div>
            <button type="button"
                class="mb-4 inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700"
                @onclick="BackToCalendar">
                ← Back to Calendar
            </button>
            <h3 class="m-0 text-2xl text-gray-800">Class Schedules</h3>
            <p class="mt-1 mb-0 text-gray-500 text-sm">Manage recurring class schedules.</p>
        </div>
        <button type="button" class="px-4 py-2.5 bg-[#7a1f2b] text-white border-none rounded-md text-sm cursor-pointer hover:bg-[#651923] transition-colors" @onclick="OpenCreateForm">
            + Add Class Schedule
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-[#fdecea] text-[#b3261e] border border-[#f5c2c0] rounded-md px-4 py-3 text-sm mb-5">@errorMessage</div>
    }

    @if (isLoading)
    {
        <p class="text-gray-500 text-sm py-4">Loading schedules...</p>
    }
    else if (!schedules.Any())
    {
        <div class="py-12 px-6 text-center bg-white border border-gray-200 rounded-lg">
            <div class="mb-3 text-3xl opacity-35">📋</div>
            <h5 class="m-0 text-gray-600 text-sm">No class schedules yet</h5>
            <p class="mt-1.5 mb-4 text-gray-400 text-xs">Add your first class schedule to get started.</p>
            <button type="button" class="px-3.5 py-2 bg-[#7a1f2b] text-white border-none rounded-md text-sm cursor-pointer hover:bg-[#651923]" @onclick="OpenCreateForm">
                + Add Class Schedule
            </button>
        </div>
    }
    else
    {
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden overflow-x-auto">
            <table class="w-full border-collapse min-w-[700px]">
                <thead>
                    <tr>
                        <th class="text-left px-[1.1rem] py-3.5 bg-gray-50 text-gray-600 text-xs font-semibold uppercase tracking-wide border-b border-gray-200">Course</th>
                        <th class="text-left px-[1.1rem] py-3.5 bg-gray-50 text-gray-600 text-xs font-semibold uppercase tracking-wide border-b border-gray-200">Instructor</th>
                        <th class="text-left px-[1.1rem] py-3.5 bg-gray-50 text-gray-600 text-xs font-semibold uppercase tracking-wide border-b border-gray-200">Laboratory</th>
                        <th class="text-left px-[1.1rem] py-3.5 bg-gray-50 text-gray-600 text-xs font-semibold uppercase tracking-wide border-b border-gray-200">Day</th>
                        <th class="text-left px-[1.1rem] py-3.5 bg-gray-50 text-gray-600 text-xs font-semibold uppercase tracking-wide border-b border-gray-200">Time</th>
                        <th class="text-left px-[1.1rem] py-3.5 bg-gray-50 text-gray-600 text-xs font-semibold uppercase tracking-wide border-b border-gray-200">Term</th>
                        <th class="text-left px-[1.1rem] py-3.5 bg-gray-50 text-gray-600 text-xs font-semibold uppercase tracking-wide border-b border-gray-200"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var schedule in schedules)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-[1.1rem] py-3.5 border-b border-gray-100 text-gray-700 text-sm align-middle">
                                <span class="block text-[#7a1f2b] font-semibold">@schedule.CourseCode</span>
                                <span class="block text-gray-400 text-xs mt-0.5">@schedule.CourseName</span>
                            </td>
                            <td class="px-[1.1rem] py-3.5 border-b border-gray-100 text-gray-700 text-sm align-middle">@schedule.InstructorName</td>
                            <td class="px-[1.1rem] py-3.5 border-b border-gray-100 text-gray-700 text-sm align-middle">@schedule.LaboratoryName</td>
                            <td class="px-[1.1rem] py-3.5 border-b border-gray-100 text-gray-700 text-sm align-middle">@schedule.DayOfWeek</td>
                            <td class="px-[1.1rem] py-3.5 border-b border-gray-100 text-gray-700 text-sm align-middle">@schedule.TimeStart.ToString("hh:mm tt") - @schedule.TimeEnd.ToString("hh:mm tt")</td>
                            <td class="px-[1.1rem] py-3.5 border-b border-gray-100 text-gray-700 text-sm align-middle">
                                <span class="inline-block px-2 py-1 bg-gray-100 rounded text-gray-500 text-xs mr-1">@schedule.Semester semester</span>
                                <span class="inline-block px-2 py-1 bg-gray-100 rounded text-gray-500 text-xs mr-1">@schedule.AcademicYear</span>
                            </td>
                            <td class="px-[1.1rem] py-3.5 border-b border-gray-100 text-right align-middle">
                                <div class="flex gap-2 justify-end">
                                    <button type="button" class="px-3.5 py-1.5 border border-gray-300 bg-white text-[#7a1f2b] rounded-md text-xs font-medium cursor-pointer hover:bg-[#fff8f8] hover:border-[#7a1f2b]" @onclick="() => OpenEditForm(schedule.Id)">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="px-3.5 py-1.5 border border-gray-300 bg-white text-[#b3261e] rounded-md text-xs font-medium cursor-pointer hover:bg-[#fdecea] hover:border-[#b3261e] disabled:opacity-60 disabled:cursor-default"
                                            disabled="@(deletingId == schedule.Id)"
                                            @onclick="() => DeleteSchedule(schedule.Id)">
                                        @(deletingId == schedule.Id ? "Deleting..." : "Delete")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showModal)
{
    <ClassScheduleModal ScheduleId="editingId"
                         OnClose="CloseModal"
                         OnSaved="HandleSaved" />
}

@code {
    private IEnumerable<ClassScheduleDTO> schedules = Enumerable.Empty<ClassScheduleDTO>();

    private bool isLoading = true;
    private bool showModal;
    private int? editingId;
    private int? deletingId;
    private string? errorMessage;

    private string? toastMessage;
    private CancellationTokenSource? toastCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedules();
    }

    private async Task LoadSchedules()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            schedules = await ScheduleService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load class schedules.";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateForm()
    {
        editingId = null;
        showModal = true;
    }

    private void OpenEditForm(int id)
    {
        editingId = id;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSaved()
    {
        var wasEditing = editingId is not null;
        showModal = false;
        await LoadSchedules();
        ShowToast(wasEditing ? "Class schedule updated successfully." : "Class schedule added successfully.");
    }

    private async Task DeleteSchedule(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm", "Are you sure you want to delete this class schedule? This cannot be undone.");

        if (!confirmed)
        {
            return;
        }

        deletingId = id;
        errorMessage = null;

        try
        {
            await ScheduleService.DeleteAsync(id);
            await LoadSchedules();
            ShowToast("Class schedule deleted successfully.");
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to delete class schedule.";
            Console.WriteLine(ex);
        }
        finally
        {
            deletingId = null;
        }
    }

    private void BackToCalendar() => Navigation.NavigateTo("schedule/calendar-view");
    private void ShowToast(string message)
    {
        toastMessage = message;
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3000, token);
                if (!token.IsCancellationRequested)
                {
                    toastMessage = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException) { }
        });
    }
}