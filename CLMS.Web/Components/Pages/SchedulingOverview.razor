@using CLMS.Web.Components.Pages.Schedule
@using CLMS.Application.Services
@inject ClassScheduleService ScheduleService
@inject AcademicTermService AcademicTermService
@inject BookingService BookingService
@inject LaboratoryService LaboratoryService
@inject NavigationManager Navigation



<div class="dashboard relative">

    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="fixed top-6 right-6 flex items-center gap-2.5 bg-[#1f7a3f] text-white px-4.5 py-3 rounded-lg text-sm font-medium shadow-lg z-[2000] animate-[toast-in_0.2s_ease-out]">
            <span class="inline-flex items-center justify-center w-4.5 h-4.5 rounded-full bg-white/25 text-[0.65rem]">
                <i class="fa-solid fa-check"></i>
            </span>
            <span>@toastMessage</span>
        </div>
    }

    <div class="schedule-layout">
        <section class="month-panel" aria-label="Schedule calendar">
            <header class="month-header">
                <h2>@CurrentMonth.ToString("MMMM yyyy")</h2>
                <button type="button" aria-label="Previous month" @onclick="PreviousMonth">‹</button>
                <button type="button" aria-label="Next month" @onclick="NextMonth">›</button>
            </header>
            <div class="month-grid">
                @foreach (var day in WeekDays)
                {
                    <span class="weekday">@day</span>
                }
                @foreach (var date in GetCalendarDays())
                {
                    var classes = GetSchedulesForDate(date).ToArray();
                    var bookingCount = GetBookingsForDate(date).Count();
                    var previewId = $"classes-{date:yyyyMMdd}";
                    <div @key="date" class="month-cell" style="@($"--column:{(int)date.DayOfWeek}")">
                        <button type="button" class="date-button @(date.Month != CurrentMonth.Month ? "other-month" : "")"
                                aria-current="@(date == DateTime.Today ? "date" : null)"
                                aria-pressed="@(SelectedDate == date ? "true" : "false")"
                                aria-label="@($"{date:dddd, MMMM d}: {classes.Length} classes, {bookingCount} bookings")"
                                aria-describedby="@(classes.Length > 0 ? previewId : null)" @onclick="() => SelectDate(date)">
                            <span class="date-number">@date.Day</span>
                            <span class="event-markers" aria-hidden="true">
                                @foreach (var entry in classes)
                                {
                                    <span class="class-marker"></span>
                                }
                                @for (var i = 0; i < bookingCount; i++)
                                {
                                    <span class="booking-marker"></span>
                                }
                            </span>
                        </button>
                        @if (classes.Length > 0)
                        {
                            <div id="@previewId" role="tooltip" class="class-preview">
                                <strong>@date.ToString("ddd, MMM d") · @classes.Length @(classes.Length == 1 ? "class" : "classes")</strong>
                                @foreach (var entry in classes)
                                {
                                    <div class="preview-entry">
                                        <strong>@entry.CourseCode · @entry.CourseName</strong>
                                        <span>@FormatTime(entry.TimeStart) – @FormatTime(entry.TimeEnd)</span>
                                        <span>@entry.LaboratoryName · @entry.InstructorName</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <footer class="month-footer">
                <span><i class="class-marker" aria-hidden="true"></i> Class</span>
                <span><i class="booking-marker" aria-hidden="true"></i> Booking</span>
                <button type="button" class="today-button" @onclick="GoToToday">Today</button>
            </footer>
        </section>

        <div class="agenda-panel bg-white border border-gray-200 rounded-lg overflow-hidden">
            <div class="flex justify-between items-start p-5 border-b border-gray-200">

                <div>
                    <h4 class="m-0 text-[#7a1f2b] text-[1.05rem]">
                        @SelectedDate.ToString("dddd")
                    </h4>

                    <p class="mt-1 mb-0 text-gray-500 text-[0.8rem]">
                        @SelectedDate.ToString("MMMM d, yyyy")
                    </p>
                </div>



            </div>


            @if (SelectedDateSchedules.Any() || SelectedDateBookings.Any())
            {
                @if (SelectedDateSchedules.Any())
                {
                    <div class="px-5 py-3 bg-gray-50 text-gray-500 text-[0.75rem] border-b border-gray-200">
                        @SelectedDateSchedules.Count()
                        @(SelectedDateSchedules.Count() == 1
                            ? "class scheduled"
                            : "classes scheduled")
                    </div>

                    <div class="flex flex-col gap-3 p-4">

                        @foreach (var schedule in SelectedDateSchedules)
                        {
                            <div class="p-3.5 border border-gray-200 rounded-lg bg-white hover:border-[#d3b0b5]">

                                <div class="flex justify-between items-start gap-2 mb-3">

                                    <div class="text-[#7a1f2b] text-[0.95rem] font-bold">
                                        @schedule.CourseCode
                                    </div>

                                    <ActionMenu Label="Schedule actions">
                                        <button type="button" @onclick='() => Navigation.NavigateTo("/schedules")'>
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </button>
                                    </ActionMenu>

                                </div>

                                <div class="flex items-center gap-2 mt-1.5 text-gray-600 text-[0.75rem]">
                                    <span class="w-[18px] text-[#7a1f2b] text-center"><i class="fa-regular fa-clock"></i></span>
                                    <span>
                                        @FormatTime(schedule.TimeStart)
                                        -
                                        @FormatTime(schedule.TimeEnd)
                                    </span>
                                </div>

                                <div class="flex items-center gap-2 mt-1.5 text-gray-600 text-[0.75rem]">
                                    <span class="w-[18px] text-[#7a1f2b] text-center"><i class="fa-solid fa-building"></i></span>
                                    <span>
                                        @schedule.LaboratoryName
                                    </span>
                                </div>

                                <div class="flex items-center gap-2 mt-1.5 text-gray-600 text-[0.75rem]">
                                    <span class="w-[18px] text-[#7a1f2b] text-center"><i class="fa-solid fa-chalkboard-user"></i></span>
                                    <span>
                                        @schedule.InstructorName
                                    </span>
                                </div>

                                <div class="flex gap-1.5 mt-3 pt-2.5 border-t border-gray-100">
                                    <span class="px-1.5 py-1 bg-gray-100 rounded text-gray-500 text-[0.65rem]">
                                        @schedule.Semester
                                    </span>
                                    <span class="px-1.5 py-1 bg-gray-100 rounded text-gray-500 text-[0.65rem]">
                                        @schedule.AcademicYear
                                    </span>
                                </div>

                            </div>
                        }

                    </div>
                }

                @if (SelectedDateBookings.Any())
                {
                    <div class="px-5 py-3 bg-[#f4f7fc] text-[#2a4d8f] text-[0.75rem] border-y border-gray-200">
                        @SelectedDateBookings.Count()
                        @(SelectedDateBookings.Count() == 1
                            ? "booking scheduled"
                            : "bookings scheduled")
                    </div>

                    <div class="flex flex-col gap-3 p-4">

                        @foreach (var booking in SelectedDateBookings)
                        {
                            <div class="p-3.5 border border-gray-200 rounded-lg bg-white hover:border-[#b7c8e8]">

                                <div class="flex justify-between items-start gap-2 mb-3">

                                    <div class="text-[#2a4d8f] text-[0.95rem] font-bold">
                                        @booking.RequestorName
                                    </div>

                                    <ActionMenu Label="Booking actions">
                                        <button type="button" @onclick='() => Navigation.NavigateTo("/bookings")'>
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </button>
                                    </ActionMenu>

                                </div>

                                <div class="flex items-center gap-2 mt-1.5 text-gray-600 text-[0.75rem]">
                                    <span class="w-[18px] text-[#2a4d8f] text-center"><i class="fa-regular fa-clock"></i></span>
                                    <span>
                                        @FormatTime(booking.StartTime)
                                        -
                                        @FormatTime(booking.EndTime)
                                    </span>
                                </div>

                                <div class="flex items-center gap-2 mt-1.5 text-gray-600 text-[0.75rem]">
                                    <span class="w-[18px] text-[#2a4d8f] text-center"><i class="fa-solid fa-building"></i></span>
                                    <span>
                                        @GetLaboratoryName(booking.LaboratoryId)
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(booking.Purpose))
                                {
                                    <div class="flex items-center gap-2 mt-1.5 text-gray-600 text-[0.75rem]">
                                        <span class="w-[18px] text-[#2a4d8f] text-center"><i class="fa-solid fa-pen"></i></span>
                                        <span>
                                            @booking.Purpose
                                        </span>
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }
            }
            else
            {
                <div class="py-12 px-6 text-center">

                    <div class="mb-3 text-3xl opacity-35 text-[#7a1f2b]">
                        <i class="fa-regular fa-calendar-days"></i>
                    </div>

                    <h5 class="m-0 text-gray-600 text-sm">Nothing scheduled</h5>

                    <p class="mt-1.5 mb-4 text-gray-400 text-[0.75rem] leading-relaxed">
                        There are no classes or bookings for
                        @SelectedDate.ToString("MMMM d, yyyy").
                    </p>

                    <div class="flex justify-center gap-2.5">
                        <button type="button"
                                class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#7a1f2b] text-white border-none rounded-md text-[0.75rem] cursor-pointer hover:bg-[#651923]"
                                @onclick="() => OpenCreateModal(SelectedDate)">
                            <i class="fa-solid fa-plus"></i> Add Schedule
                        </button>
                        <button type="button"
                                class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white text-[#7a1f2b] border border-[#7a1f2b] rounded-md text-[0.75rem] cursor-pointer hover:bg-[#fff8f8]"
                                @onclick="() => OpenBookingModal(SelectedDate)">
                            <i class="fa-solid fa-plus"></i> Add Booking
                        </button>
                    </div>

                </div>
            }

        </div>

    </div>

</div>

@if (showCreateModal)
{
    <ClassScheduleModal InitialDate="createModalDate"
                         OnClose="CloseCreateModal"
                         OnSaved="HandleScheduleSaved" />
}

@if (showBookingModal)
{
    <BookingModal InitialDate="bookingModalDate"
                  OnClose="CloseBookingModal"
                  OnSaved="HandleBookingSaved" />
}

@code {

    private IEnumerable<ClassScheduleDTO> schedules =
        Enumerable.Empty<ClassScheduleDTO>();

    private IEnumerable<AcademicTermDTO> academicTerms =
        Enumerable.Empty<AcademicTermDTO>();

    private IEnumerable<BookingDTO> bookings =
        Enumerable.Empty<BookingDTO>();

    private IEnumerable<LaboratoryDTO> laboratories =
        Enumerable.Empty<LaboratoryDTO>();


    private DateTime CurrentMonth { get; set; } =
        new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1
        );

    private DateTime SelectedDate { get; set; } =
        DateTime.Today;

    private readonly string[] WeekDays =
    {
        "Sun",
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat"
    };


    private IEnumerable<ClassScheduleDTO> SelectedDateSchedules =>
        GetSchedulesForDate(SelectedDate);

    private IEnumerable<BookingDTO> SelectedDateBookings =>
        GetBookingsForDate(SelectedDate);

    private bool showCreateModal;
    private DateTime? createModalDate;

    private bool showBookingModal;
    private DateTime? bookingModalDate;

    private string? toastMessage;
    private CancellationTokenSource? toastCts;


    protected override async Task OnInitializedAsync()
    {
        schedules = await ScheduleService.GetAllAsync();
        academicTerms = await AcademicTermService.GetAllAsync();
        bookings = await BookingService.GetAllAsync();
        laboratories = await LaboratoryService.GetAllAsync();
    }

    private AcademicTermDTO? GetAcademicTermForDate(DateTime date)
    {
        var dateOnly = DateOnly.FromDateTime(date);

        return academicTerms.FirstOrDefault(term =>
            dateOnly >= term.StartDate &&
            dateOnly <= term.EndDate);
    }


    private void PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
    }


    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
    }


    private void GoToToday()
    {
        CurrentMonth = new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1
        );

        SelectedDate = DateTime.Today;
    }


    private void SelectDate(DateTime date)
    {

        SelectedDate = date;

        if (date.Month != CurrentMonth.Month ||
            date.Year != CurrentMonth.Year)
        {
            CurrentMonth = new DateTime(
                date.Year,
                date.Month,
                1
            );
        }
    }




    private IEnumerable<ClassScheduleDTO> GetSchedulesForDate(DateTime date)
    {
        var academicTerm = GetAcademicTermForDate(date);

        // No academic term covers this date,
        // so there should be no schedules.
        if (academicTerm == null)
        {
            return Enumerable.Empty<ClassScheduleDTO>();
        }

        return schedules
            .Where(schedule =>
                schedule.AcademicTermId == academicTerm.Id)
            .Where(schedule =>
                schedule.DayOfWeek == date.DayOfWeek)
            .OrderBy(schedule => schedule.TimeStart);

    }

    private IEnumerable<BookingDTO> GetBookingsForDate(DateTime date)
    {
        var dateOnly = DateOnly.FromDateTime(date);

        return bookings
            .Where(booking => booking.Date == dateOnly)
            .OrderBy(booking => booking.StartTime);
    }

    private string GetLaboratoryName(int labId)
        => laboratories.FirstOrDefault(l => l.Id == labId)?.Name ?? $"Lab {labId}";


    private List<DateTime> GetCalendarDays()
    {
        var firstDayOfMonth = CurrentMonth;

        int daysBeforeMonth =
            (int)firstDayOfMonth.DayOfWeek;

        var firstCalendarDay =
            firstDayOfMonth.AddDays(-daysBeforeMonth);

        int daysInMonth =
            DateTime.DaysInMonth(
                CurrentMonth.Year,
                CurrentMonth.Month
            );

        int totalDays =
            daysBeforeMonth + daysInMonth;

        int remainingDays =
            7 - (totalDays % 7);

        if (remainingDays == 7)
        {
            remainingDays = 0;
        }

        totalDays += remainingDays;

        var calendarDays = new List<DateTime>();

        for (int i = 0; i < totalDays; i++)
        {
            calendarDays.Add(
                firstCalendarDay.AddDays(i)
            );
        }

        return calendarDays;
    }


    private string FormatTime(TimeOnly time)
    {
        return time.ToString(
            "hh:mm tt",
            CultureInfo.InvariantCulture
        );
    }


    private void OpenCreateModal(DateTime? date)
    {
        createModalDate = date;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private async Task HandleScheduleSaved()
    {
        showCreateModal = false;
        schedules = await ScheduleService.GetAllAsync();
        ShowToast("Class schedule added successfully.");
    }

    private void OpenBookingModal(DateTime? date)
    {
        bookingModalDate = date;
        showBookingModal = true;
    }

    private void CloseBookingModal()
    {
        showBookingModal = false;
    }

    private async Task HandleBookingSaved()
    {
        showBookingModal = false;
        bookings = await BookingService.GetAllAsync();
        ShowToast("Booking added successfully.");
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3000, token);
                if (!token.IsCancellationRequested)
                {
                    toastMessage = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException) { }
        });
    }

}
