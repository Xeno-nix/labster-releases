@page "/inventory"

@attribute [Authorize(Roles = "Admin,Faculty")]
@using CLMS.Web.Components.Shared
@using CLMS.Web.Components.Pages.Inventory

<PageTitle>Inventory Management</PageTitle>

<div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-primary text-2xl mb-1">Inventory Management</h1>
            <p class="text-muted text-sm">Physical count records for equipment and consumable supplies</p>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <a href="@($"/inventory/print?tab={ActiveTab}")" target="_blank"
               class="flex items-center gap-2 px-4 py-2 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-[#2c2c2c]">
                Print List
            </a>
            @if (ActiveTab == "equipment")
            {
                <button type="button" @onclick="OpenScanner"
                        class="inventory-scan-button rounded-lg px-4 py-2 border border-black/10 text-sm font-semibold">
                    Scan QR
                </button>
                <button @onclick="OpenAddEquipment"
                        class="flex items-center gap-2 px-5 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors shadow-sm text-sm font-medium">
                    Add Equipment
                </button>
            }
            else
            {
                <button @onclick="OpenAddSupply"
                        class="flex items-center gap-2 px-5 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors shadow-sm text-sm font-medium">
                    Add Supply
                </button>
            }
        </div>
    </div>

    <div class="border-b border-black/10">
        <nav class="tab-strip segmented-tabs" aria-label="Inventory sections">
            <button type="button" aria-pressed='@(ActiveTab == "equipment")' @onclick='() => ActiveTab = "equipment"'
                    class="px-5 py-3 text-sm font-medium transition-colors flex items-center gap-2 -mb-px @(ActiveTab == "equipment" ? "border-b-2 border-primary text-primary" : "text-muted hover:text-[#2c2c2c]")">
                Equipment
                <span class="tab-count text-xs">(@Equipment.Count)</span>
            </button>
            <button type="button" aria-pressed='@(ActiveTab == "supplies")' @onclick='() => ActiveTab = "supplies"'
                    class="px-5 py-3 text-sm font-medium transition-colors flex items-center gap-2 -mb-px @(ActiveTab == "supplies" ? "border-b-2 border-primary text-primary" : "text-muted hover:text-[#2c2c2c]")">
                Supplies
                <span class="tab-count text-xs">(@Supplies.Count)</span>
            </button>
        </nav>
    </div>

    @if (ActiveTab == "equipment")
    {
        <div class="bg-white rounded-lg border border-black/10 shadow-sm">
            <div class="p-5 border-b border-black/10">
                <div class="filter-bar mobile-search-filters items-center">
                    <input type="search" aria-label="Search equipment" @bind="EqSearch" @bind:event="oninput"
                           placeholder="Search name, serial no., brand..."
                           class="flex-1 min-w-[180px] max-w-sm px-4 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                    <ResponsiveFilters Fields="EquipmentFilters" OnApply="ApplyEquipmentFilters" />
                </div>
            </div>

            <p class="table-hint">Scroll sideways for more details.</p>

            <div class="table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable records">
                <table role="table" class="responsive-records inventory-equipment-table data-table table-wide w-full">
                    <thead class="bg-surface">
                        <tr>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Equip. No.</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Serial No.</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Item Name</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Brand / Model</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Type</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Location</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Status</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">PM</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">CAL <span class="row-actions-caption">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5">
                        @foreach (var item in FilteredEquipment)
                        {
                            RenderFragment rowActions = @<text>
                                <button @onclick="() => OpenQr(item)" title="View / Print QR Code" class="p-1.5 hover:bg-white rounded-lg transition-colors">
                                    <i aria-hidden="true" class="fa-solid fa-qrcode"></i> View / Print QR
                                </button>
                                <button @onclick="() => OpenEditEquipment(item)" title="Edit" class="p-1.5 hover:bg-white rounded-lg transition-colors">
                                    <i aria-hidden="true" class="fa-solid fa-pen"></i> Edit details
                                </button>
                                <button @onclick="() => OpenDeleteEquipment(item)" title="Delete" class="p-1.5 hover:bg-white rounded-lg transition-colors">
                                    <i aria-hidden="true" class="fa-solid fa-trash-can"></i> Delete item
                                </button>
                            </text>;
                            <tr role="row" class="hover:bg-surface transition-colors">
                                <td role="cell" class="px-5 py-3 text-sm font-mono text-[#2c2c2c]">
                                    <div class="row-identity">
                                        <span class="record-identity">

                                            <span class="phone-record-name">
                                                <span class="phone-card-heading">
                                                    <strong>@item.EquipmentName</strong>
                                                    <StatusBadge Status="@item.EquipmentStatus" Kind="equipment" />
                                                </span>
                                                <span class="phone-card-subtitle">@item.EquipmentNo</span>
                                            </span>
                                            <span class="desktop-record-subtitle">@item.EquipmentNo</span>
                                        </span>
                                    </div>
                                </td>
                                <td role="cell" class="px-5 py-3 text-sm font-mono text-muted" data-label="Serial No.">@(item.SerialNo ?? "—")</td>
                                <td role="cell" class="px-5 py-3 text-sm font-medium text-[#2c2c2c]" data-label="Item Name">@item.EquipmentName</td>
                                <td role="cell" class="px-5 py-3 text-sm text-muted" data-label="Brand / Model">@(item.Brand ?? "—")@(item.ModelNumber is not null ? $" / {item.ModelNumber}" : "")</td>
                                <td role="cell" class="px-5 py-3 text-sm text-[#2c2c2c]" data-label="Type">@InventoryLookups.EquipmentTypeLabels.GetValueOrDefault(item.EquipmentType, item.EquipmentType)</td>
                                <td role="cell" class="px-5 py-3 text-sm text-muted" data-label="Location">@item.LocationLabel</td>
                                <td role="cell" class="px-5 py-3" data-label="Status"><StatusBadge Status="@item.EquipmentStatus" Kind="equipment" /></td>
                                <td role="cell" class="px-5 py-3 text-sm text-[#2c2c2c]" data-label="PM"><span>@(item.NeedsPm ? "Yes" : "No")<span class="phone-inline"> / @(item.NeedsCalibration ? "Yes" : "No")</span></span></td>
                                <td role="cell" class="px-5 py-3 text-sm text-[#2c2c2c] row-end-cell phone-menu-only" data-label="CAL">
                                    <div class="row-end-content">
                                        <div class="row-end-value">@(item.NeedsCalibration ? "Yes" : "No")</div>
                                        <div class="row-end-actions"><ActionMenu Label="@($"Actions for {item.EquipmentName}")">@rowActions</ActionMenu></div>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!FilteredEquipment.Any())
                        {
                            <tr>
                                <td colspan="9" class="px-5 py-12 text-center text-sm text-muted">
                                    @(Equipment.Count == 0 ? "No equipment added yet" : "No equipment matches your filters.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-4 border-t border-black/10">
                <p class="text-sm text-muted">Showing @FilteredEquipment.Count of @Equipment.Count items</p>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg border border-black/10 shadow-sm">
            <div class="p-5 border-b border-black/10">
                <div class="filter-bar mobile-search-filters items-center">
                    <input type="search" aria-label="Search supplies" @bind="SupSearch" @bind:event="oninput"
                           placeholder="Search supply name..."
                           class="flex-1 min-w-[180px] max-w-sm px-4 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                    <ResponsiveFilters Fields="SupplyFilters" OnApply="ApplySupplyFilters" />
                </div>
            </div>

            <p class="table-hint">Scroll sideways for more details.</p>

            <div class="table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable records">
                <table role="table" class="responsive-records data-table w-full">
                    <thead class="bg-surface">
                        <tr>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Supply Name</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Category</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Unit</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Status</th>
                            <th class="px-5 py-3 text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">Remarks <span class="row-actions-caption">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5">
                        @foreach (var item in FilteredSupplies)
                        {
                            RenderFragment rowActions = @<text>
                                <button @onclick="() => OpenEditSupply(item)" title="Edit" class="p-1.5 hover:bg-white rounded-lg transition-colors">
                                    <i aria-hidden="true" class="fa-solid fa-pen"></i> Edit details
                                </button>
                                <button @onclick="() => OpenDeleteSupply(item)" title="Delete" class="p-1.5 hover:bg-white rounded-lg transition-colors">
                                    <i aria-hidden="true" class="fa-solid fa-trash-can"></i> Delete item
                                </button>
                            </text>;
                            <tr role="row" class="hover:bg-surface transition-colors">
                                <td role="cell" class="px-5 py-3 text-sm font-medium text-[#2c2c2c]">
                                    <div class="row-identity">
                                        <span class="record-identity">
                                            <span class="phone-card-heading">
                                                <strong>@item.SupplyName</strong>
                                                <span class="phone-card-status"><StatusBadge Status="@item.Status" Kind="supply" /></span>
                                            </span>
                                            <span class="phone-only phone-card-subtitle">#@item.SupplyId</span>
                                        </span>
                                    </div>
                                </td>
                                <td role="cell" class="px-5 py-3 text-sm text-muted" data-label="Category">@item.Category</td>
                                <td role="cell" class="px-5 py-3 text-sm text-muted" data-label="Unit">@(item.Unit ?? "—")</td>
                                <td role="cell" class="px-5 py-3" data-label="Status"><select value="@item.Status" @onchange="e => ConfirmStatusChange(item, (string)e.Value!)"
                                                                        class="px-2 py-1 border border-black/10 rounded-md bg-white text-xs focus:border-primary focus:outline-none cursor-pointer">
                                                                    <option value="fully_stocked">Fully Stocked</option>
                                                                    <option value="in_stock">In Stock</option>
                                                                    <option value="low_stock">Low Stock</option>
                                                                    <option value="out_of_stock">Out of Stock</option>
                                                                </select></td>
                                <td role="cell" class="px-5 py-3 text-sm text-muted max-w-[160px] row-end-cell" data-label="Remarks">
                                    <div class="row-end-content">
                                        <div class="row-end-value"><span class="block truncate">@(item.Remarks ?? "—")</span></div>
                                        <div class="row-end-actions"><ActionMenu Label="@($"Actions for {item.SupplyName}")">@rowActions</ActionMenu></div>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!FilteredSupplies.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-5 py-12 text-center text-sm text-muted">
                                    @(Supplies.Count == 0 ? "No supplies added yet" : "No supplies match your filters.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-4 border-t border-black/10">
                <p class="text-sm text-muted">Showing @FilteredSupplies.Count of @Supplies.Count items</p>
            </div>
        </div>
    }

    @if (ShowScanner)
    {
        <UiSheet Label="Scan equipment" OnClose="CloseScanner">
            <section class="scanner-sheet p-4 sm:p-6">
                <header class="sheet-header flex items-center justify-between pb-3">
                    <h2 class="text-lg font-semibold">Scan equipment QR</h2>
                    <button type="button" @onclick="CloseScanner" aria-label="Close scanner">✕</button>
                </header>
                @if (ScannerHasCamera != false)
                {
                    <div class="scanner-preview">
                        <video id="@ScannerVideoElementId" autoplay muted playsinline aria-label="Camera preview"></video>
                        <span class="scanner-target" aria-hidden="true"></span>
                        @if (ScannerHasCamera is null)
                        {
                            <p role="status" class="scanner-status">Starting camera…</p>
                        }
                    </div>
                    <p class="mt-2 text-sm text-muted">Center the equipment QR code in the frame.</p>
                }
                else
                {
                    @if (ScannerError is not null)
                    {
                        <p role="alert" class="my-3 text-sm text-error">@ScannerError</p>
                    }
                    <button type="button" class="mt-3 rounded-lg border px-4" @onclick="StartScannerCamera">Retry camera</button>
                }
                @if (scanFeedback is not null)
                {
                    <p role="alert" class="mt-3 text-sm text-error">@scanFeedback</p>
                }
                <form class="mt-4 space-y-2" @onsubmit="ScanEquipmentCode" @onsubmit:preventDefault>
                    <label for="scanner-tag" class="block text-sm font-medium">Equipment tag or serial number</label>
                    <div class="flex flex-wrap gap-2">
                        <input id="scanner-tag" @bind="ScannerCode" @bind:event="oninput" placeholder="e.g. EQ-001"
                               class="min-w-0 flex-1 rounded-lg border border-black/10 bg-surface px-3" />
                        <button type="submit" class="rounded-lg bg-primary px-4 text-sm font-medium text-white">Find item</button>
                    </div>
                </form>
            </section>
        </UiSheet>
    }

    @if (ShowQr && SelectedEquipment is not null)
    {
        <UiSheet Label="Equipment details and assignment" OnClose="CloseQr" >
            <div class="bg-white rounded-xl w-full max-w-lg shadow-2xl p-6 max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-lg font-semibold text-[#2c2c2c]">@SelectedEquipment.EquipmentName</h3>
                    <button type="button" @onclick="CloseQr" class="p-2 hover:bg-surface rounded-lg transition-colors">✕</button>
                </div>

                <dl class="grid grid-cols-2 gap-3 rounded-lg bg-surface p-3 text-sm">
                    <div><dt class="text-muted">Equipment tag</dt><dd class="font-medium break-words">@SelectedEquipment.EquipmentNo</dd></div>
                    <div><dt class="text-muted">Status</dt><dd><StatusBadge Status="@SelectedEquipment.EquipmentStatus" Kind="equipment" /></dd></div>
                    <div><dt class="text-muted">Location</dt><dd class="break-words">@SelectedEquipment.LocationLabel</dd></div>
                    <div><dt class="text-muted">Serial number</dt><dd class="break-words">@(SelectedEquipment.SerialNo ?? "—")</dd></div>
                </dl>
                @if (scannedItem)
                {
                    <button type="button" class="my-3 w-full rounded-lg bg-primary px-4 text-sm font-semibold text-white sm:w-auto" @onclick="ScanAnother">Scan another</button>
                }
                <details open="@(!scannedItem)" class="mt-3">
                    <summary class="cursor-pointer py-2 text-sm font-medium text-primary">Equipment QR code</summary>
                    <div id="@QrElementId" class="flex min-h-[180px] items-center justify-center"></div>
                    <button type="button" @onclick="DownloadQr" class="mt-2 rounded-lg border border-black/10 px-4 py-2 text-sm">Download QR</button>
                </details>
                <hr class="my-5 border-black/10" />

                <h4 class="text-sm font-semibold text-[#2c2c2c] mb-3">Update record</h4>
                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-muted mb-1.5">Status</label>
                            <select @bind="QrEditStatus" class="w-full px-3 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none cursor-pointer">
                                <option value="available">Available</option>
                                <option value="in_use">In Use</option>
                                <option value="maintenance">Maintenance</option>
                                <option value="damaged">Damaged</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-2 justify-end">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="QrEditNeedsPm" class="w-4 h-4 text-primary focus:ring-primary/20 border-black/20 rounded" />
                                <span class="text-sm font-medium text-[#2c2c2c]">Needs PM</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="QrEditNeedsCalibration" class="w-4 h-4 text-primary focus:ring-primary/20 border-black/20 rounded" />
                                <span class="text-sm font-medium text-[#2c2c2c]">Needs Calibration</span>
                            </label>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-muted mb-1.5">Remarks</label>
                        <textarea @bind="QrEditRemarks" rows="2" placeholder="Optional notes..."
                                  class="w-full px-3 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all resize-none"></textarea>
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6">
                    <button type="button" @onclick="CloseQr" class="px-4 py-2 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm">Close</button>
                    <button type="button" @onclick="SaveQrEdit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">Save Changes</button>
                </div>

                <hr class="my-5 border-black/10" />

                <h4 class="text-sm font-semibold text-[#2c2c2c] mb-1">Assign / Reassign location</h4>
                <p class="text-xs text-muted mb-3">
                    Currently: <span class="font-medium text-[#2c2c2c]">@SelectedEquipment.LocationLabel</span>
                </p>
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-muted mb-1.5">Assign to laboratory</label>
                            <select @bind="QrReassignLabId" class="w-full px-3 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none cursor-pointer">
                                @foreach (var lab in Labs)
                                {
                                    <option value="@lab.LabId">@lab.LabName</option>
                                }
                            </select>
                        </div>
                        @if (SelectedEquipment.CurrentComputerUnitId is not null || SelectedEquipment.CurrentLaboratoryId is not null)
                        {
                            <div>
                                <label class="block text-xs font-medium text-muted mb-1.5">Reason for change</label>
                                <select @bind="QrReassignEndReason" class="w-full px-3 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none cursor-pointer">
                                    @foreach (var reason in InventoryLookups.AssignmentEndReasonLabels)
                                    {
                                        <option value="@reason.Key">@reason.Value</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                    <div class="flex justify-end">
                        <button type="button" @onclick="ReassignToLab" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
                            @(SelectedEquipment.CurrentComputerUnitId is not null || SelectedEquipment.CurrentLaboratoryId is not null ? "Reassign" : "Assign")
                        </button>
                    </div>
                </div>
            </div>
        </UiSheet>
    }
</div>

<EquipmentFormModal Show="ShowEquipmentForm" IsEdit="EditingEquipment" Model="EquipmentFormModel"
                   OnCancel="CloseEquipmentForm" OnSave="SaveEquipment" />

<SupplyFormModal Show="ShowSupplyForm" IsEdit="EditingSupply" Model="SupplyFormModel"
                OnCancel="CloseSupplyForm" OnSave="SaveSupply" />
