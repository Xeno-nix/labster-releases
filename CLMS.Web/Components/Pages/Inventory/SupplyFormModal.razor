@using CLMS.Web.Components.Pages.Inventory

@if (Show)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" @onclick="Cancel">
        <div class="bg-white rounded-xl w-full max-w-xl shadow-2xl max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between p-6 border-b border-black/10 sticky top-0 bg-white z-10">
                <div>
                    <h2 class="text-primary text-lg">@(IsEdit ? "Edit Supply Item" : "Add Supply Item")</h2>
                    <p class="text-xs text-muted mt-0.5">Track consumables and replenishment levels.</p>
                </div>
                <button @onclick="Cancel" class="p-2 hover:bg-surface rounded-lg transition-colors">✕</button>
            </div>

            <EditForm Model="Model" OnValidSubmit="Submit" class="p-6 space-y-4">
                <DataAnnotationsValidator />

                <div>
                    <label class="block text-sm font-medium text-[#2c2c2c] mb-1.5">Supply Name <span class="text-primary">*</span></label>
                    <InputText @bind-Value="Model.SupplyName" placeholder="e.g., Bond Paper"
                               class="w-full px-4 py-2.5 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                    <ValidationMessage For="() => Model.SupplyName" class="mt-1 text-xs text-primary" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-[#2c2c2c] mb-1.5">Category <span class="text-primary">*</span></label>
                        <InputSelect @bind-Value="Model.Category"
                                     class="w-full px-4 py-2.5 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none cursor-pointer">
                            @foreach (var category in InventoryLookups.SupplyCategories)
                            {
                                <option value="@category">@category</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-[#2c2c2c] mb-1.5">Unit</label>
                        <InputText @bind-Value="Model.Unit" placeholder="ream, box, piece"
                                   class="w-full px-4 py-2.5 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-[#2c2c2c] mb-1.5">Status <span class="text-primary">*</span></label>
                    <InputSelect @bind-Value="Model.Status"
                                 class="w-full px-4 py-2.5 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none cursor-pointer">
                        <option value="fully_stocked">Fully Stocked</option>
                        <option value="in_stock">In Stock</option>
                        <option value="low_stock">Low Stock</option>
                        <option value="out_of_stock">Out of Stock</option>
                    </InputSelect>
                </div>

                <div>
                    <label class="block text-sm font-medium text-[#2c2c2c] mb-1.5">Remarks</label>
                    <InputTextArea @bind-Value="Model.Remarks" rows="3"
                                   class="w-full px-4 py-2.5 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all resize-none" />
                </div>

                <div class="flex justify-end gap-3 pt-2 border-t border-black/10">
                    <button type="button" @onclick="Cancel"
                            class="px-5 py-2.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm">Cancel</button>
                    <button type="submit"
                            class="px-5 py-2.5 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
                        @(IsEdit ? "Update Supply" : "Save Supply")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter, EditorRequired] public SupplyItem Model { get; set; } = new();
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<SupplyItem> OnSave { get; set; }

    private Task Cancel() => OnCancel.InvokeAsync();
    private Task Submit() => OnSave.InvokeAsync(Model);
}
