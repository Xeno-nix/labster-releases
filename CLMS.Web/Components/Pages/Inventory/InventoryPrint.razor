@page "/inventory/print"
@attribute [Authorize(Policy = Privileges.Prefix + Privileges.InventoryView)]
@using CLMS.Application.Authorization
@using CLMS.Web.Components.Pages.Inventory
@layout Layout.PrintLayout

<PageTitle>@(Tab == "equipment" ? "Equipment" : "Supplies") Masterlist — Print</PageTitle>

@if (!Loaded)
{
    <p class="p-6" role="status">Loading inventory preview…</p>
}
else
{
    <PrintPreview @key="Tab" EditLabel="Edit print list">
        @for (var page = 0; page < PageCount; page++)
        {
            var offset = page * RowsPerPage;
            var end = Math.Min(offset + RowsPerPage, RowCount);
            var rows = end - offset;
            var blankRows = end == RowCount ? Math.Min(RowsPerPage - rows, Math.Max(5, 10 - rows)) : 0;
            <PrintLetterhead PageNumber="@(page + 1)" PageCount="@PageCount" SheetClass="inventory-print-sheet">
                <Header>
                    <table class="doc-header">
                        <tr>
                            <td class="logo-cell"><img src="/images/usep-logo.png" alt="USeP Logo" /></td>
                            <td class="univ-info-cell">
                                <div data-print-field data-repeat-field="inventory-heading-1">Republic of the Philippines</div>
                                <div class="univ-name" data-print-field data-repeat-field="inventory-heading-2">University of Southeastern Philippines</div>
                                <div data-print-field data-repeat-field="inventory-heading-3">Iñigo St., Bo. Obrero, Davao City 8000</div>
                                <div data-print-field data-repeat-field="inventory-heading-4">Telephone: (082) 227-8192</div>
                                <div data-print-field data-repeat-field="inventory-heading-5">Website: www.usep.edu.ph</div>
                                <div data-print-field data-repeat-field="inventory-heading-6">Email: president@usep.edu.ph</div>
                            </td>
                            <td class="meta-cell">
                                <table class="meta-table">
                                    <tr><td data-print-field data-repeat-field="inventory-form-1">Form No.</td><td data-print-field data-repeat-field="inventory-form-2">PM-USeP-PMS-01a</td></tr>
                                    <tr><td data-print-field data-repeat-field="inventory-form-3">Issue Status</td><td data-print-field data-repeat-field="inventory-form-4">02</td></tr>
                                    <tr><td data-print-field data-repeat-field="inventory-form-5">Revision No.</td><td data-print-field data-repeat-field="inventory-form-6">01</td></tr>
                                    <tr><td data-print-field data-repeat-field="inventory-form-7">Date Effective</td><td data-print-field data-repeat-field="inventory-form-8">01 March 2018</td></tr>
                                    <tr><td data-print-field data-repeat-field="inventory-form-9">Approved by</td><td data-print-field data-repeat-field="inventory-form-10">President</td></tr>
                                </table>
                            </td>
                        </tr>
                        <tr class="doc-title-row">
                            <td colspan="3">
                                <span class="masterlist-title" data-print-field data-repeat-field="title">@DocumentTitle</span>
                                <span class="updated-date" data-print-field data-repeat-field="subtitle">@UpdatedDate</span>
                            </td>
                        </tr>
                    </table>
                </Header>
                <ChildContent>
                    @if (Tab == "equipment")
                    {
                        <table class="masterlist-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="width: 40px;">NO.</th>
                                    <th rowspan="2" style="width: 100px;">EQUIPMENT NO.</th>
                                    <th rowspan="2" class="text-left">EQUIPMENT'S NAME</th>
                                    <th rowspan="2" class="text-left" style="width: 150px;">MODEL NAME/NUMBER</th>
                                    <th rowspan="2" style="width: 120px;">AREA ASSIGNMENT</th>
                                    <th colspan="2">NEEDS</th>
                                    <th rowspan="2" style="width: 100px;">STATUS</th>
                                </tr>
                                <tr>
                                    <th style="width: 40px;">PM</th>
                                    <th style="width: 40px;">CAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = offset; i < end; i++)
                                {
                                    var eq = EquipmentRows[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@eq.EquipmentNo</td>
                                        <td class="text-left">@eq.EquipmentName</td>
                                        <td class="text-left">@BrandModel(eq.Brand, eq.ModelNumber)</td>
                                        <td>@eq.LocationLabel</td>
                                        <td>@(eq.NeedsPm ? "✔" : "")</td>
                                        <td>@(eq.NeedsCalibration ? "✔" : "")</td>
                                        <td>@Capitalize(eq.EquipmentStatus)</td>
                                    </tr>
                                }
                                @for (var i = 0; i < blankRows; i++)
                                {
                                    <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <table class="masterlist-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px;">NO.</th>
                                    <th class="text-left">SUPPLY NAME</th>
                                    <th style="width: 120px;">CATEGORY</th>
                                    <th style="width: 80px;">UNIT</th>
                                    <th style="width: 100px;">STATUS</th>
                                    <th class="text-left" style="width: 200px;">REMARKS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = offset; i < end; i++)
                                {
                                    var sup = SuppliesRows[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td class="text-left">@sup.SupplyName</td>
                                        <td>@sup.Category</td>
                                        <td>@(sup.Unit ?? "—")</td>
                                        <td>@SupplyStatusLabel(sup.Status)</td>
                                        <td class="text-left">@(sup.Remarks ?? "—")</td>
                                    </tr>
                                }
                                @for (var i = 0; i < blankRows; i++)
                                {
                                    <tr class="empty-row"><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </ChildContent>
            </PrintLetterhead>
        }
    </PrintPreview>
}
