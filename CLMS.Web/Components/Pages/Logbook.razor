@page "/logbook"
@using Microsoft.AspNetCore.Components
@using CLMS.Application.DTOs.Logbook
@using CLMS.Application.Interfaces
@inject ILogbookService LogbookService

<PageTitle>CLMS — Logbook</PageTitle>

@* Static server-rendered page (no @rendermode) — filters/pagination are plain GET
   query params via <form method="get">/<a>, mirroring the Laravel original's full-page
   request/response flow rather than a SPA-style interactive rewrite. *@

<div class="space-y-6">

    <div>
        <h1 class="text-primary text-2xl mb-1">Logbook</h1>
        <p class="text-muted text-sm">
            Track laboratory usage and sign-in history
        </p>
    </div>

    @* NOTE: the Laravel source also has a Laboratory column + lab filter. The current
       attendance_logs table has no lab_id column, so there is no reliable way to show
       which laboratory a past session happened in — that column/filter is intentionally
       left out here rather than guessed at. See LogbookEntryDTO's remarks. *@

    <div class="bg-white rounded-lg border border-black/10 shadow-sm">

        <div class="p-6 border-b border-black/10 flex items-center gap-3 flex-wrap">

            <form method="get" action="/logbook" class="flex items-center gap-3 flex-wrap flex-1">

                <div class="relative flex-1 min-w-[200px] max-w-md">
                    <input type="text" name="search"
                           value="@Search"
                           placeholder="Search by Student ID, name, or purpose..."
                           class="w-full pl-4 pr-4 py-2 border border-black/10 rounded-lg bg-surface text-sm
                                  focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                </div>

                <select name="filter"
                        class="px-3 py-2 border border-black/10 rounded-lg bg-surface text-sm
                               focus:border-primary focus:outline-none cursor-pointer">
                    <option value="" selected="@(string.IsNullOrEmpty(Filter))">All time</option>
                    <option value="day" selected="@(Filter == "day")">Today</option>
                    <option value="week" selected="@(Filter == "week")">This week</option>
                    <option value="month" selected="@(Filter == "month")">This month</option>
                </select>

                <button type="submit"
                        class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
                    Apply
                </button>

                @if (!string.IsNullOrEmpty(Search) || !string.IsNullOrEmpty(Filter))
                {
                    <a href="/logbook"
                       class="px-4 py-2 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-muted">
                        Clear
                    </a>
                }
            </form>

            <a href="@ExportUrl"
               class="flex items-center gap-2 px-4 py-2 bg-success text-white rounded-lg hover:bg-success-dark transition-colors text-sm font-medium">
                Export CSV
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-surface">
                    <tr class="text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Student ID</th>
                        <th class="px-6 py-4">Name</th>
                        <th class="px-6 py-4">Purpose</th>
                        <th class="px-6 py-4">Time-in</th>
                        <th class="px-6 py-4">Time-out</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-black/5">
                    @if (PageResult.Entries.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-sm text-muted">
                                No entries found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var entry in PageResult.Entries)
                        {
                            <tr class="hover:bg-surface transition-colors">
                                <td class="px-6 py-4 text-sm text-muted whitespace-nowrap">
                                    @(entry.Date?.ToString("MMM dd, yyyy") ?? "—")
                                </td>
                                <td class="px-6 py-4 text-sm font-mono text-xs text-[#2c2c2c] whitespace-nowrap">
                                    @entry.StudentId
                                </td>
                                <td class="px-6 py-4 text-sm font-medium text-[#2c2c2c]">
                                    @entry.Name
                                </td>
                                <td class="px-6 py-4 text-sm text-[#2c2c2c]">
                                    @entry.Purpose
                                </td>
                                <td class="px-6 py-4 text-sm text-[#2c2c2c] whitespace-nowrap">
                                    @(entry.TimeIn?.ToString("h:mm tt") ?? "—")
                                </td>
                                <td class="px-6 py-4 text-sm whitespace-nowrap">
                                    @if (entry.TimeOut.HasValue)
                                    {
                                        <span class="text-[#2c2c2c]">@entry.TimeOut.Value.ToString("h:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block px-2 py-1 bg-success text-white rounded text-xs font-medium">
                                            In Session
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="p-4 border-t border-black/10 flex items-center justify-between flex-wrap gap-3">

            <p class="text-sm text-muted">
                Showing @PageResult.Entries.Count of @PageResult.TotalCount entries
            </p>

            @if (PageResult.TotalPages > 1)
            {
                <div class="flex items-center gap-1">
                    @if (CurrentPage > 1)
                    {
                        <a href="@PageUrl(CurrentPage - 1)"
                           class="px-3 py-1.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-[#2c2c2c]">
                            Previous
                        </a>
                    }

                    @for (var p = 1; p <= PageResult.TotalPages; p++)
                    {
                        var pageNumber = p;
                        @if (pageNumber == CurrentPage)
                        {
                            <span class="px-3 py-1.5 rounded-lg bg-primary text-white text-sm font-medium">
                                @pageNumber
                            </span>
                        }
                        else
                        {
                            <a href="@PageUrl(pageNumber)"
                               class="px-3 py-1.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-[#2c2c2c]">
                                @pageNumber
                            </a>
                        }
                    }

                    @if (CurrentPage < PageResult.TotalPages)
                    {
                        <a href="@PageUrl(CurrentPage + 1)"
                           class="px-3 py-1.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-[#2c2c2c]">
                            Next
                        </a>
                    }
                </div>
            }

        </div>

    </div>

</div>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    private string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "filter")]
    private string? Filter { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? Page { get; set; }

    private int CurrentPage => Page is > 0 ? Page.Value : 1;

    private LogbookPageResultDTO PageResult { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var query = new LogbookQueryDTO
        {
            Search = Search,
            Filter = Filter,
            Page = CurrentPage,
        };

        PageResult = await LogbookService.GetLogsAsync(query);
    }

    private string PageUrl(int page)
    {
        var qs = new List<string> { $"page={page}" };
        if (!string.IsNullOrEmpty(Search)) qs.Add($"search={Uri.EscapeDataString(Search)}");
        if (!string.IsNullOrEmpty(Filter)) qs.Add($"filter={Uri.EscapeDataString(Filter)}");
        return "/logbook?" + string.Join("&", qs);
    }

    private string ExportUrl
    {
        get
        {
            var qs = new List<string>();
            if (!string.IsNullOrEmpty(Search)) qs.Add($"search={Uri.EscapeDataString(Search)}");
            if (!string.IsNullOrEmpty(Filter)) qs.Add($"filter={Uri.EscapeDataString(Filter)}");
            return "/logbook/export" + (qs.Count > 0 ? "?" + string.Join("&", qs) : string.Empty);
        }
    }
}
