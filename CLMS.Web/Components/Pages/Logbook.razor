@page "/logbook"

@attribute [Authorize(Policy = Privileges.Prefix + Privileges.LogbookView)]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using CLMS.Application.DTOs.Logbook
@using CLMS.Application.Interfaces
@using CLMS.Application.Services

@inject LogbookService LogbookService
@inject LaboratoryService LaboratoryService

<PageTitle>Labster — Logbook</PageTitle>

<div class="space-y-6">

    <h1 class="text-primary text-2xl">Logbook</h1>
    
    @if (!string.IsNullOrEmpty(Success))
    {
        <div class="px-4 py-3 rounded-lg bg-success/10 border border-success/30 text-sm text-success">
            @Success
        </div>
    }

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
            @Error
        </div>
    }

    <div class="bg-white rounded-lg border border-black/10 shadow-sm">

        <div class="p-4 sm:p-6 border-b border-black/10 flex items-center gap-3 flex-wrap">

            <div class="filter-bar mobile-search-filters items-center flex-1">

                <div class="filter-search relative flex-1 min-w-0 w-full sm:min-w-[200px] max-w-md">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </span>
                    <input type="text"
                           @bind="Search"
                           @bind:event="oninput"
                           @bind:after="OnFiltersChangedAsync"
                           placeholder="Search by Student ID, name, or purpose..."
                           class="w-full pl-10 pr-4 py-2 border border-black/10 rounded-lg bg-surface text-sm
                                  focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                </div>

                <ResponsiveFilters Fields="LogbookFilters" OnApply="ApplyLogbookFiltersAsync" />
                @if (!string.IsNullOrEmpty(Search) || !string.IsNullOrEmpty(Filter) || LaboratoryId.HasValue)
                {
                    <button type="button"
                            @onclick="ClearFiltersAsync"
                       class="inline-filter-clear px-4 py-2 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-muted">
                        Clear
                    </button>
                }
            </div>

            <a href="@ExportUrl" data-enhance-nav="false"
               class="flex items-center gap-2 px-4 py-2 bg-success text-white rounded-lg hover:bg-success-dark transition-colors text-sm font-medium">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" x2="12" y1="15" y2="3" />
                </svg>
                Export CSV
            </a>
        </div>

        <p class="table-hint">Scroll sideways for more details.</p>

        <div class="table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable records">
            <table role="table" class="responsive-records data-table w-full">
                <thead class="bg-surface">
                    <tr class="text-left text-xs font-semibold text-[#2c2c2c] uppercase tracking-wide">
                        <th class="px-6 py-4">Name</th>
                        @if (PageResult.SupportsLaboratory)
                        {
                            <th scope="col" class="px-6 py-4">Laboratory</th>
                        }
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Student ID</th>
                        <th class="px-6 py-4">Purpose</th>
                        <th class="px-6 py-4">Time-in</th>
                        <th class="px-6 py-4">Time-out</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-black/5">
                    @if (PageResult.Entries.Count == 0)
                    {
                        <tr>
                            <td colspan="@(PageResult.SupportsLaboratory ? 7 : 6)" class="px-6 py-12 text-center text-sm text-muted">
                                No entries found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var entry in PageResult.Entries)
                        {
                            <tr role="row" class="hover:bg-surface transition-colors">
                                <td role="cell" class="px-6 py-4 text-sm font-medium text-[#2c2c2c]">@entry.Name</td>
                                @if (PageResult.SupportsLaboratory)
                                {
        <td role="cell" class="px-6 py-4 text-sm text-muted" data-label="Laboratory">@(entry.Laboratory ?? "—")</td>
                                }
                                <td role="cell" class="px-6 py-4 text-sm text-muted whitespace-nowrap" data-label="Date">@(entry.Date?.ToString("MMM dd, yyyy") ?? "—")</td>
                                <td role="cell" class="px-6 py-4 text-sm font-mono text-xs text-[#2c2c2c] whitespace-nowrap" data-label="Student ID">@entry.StudentId</td>
                                <td role="cell" class="px-6 py-4 text-sm text-[#2c2c2c]" data-label="Purpose">@entry.Purpose</td>
                                <td role="cell" class="px-6 py-4 text-sm text-[#2c2c2c] whitespace-nowrap" data-label="Time-in">@(entry.TimeIn?.ToString("h:mm tt") ?? "—")</td>
                                <td role="cell" class="px-6 py-4 text-sm whitespace-nowrap" data-label="Time-out">@if (entry.TimeOut.HasValue)
                                    {
                                        <span class="text-[#2c2c2c]">@entry.TimeOut.Value.ToString("h:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block px-2 py-1 bg-success text-white rounded text-xs font-medium">
                                            In Session
                                        </span>
                                    }</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="p-4 border-t border-black/10 flex items-center justify-between flex-wrap gap-3">

            <p class="text-sm text-muted">
                Showing @PageResult.Entries.Count of @PageResult.TotalCount entries
            </p>

            @if (PageResult.TotalPages > 1)
            {
                <div class="flex items-center gap-1">
                    @if (CurrentPage > 1)
                    {
                        <a href="@PageUrl(CurrentPage - 1)"
                           class="px-3 py-1.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-[#2c2c2c]">
                            Previous
                        </a>
                    }

                    @for (var p = 1; p <= PageResult.TotalPages; p++)
                    {
                        var pageNumber = p;
                        @if (pageNumber == CurrentPage)
                        {
                            <span class="px-3 py-1.5 rounded-lg bg-primary text-white text-sm font-medium">
                                @pageNumber
                            </span>
                        }
                        else
                        {
                            <a href="@PageUrl(pageNumber)"
                               class="px-3 py-1.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-[#2c2c2c]">
                                @pageNumber
                            </a>
                        }
                    }

                    @if (CurrentPage < PageResult.TotalPages)
                    {
                        <a href="@PageUrl(CurrentPage + 1)"
                           class="px-3 py-1.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm text-[#2c2c2c]">
                            Next
                        </a>
                    }
                </div>
            }

        </div>

    </div>

</div>

@code {
    private IReadOnlyList<ResponsiveFilterField> LogbookFilters
    {
        get
        {
            var fields = new List<ResponsiveFilterField>
            {
                new("Date range", "All time", "", Filter, [("day", "Today"), ("week", "This week"), ("month", "This month")])
            };
            if (PageResult.SupportsLaboratory)
                fields.Add(new("Laboratory", "All labs", "", LaboratoryId?.ToString(), Laboratories.Select(lab => (lab.Id.ToString(), lab.Name))));
            return fields;
        }
    }

    private Task ApplyLogbookFiltersAsync(string[] values)
    {
        Filter = values[0];
        LaboratoryId = int.TryParse(values.ElementAtOrDefault(1), out var lab) ? lab : null;
        return OnFiltersChangedAsync();
    }

    [SupplyParameterFromQuery(Name = "search")]
    private string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "filter")]
    private string? Filter { get; set; }

    [SupplyParameterFromQuery(Name = "lab")]
    private int? LaboratoryId { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "success")]
    private string? Success { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private int CurrentPage => Page is > 0 ? Page.Value : 1;

    private LogbookPageResultDTO PageResult { get; set; } = new();
    private IReadOnlyList<CLMS.Application.DTOs.Booking.LaboratoryDTO> Laboratories { get; set; } = [];

    protected override Task OnParametersSetAsync() => LoadLogsAsync();

    private async Task OnFiltersChangedAsync()
    {
        Page = 1;
        await LoadLogsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        Search = null;
        Filter = null;
        LaboratoryId = null;
        Page = 1;
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        PageResult = await LogbookService.GetLogsAsync(new LogbookQueryDTO
        {
            Search = Search,
            Filter = Filter,
            LaboratoryId = LaboratoryId,
            Page = CurrentPage,
        });
        if (PageResult.SupportsLaboratory && Laboratories.Count == 0)
            Laboratories = (await LaboratoryService.GetAllAsync()).OrderBy(lab => lab.Name).ToList();
    }

    private string PageUrl(int page)
    {
        var qs = new List<string> { $"page={page}" };
        if (!string.IsNullOrEmpty(Search)) qs.Add($"search={Uri.EscapeDataString(Search)}");
        if (!string.IsNullOrEmpty(Filter)) qs.Add($"filter={Uri.EscapeDataString(Filter)}");
        if (LaboratoryId is > 0) qs.Add($"lab={LaboratoryId}");
        return "/logbook?" + string.Join("&", qs);
    }

    private string ExportUrl
    {
        get
        {
            var qs = new List<string>();
            if (!string.IsNullOrEmpty(Search)) qs.Add($"search={Uri.EscapeDataString(Search)}");
            if (!string.IsNullOrEmpty(Filter)) qs.Add($"filter={Uri.EscapeDataString(Filter)}");
            if (LaboratoryId is > 0) qs.Add($"lab={LaboratoryId}");
            return "/logbook/export" + (qs.Count > 0 ? "?" + string.Join("&", qs) : string.Empty);
        }
    }
}
