@inject CLMS.Web.Services.ToastService Toasts
@attribute [Authorize]
@rendermode InteractiveServer
@using CLMS.Application.Services
@using CLMS.Domain.Enums
@inject AcademicTermService TermService
@inject ILogger<SchoolSemesters> Logger
@inject CLMS.Web.Services.DialogService Dialogs



<div class="space-y-6">
    @HeaderTemplate(HeaderActions)
    @if (loadError is not null)
    {
        <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@loadError <button type="button" class="ml-2 underline" @onclick="Load">Retry</button></div>
    }
    @if (actionError is not null)
    {
        <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@actionError</div>
    }
    <div class="overflow-hidden rounded-xl border border-black/10 bg-white">
        <div class="flex flex-col gap-3 border-b border-black/10 p-4 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="text-sm font-semibold text-gray-800">All School Semesters (@terms.Count)</h2>
            <input type="search" aria-label="Search school semesters" placeholder="Search school year or semester..." @bind="search" @bind:event="oninput" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none sm:w-72" />
        </div>
        <p class="table-hint">Scroll sideways for more details. The first column stays visible.</p>
        <div class="table-scroll overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable records">
            <table class="data-table w-full whitespace-nowrap text-left text-sm">
                <thead class="bg-surface text-xs uppercase text-muted"><tr><th scope="col" class="px-6 py-3">School Year</th><th scope="col" class="px-6 py-3">Semester</th><th scope="col" class="px-6 py-3">Start Date</th><th scope="col" class="px-6 py-3">End Date</th><th scope="col" class="px-6 py-3 text-right">Actions</th></tr></thead>
                <tbody class="divide-y divide-gray-100">
                    @if (loading)
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-muted">Loading school semesters...</td></tr>
                    }
                    else if (!FilteredTerms.Any())
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-muted">@(terms.Count == 0 ? "No school semesters yet. Add a semester to get started." : "No semesters match your search.")</td></tr>
                    }
                    else
                    {
                        @foreach (var term in FilteredTerms)
                        {
                            <tr @key="term.Id" class="hover:bg-surface">
                                <td class="px-6 py-4 font-medium text-primary">@term.AcademicYear</td>
                                <td class="px-6 py-4">@term.Semester Semester</td>
                                <td class="px-6 py-4 text-muted">@(term.StartDate?.ToString("MMM dd, yyyy") ?? "Not set")</td>
                                <td class="px-6 py-4 text-muted">@(term.EndDate?.ToString("MMM dd, yyyy") ?? "Not set")</td>
                                <td class="px-6 py-4 text-right whitespace-nowrap"><ActionMenu Label="Record actions">
                                    <button type="button" aria-label="Edit school semester" class="rounded-lg px-3 py-2 text-primary hover:bg-primary/10 disabled:opacity-60" disabled="@deleting" @onclick="() => Edit(term)">Edit</button>
                                    <button type="button" aria-label="Delete school semester" class="rounded-lg px-3 py-2 text-error hover:bg-error/10 disabled:opacity-60" disabled="@deleting" @onclick="() => Delete(term)">Delete</button>
                                </ActionMenu></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showForm)
{
    <UiSheet Label="School semester details" OnClose="() => showForm = false" Busy="@saving">
        <section aria-labelledby="semester-title" class="w-full max-w-[520px] rounded-xl border border-gray-200 bg-white p-6">
            <div class="sheet-header flex items-center justify-between mb-4"><h2 id="semester-title" class="mb-5 text-base font-semibold">@(editingId.HasValue ? "Edit School Semester" : "Add School Semester")</h2><button type="button" aria-label="Close" class="p-2 rounded-lg hover:bg-surface" disabled="@saving" @onclick="() => showForm = false">✕</button></div>
            @if (formError is not null)
            {
                <div role="alert" class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">@formError</div>
            }
            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <fieldset disabled="@saving" class="space-y-4">
                    <div>
                        <label for="school-year" class="mb-1.5 block text-xs text-gray-600">School Year</label>
                        <InputText id="school-year" @bind-Value="model.AcademicYear" maxlength="9" placeholder="e.g. 2026-2027" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none" />
                        <ValidationMessage For="@(() => model.AcademicYear)" class="mt-1 text-xs text-red-600" />
                    </div>
                    <div>
                        <label for="semester" class="mb-1.5 block text-xs text-gray-600">Semester</label>
                        <InputSelect id="semester" @bind-Value="model.Semester" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none">
                            <option value="">Select a semester</option>
                            @foreach (var semester in Enum.GetValues<Semester>())
                            {
                                <option value="@semester">@semester</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => model.Semester)" class="mt-1 text-xs text-red-600" />
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <label for="term-start" class="mb-1.5 block text-xs text-gray-600">Start Date</label>
                            <InputDate id="term-start" @bind-Value="model.StartDate" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none" />
                            <ValidationMessage For="@(() => model.StartDate)" class="mt-1 text-xs text-red-600" />
                        </div>
                        <div>
                            <label for="term-end" class="mb-1.5 block text-xs text-gray-600">End Date</label>
                            <InputDate id="term-end" @bind-Value="model.EndDate" class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none" />
                            <ValidationMessage For="@(() => model.EndDate)" class="mt-1 text-xs text-red-600" />
                        </div>
                    </div>
                    <div class="sheet-footer flex justify-end gap-3 pt-2">
                        <button type="button" class="rounded-md border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-100" @onclick="() => showForm = false">Cancel</button>
                        <button type="submit" class="rounded-md bg-primary px-5 py-2 text-sm text-white hover:bg-primary-dark disabled:opacity-60">@(saving ? "Saving..." : editingId.HasValue ? "Save Changes" : "Add School Semester")</button>
                    </div>
                </fieldset>
            </EditForm>
        </section>
    </UiSheet>
}

@code {
    [Parameter, EditorRequired]
    public RenderFragment<RenderFragment> HeaderTemplate { get; set; } = default!;

    private RenderFragment HeaderActions => @<div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <button type="button" class="rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-dark disabled:opacity-60" disabled="@(loading || deleting)" @onclick="OpenForm">+ Add School Semester</button>
    </div>;

    private List<AcademicTermDTO> terms = [];
    private CreateAcademicTermDTO model = new();
    private string search = string.Empty;
    private string? loadError, formError;
    private bool loading = true, saving, showForm;
    private bool deleting;
    private int? editingId;
    private string? actionError;
    private IEnumerable<AcademicTermDTO> FilteredTerms => terms.Where(t => t.AcademicYear.Contains(search, StringComparison.OrdinalIgnoreCase) || t.Semester.Contains(search, StringComparison.OrdinalIgnoreCase)).OrderByDescending(t => t.AcademicYear).ThenBy(t => Enum.TryParse<Semester>(t.Semester, out var semester) ? (int)semester : 0);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        loadError = null;
        try { terms = (await TermService.GetAllAsync()).ToList(); }
        catch (Exception ex) { Logger.LogError(ex, "Unable to load school semesters"); loadError = "Unable to load school semesters. Please try again."; }
        finally { loading = false; }
    }

    private void OpenForm()
    {
        editingId = null;
        actionError = null;
        model = new();
        formError = null;
        showForm = true;
    }

    private void Edit(AcademicTermDTO term)
    {
        editingId = term.Id;
        model = new() { AcademicYear = term.AcademicYear, Semester = Enum.TryParse<Semester>(term.Semester, out var semester) ? semester : null, StartDate = term.StartDate, EndDate = term.EndDate };
        formError = actionError = null;
        showForm = true;
    }

    private async Task Delete(AcademicTermDTO term)
    {
        if (deleting) return;
        deleting = true;
        actionError = null;
        try
        {
            if (!await Dialogs.ShowConfirmDialogAsync($"Delete {term.AcademicYear}, {term.Semester} semester? This cannot be undone.", "Delete School Semester")) return;
            await TermService.DeleteAsync(term.Id);
            Toasts.Show("School Semester deleted successfully.", CLMS.Web.Services.ToastService.ToastType.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { actionError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Unable to delete School Semester"); actionError = "Unable to delete the School Semester. Please try again."; }
        finally { deleting = false; }
    }

    private async Task Save()
    {
        if (saving) return;
        saving = true;
        formError = null;
        try
        {
            if (editingId is int id)
                await TermService.UpdateAsync(id, model);
            else
                await TermService.CreateAsync(model);
            showForm = false;
            search = string.Empty;
            Toasts.Show(editingId.HasValue ? "School semester updated successfully." : "School semester added successfully.", CLMS.Web.Services.ToastService.ToastType.Success);
            await Load();
        }
        catch (InvalidOperationException ex) { formError = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Unable to create school semester"); formError = "Unable to save the school semester. Please try again."; }
        finally { saving = false; }
    }
}
