@page "/access-denied"
@attribute [AllowAnonymous]
@layout PublicLayout

<PageTitle>Access denied</PageTitle>

<main class="mx-auto max-w-lg p-6">
    <h1 class="text-2xl font-heading font-semibold">Access denied</h1>
    <p class="my-4">CLMS could not verify your permission to open this page. If you should have access, contact your administrator.</p>
    <a href="/login" class="text-primary underline">Go to sign in</a>
</main>
