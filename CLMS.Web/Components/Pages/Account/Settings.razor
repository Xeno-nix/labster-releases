@page "/account/settings"
@attribute [Authorize]
@using System.Security.Claims
@using CLMS.Application.Identity.Services
@using CLMS.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationState
@inject TwoFactorSettingsService SecuritySettings

<PageTitle>Labster - Account settings</PageTitle>
<main class="mx-auto max-w-2xl break-words px-2 py-5 sm:px-6 sm:py-8">
    <h1 class="mb-6 text-2xl text-primary">Account settings</h1>
    @if (Message == "two_factor_disabled")
    {
        <p role="status" class="mb-4">Two-factor authentication is disabled. You remain signed in on this browser.</p>
    }
    <a class="text-primary underline" href="/account/change-password">Change password</a>
    <section class="mt-6 rounded border border-gray-300 bg-white p-5" aria-labelledby="two-factor-heading">
        <h2 id="two-factor-heading" class="mb-2 text-xl text-primary">Two-factor authentication</h2>
        @if (_error is not null)
        {
            <p role="alert">@_error</p>
            <a class="text-primary underline" href="/account/settings">Reload account settings</a>
        }
        else if (_status is null)
        {
            <p role="status">Loading account security…</p>
        }
        else
        {
            <p>Email 2FA is <strong>@(_status.Enabled ? "enabled" : "disabled")</strong> for @_status.Email.</p>
            <p class="mt-2">When enabled, an email code is required after password or Google sign-in.</p>
            <p class="mt-2">Changing this setting requires your current password and a fresh email code. Disabling keeps this browser signed in; enabling signs you out. Other sessions are revoked.</p>
            <form class="mt-4" method="post" action="/account/two-factor/request" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="enabled" value="@(!_status.Enabled ? "true" : "false")" />
                <button class="rounded bg-primary px-4 py-2 text-white" type="submit">@(_status.Enabled ? "Disable" : "Enable") 2FA</button>
            </form>
        }
    </section>
    <p class="mt-4">To link your matching organization Google account, use Sign in with Google and confirm your Labster password.</p>
    <a class="mt-2 inline-block text-primary underline" href="/auth/google/start">Sign in with Google</a>
</main>

@code {
    [SupplyParameterFromQuery(Name = "message")] public string? Message { get; set; }
    private TwoFactorSettingsStatus? _status;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            if (!Guid.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var id)) throw new UnauthorizedAccessException();
            _status = await SecuritySettings.StatusAsync(id, principal.FindFirstValue("security_stamp") ?? "");
        }
        catch (Exception) { _error = "Account security could not be loaded. Reload or sign in again."; }
    }
}
