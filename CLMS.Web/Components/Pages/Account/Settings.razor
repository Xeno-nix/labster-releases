@page "/account/settings"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using CLMS.Application.Identity.Services
@using CLMS.Shared.Dtos
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationState
@inject TwoFactorSettingsService SecuritySettings

<PageTitle>Labster - Account settings</PageTitle>
<div class="mx-auto max-w-2xl space-y-5">
    <header class="page-help-heading">
        <h1 class="text-2xl font-semibold text-primary">Account settings</h1>
        <PageHelp Guide="settings" />
    </header>

    <div class="rounded-lg border border-black/10 bg-white">
        <section class="flex flex-wrap items-center justify-between gap-4 p-5" aria-labelledby="password-heading">
            <h2 id="password-heading" class="text-base font-semibold text-primary">Password</h2>
            <a class="@SecondaryAction" href="/account/change-password">Change password</a>
        </section>

        <section class="border-t border-black/10 p-5" aria-labelledby="two-factor-heading">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 id="two-factor-heading" class="text-base font-semibold text-primary">Two-factor authentication</h2>
                @if (_status is not null)
                {
                    <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold @(_status.Enabled ? "text-success" : "text-muted")">
                        @(_status.Enabled ? "On" : "Off")
                    </span>
                }
            </div>

            @if (Message == "two_factor_disabled")
            {
                <p role="status" class="mt-3 rounded-lg border border-success/30 bg-success/10 p-3 text-sm text-success">
                    Two-factor authentication is disabled. You remain signed in on this browser.
                </p>
            }

            @if (_error is not null)
            {
                <p role="alert" class="mt-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">@_error</p>
                <a class="@($"{SecondaryAction} mt-3")" href="/account/settings">Reload account settings</a>
            }
            else if (_status is null)
            {
                <p role="status" class="mt-2 text-sm text-muted">Loading account security.</p>
            }
            else
            {
                <p class="mt-2 break-words text-sm text-muted">Email codes are sent to @_status.Email when 2FA is enabled.</p>
                <p class="mt-2 text-sm text-muted">When enabled, an email code is required after password or Google sign-in.</p>
                <p id="two-factor-change-help" class="mt-3 text-sm text-muted">
                    To change this setting, confirm your current password and a fresh email code.
                    @(_status.Enabled ? "Disabling keeps this browser signed in." : "Enabling signs you out.")
                    Other sessions are revoked.
                </p>
                <form class="mt-4" method="post" action="/account/two-factor/request" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="enabled" value="@(!_status.Enabled ? "true" : "false")" />
                    <button class="@(_status.Enabled ? SecondaryAction : PrimaryAction)" type="submit" aria-describedby="two-factor-change-help">
                        @(_status.Enabled ? "Disable" : "Enable") 2FA
                    </button>
                </form>
            }
        </section>

        <section class="flex flex-wrap items-center justify-between gap-4 border-t border-black/10 p-5" aria-labelledby="google-heading">
            <div>
                <h2 id="google-heading" class="text-base font-semibold text-primary">Organization Google account</h2>
                <p class="mt-2 text-sm text-muted">Sign in with your matching organization Google account and confirm your Labster password to link it.</p>
            </div>
            <a class="@($"{SecondaryAction} gap-3")" href="/auth/google/start">
                <svg class="shrink-0" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
                <span>Sign in with Google</span>
            </a>
        </section>
    </div>
</div>

@code {
    private const string SecondaryAction = "inline-flex items-center justify-center rounded-lg border border-black/10 px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface";
    private const string PrimaryAction = "inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-dark";

    [SupplyParameterFromQuery(Name = "message")] public string? Message { get; set; }
    private TwoFactorSettingsStatus? _status;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            if (!Guid.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var id)) throw new UnauthorizedAccessException();
            _status = await SecuritySettings.StatusAsync(id, principal.FindFirstValue("security_stamp") ?? "");
        }
        catch (Exception) { _error = "Account security could not be loaded. Reload or sign in again."; }
    }
}
