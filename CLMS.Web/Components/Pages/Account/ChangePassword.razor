@using CLMS.Web.Models

<AccountLayout Title="Change your password">
    <h1>Change your password</h1>
    <p>@Model.Email</p>
    @if (Model.PasswordChangeRequired)
    {
        <p><strong>You must change your initial password before using Labster.</strong></p>
    }
    @if (Model.Error is not null)
    {
        <p role="alert">@Model.Error</p>
    }
    <form method="post" action="/account/change-password">
        <AntiforgeryToken />
        <label for="current-password">Current password</label>
        <input id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" required />
        <label for="new-password">New password (at least 8 characters)</label>
        <input id="new-password" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required />
        <label for="confirm-password">Confirm new password</label>
        <input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required />
        <button type="submit">Change password</button>
    </form>
    <form method="post" action="/account/change-password/cancel">
        <AntiforgeryToken />
        <button class="secondary" type="submit">Sign out</button>
    </form>
</AccountLayout>

@code {
    [Parameter, EditorRequired] public AccountFormViewModel Model { get; set; } = default!;
}
