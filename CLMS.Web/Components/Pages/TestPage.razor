@page "/test"
@using CLMS.Web.Components.Modals
@using CLMS.Web.Components.Notification
@using CLMS.Web.Services
@inject ToastService Toasts
@inject DialogService Dialogs

<button @onclick="AddToast">Add Toast</button>
<Dialog/>
@code {
    /// <summary>
    /// This page is for testing components
    /// </summary>
    
    int cycle = 0;
    
    
    
    public async void AddToast()
    {
        if (cycle == 0)
        {
            await Dialogs.ShowMessageDialogAsync("Hello test");
        }
        else if (cycle == 1)
        {
            var result = await Dialogs.ShowConfirmDialogAsync("Hello test","Title");
            Console.WriteLine(result);
        }
        cycle = ++cycle % 2;
    }
}