@page "/schedule"


@inject IClassScheduleService ScheduleService
@inject NavigationManager Navigation

<PageTitle>Class Schedules</PageTitle>

<div class="schedule-container">

    <div class="schedule-header">
        <div>
            <h3>Class Schedules</h3>
            <p>List of all class schedules</p>
        </div>

        <a href="/schedules/create" class="btn-add">
            + Add Class Schedule
        </a>
    </div>

    @if (schedules.Any())
    {
        <div class="table-wrapper">
            <table class="schedule-table">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Semester</th>
                        <th>School Year</th>
                        <th>Instructor</th>
                        <th>Laboratory</th>
                        <th>Day</th>
                        <th>Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var schedule in schedules)
                    {
                        <tr>
                            <td>@schedule.CourseCode</td>

                            <td>
                                @schedule.
                            </td>

                            <td>
                                @schedule.AcademicTermId
                            </td>

                            <td>
                                @schedule.InstructorName
                            </td>

                            <td>
                                @schedule.LaboratoryName
                            </td>

                            <td>
                                @schedule.DayOfWeek
                            </td>

                            <td>
                                @schedule.TimeStart.ToString("hh\\:mm tt")
                                -
                                @schedule.TimeEnd.ToString("hh\\:mm tt")
                            </td>

                            <td>
                                <div class="actions">
                                    <button class="btn-edit"
                                            @onclick="() => EditSchedule(schedule.Id)">
                                        Edit
                                    </button>

                                    <button class="btn-delete"
                                            @onclick="() => DeleteSchedule(schedule.Id)">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            No class schedules found.
        </div>
    }

</div>

<style>
    .schedule-container {
        padding: 2rem;
    }

    .schedule-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .schedule-header h3 {
        margin: 0;
        font-size: 1.4rem;
    }

    .schedule-header p {
        margin: 0.25rem 0 0;
        color: #777;
        font-size: 0.9rem;
    }

    .btn-add {
        padding: 0.6rem 1rem;
        background: #7a1f2b;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
    }

    .schedule-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    .schedule-table th,
    .schedule-table td {
        padding: 0.75rem 0.9rem;
        border-bottom: 1px solid #e5e5e5;
        text-align: left;
        white-space: nowrap;
    }

    .schedule-table th {
        background: #f7f7f7;
        font-size: 0.85rem;
        font-weight: 600;
        color: #444;
    }

    .schedule-table td {
        font-size: 0.85rem;
    }

    .schedule-table tbody tr:hover {
        background: #fafafa;
    }

    .actions {
        display: flex;
        gap: 0.4rem;
    }

    .btn-edit,
    .btn-delete {
        padding: 0.4rem 0.7rem;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.8rem;
    }

    .btn-edit {
        background: #f0f0f0;
        border: 1px solid #ddd;
        color: #333;
    }

    .btn-delete {
        background: #7a1f2b;
        border: 1px solid #7a1f2b;
        color: white;
    }

    .empty-state {
        padding: 3rem;
        text-align: center;
        color: #777;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        background: white;
    }
</style>

@code {

    private IEnumerable<ClassScheduleDto> schedules =
        Enumerable.Empty<ClassScheduleDto>();

    protected override async Task OnInitializedAsync()
    {
        schedules = await ScheduleService.GetAllAsync();
    }

    private void EditSchedule(int id)
    {
        Navigation.NavigateTo($"/schedules/edit/{id}");
    }

    private async Task DeleteSchedule(int id)
    {
        await ScheduleService.DeleteAsync(id);

        schedules = await ScheduleService.GetAllAsync();
    }
}