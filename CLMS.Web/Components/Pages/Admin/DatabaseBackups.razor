@page "/admin/database-backups"
@attribute [Authorize(Policy = Privileges.Prefix + Privileges.BackupsView)]
@using CLMS.Infrastructure.DatabaseMaintenance
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Components.Authorization
@inject CLMS.Web.Services.ManualDatabaseBackups Backups
@inject AuthenticationStateProvider AuthenticationState
@inject IOptions<DatabaseBackupOptions> Settings
@inject ILogger<DatabaseBackups> Logger

<PageTitle>Database Backups | Labster</PageTitle>

<AuthorizeView Policy="@(Privileges.Prefix + Privileges.BackupsView)">
<Authorized>
<div class="space-y-5">
    <header class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold text-primary">Database Backup &amp; Restore</h1>
            <p class="mt-1 text-sm text-muted">@(Settings.Value.Enabled ? $"Daily backup at {Settings.Value.HourPhilippineTime:D2}:00 Philippine time (UTC+8) while the server is running." : "Scheduled backups are disabled.")</p>
            <p class="text-sm text-muted">Keeps the latest @Settings.Value.KeepLast regular backups and @Settings.Value.KeepLast recovery backups.</p>
        </div>
        <AuthorizeView Policy="@(Privileges.Prefix + Privileges.BackupsCreate)" Context="backupCreate"><button type="button" @onclick="CreateBackup" disabled="@Busy" class="rounded-lg bg-primary px-4 py-2 text-sm text-white disabled:opacity-50">Back up now</button></AuthorizeView>
    </header>

    @if (Message is not null)
    {
        <p role="status" class="rounded-lg border border-black/10 bg-surface p-3 text-sm">@Message</p>
    }
    @if (Error is not null)
    {
        <p role="alert" class="rounded-lg border border-black/10 p-3 text-sm text-primary">@Error</p>
    }
    @if (Busy)
    {
        <p role="status" class="text-sm text-muted">@Operation Please wait; keep this page open.</p>
    }

    <p class="text-sm text-muted">Restore during maintenance, with agents and other users disconnected. It replaces tables contained in the backup; tables added afterward remain. A recovery backup is created first. Restore is not transactional.</p>

    <div class="table-scroll overflow-x-auto rounded-lg border border-black/10">
        <table role="table" class="responsive-records data-table w-full text-left text-sm">
            <caption class="sr-only">Available database backups</caption>
            <thead class="bg-surface"><tr><th class="p-3">Created (PH time)</th><th class="p-3">Type</th><th class="p-3">Size <span class="row-actions-caption">Action</span></th></tr></thead>
            <tbody>
                @foreach (var backup in Items)
                {
                    RenderFragment rowActions = @<text>
                        <button type="button" disabled="@Busy" @onclick="() => SelectRestore(backup)" class="rounded-lg border border-black/10 px-3 py-2 disabled:opacity-50"><i aria-hidden="true" class="fa-solid fa-clock-rotate-left"></i> Restore</button>
                    </text>;
                    <tr role="row" class="border-t border-black/10" @key="backup.FileName">
                        <td role="cell" class="p-3" title="@backup.FileName">
                            <div class="row-identity">
                                <span class="record-identity">@backup.CreatedUtc.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </div>
                        </td>
                        <td role="cell" class="p-3" data-label="Type">@backup.Kind</td>
                        <td role="cell" class="p-3 row-end-cell" data-label="Size">
                          <AuthorizeView Policy="@(Privileges.Prefix + Privileges.BackupsRestore)" Context="actionAccess22">
                            <div class="row-end-content">
                              <div class="row-end-value">@((backup.Bytes / 1024d).ToString("N1")) KB</div>
                              <div class="row-end-actions"><span class="compact-row-menu"><ActionMenu Label="Backup actions">@rowActions</ActionMenu></span><span class="desktop-row-actions">@rowActions</span></div>
                            </div>
                          </AuthorizeView>
                        </td>
                    </tr>
                }
                @if (Items.Count == 0)
                {
                    <tr><td colspan="3" class="p-5 text-center text-muted">No backups available yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<Modal Show="@(Selected is not null)" Title="Restore database" OnClose="CloseRestore">
    <p class="text-sm">Restore the backup from @Selected?.CreatedUtc.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd HH:mm:ss") PH time? Current records in its tables will be replaced. Confirm that other users and agents have stopped writing to the database.</p>
    <label for="restore-confirmation" class="mt-4 block text-sm">Type RESTORE to confirm</label>
    <input id="restore-confirmation" @bind="Confirmation" @bind:event="oninput" autocomplete="off" class="mt-2 w-full rounded-lg border border-black/10 p-2" />
    <AuthorizeView Policy="@(Privileges.Prefix + Privileges.BackupsRestore)" Context="actionAccess23"><button type="button" @onclick="Restore" disabled="@(Busy || Confirmation != "RESTORE")" class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm text-white disabled:opacity-50">Restore database</button></AuthorizeView>
</Modal>
</Authorized>
<NotAuthorized><p role="alert">Administrator access is required to manage database backups.</p></NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<DatabaseBackup> Items = [];
    private DatabaseBackup? Selected;
    private string Confirmation = "";
    private bool Busy;
    private string Operation = "";
    private string? Message;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        try { Items = await Backups.ListAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Could not list database backups."); Error = "Could not read backups. Check the server's backup folder permissions."; }
    }

    private void SelectRestore(DatabaseBackup backup) { Selected = backup; Confirmation = ""; }
    private void CloseRestore() { if (!Busy) Selected = null; }

    private Task CreateBackup() => Run("Creating backup.", async () =>
    {
        var backup = await Backups.CreateAsync();
        return $"Backup created: {backup.FileName}";
    });

    private async Task Restore()
    {
        if (Selected is null || Confirmation != "RESTORE" || Busy) return;
        var fileName = Selected.FileName;
        Selected = null;
        await Run("Restoring database.", async () =>
        {
            var recovery = await Backups.RestoreAsync(fileName);
            return $"Restore completed. Recovery backup: {recovery.FileName}. Reload other open CLMS pages before continuing.";
        });
    }

    private async Task Run(string operation, Func<Task<string>> action)
    {
        if (Busy) return;
        Busy = true;
        Operation = operation;
        Message = Error = null;
        try { Message = await action(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Database maintenance operation failed.");
            Error = ex is InvalidOperationException ? ex.Message : "Database operation failed. Check server logs and backup folder permissions.";
        }
        finally { Busy = false; await RefreshList(); }
    }
}
