@using CLMS.Application.DTOs.Monitoring
@using CLMS.Shared.Dtos
@using CLMS.Web.Services
@using CLMS.Web.Services.AgentConnections
@implements IDisposable
@inject WorkstationCommandService Commands
@inject DialogService Dialogs
@inject ILogger<QuickControls> Logger

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="quick-commands" @onkeydown="HandleKeyDown">
            <button type="button" class="commands-trigger" @onclick="() => MenuOpen = !MenuOpen"
                    disabled="@(!Enabled || Busy || OnlineUnits.Count == 0)" aria-expanded="@MenuOpen" aria-controls="workstation-command-list"
                    title="@(OnlineUnits.Count == 0 ? "Select online workstations to use commands" : $"Commands for {OnlineUnits.Count} selected workstations")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h9m4 0h3M4 17h3m4 0h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>
                Commands
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            @if (MenuOpen)
            {
                <button type="button" class="commands-dismiss" @onclick="() => MenuOpen = false" aria-label="Close commands" tabindex="-1"></button>
                <div id="workstation-command-list" class="commands-menu" aria-label="Workstation commands">
                    <div class="commands-targets"><span>Quick controls</span><span class="commands-count">@OnlineUnits.Count selected</span></div>
                    <button type="button" @onclick="ComposeMessage"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-2 2v-9.5A8.5 8.5 0 0 1 10.5 4H13a8 8 0 0 1 8 7.5Z"/><path d="M7 10h9m-9 4h6"/></svg><span>Send message</span></button>
                    <button type="button" @onclick="() => RunAsync(WorkstationCommandKind.Lock)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4m-4 4v3"/></svg><span>Lock workstation</span></button>
                    <div class="commands-rule" aria-hidden="true"></div>
                    <button type="button" @onclick="() => RunAsync(WorkstationCommandKind.Restart)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 5v6h-6"/><path d="M20 11a8 8 0 1 0-2 7"/></svg><span>Restart</span></button>
                    <button type="button" class="power-command" @onclick="() => RunAsync(WorkstationCommandKind.Shutdown)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 2v10m-6-7a9 9 0 1 0 12 0"/></svg><span>Shut down</span></button>
                </div>
            }
            @if (Busy)
            {
                <span role="status" class="commands-progress">@Feedback</span>
                <button type="button" @onclick="Cancel" class="commands-feedback">Stop sending</button>
            }
            else if (Results.Count > 0)
            {
                <button type="button" @onclick="() => ShowResults = true" class="commands-feedback">Results (@Results.Count)</button>
            }
            <span class="sr-only" role="status">@Feedback</span>
        </div>

        <Modal Show="ShowMessage" Title="Send message" MaxWidthClass="max-w-md" OnClose="() => ShowMessage = false">
            <p class="mb-3 text-sm text-muted">Send a desktop notification to @MessageTargets.Count selected workstation(s).</p>
            <label class="block text-sm font-medium" for="quick-controls-message">Message</label>
            <textarea id="quick-controls-message" @bind="Message" @bind:event="oninput" maxlength="1000" rows="4"
                      class="mt-2 w-full rounded-lg border border-black/15 p-3 text-sm" placeholder="Enter a message"></textarea>
            <button type="button" disabled="@(Busy || string.IsNullOrWhiteSpace(Message))" @onclick="SendMessageAsync"
                    class="mt-3 rounded-lg bg-primary px-4 py-2 text-sm text-white disabled:opacity-50">Send message</button>
        </Modal>
        <Modal Show="ShowResults" Title="Command results" MaxWidthClass="max-w-lg" OnClose="() => ShowResults = false">
            <p class="mb-3 text-sm text-muted">@Feedback</p>
            @if (Results.Count > 0)
            {
                <ul class="space-y-3 text-sm" aria-label="Command results">
                    @foreach (var result in Results) { <li>@result</li> }
                </ul>
            }
        </Modal>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public IReadOnlyList<UnitMonitoringDTO> Units { get; set; } = [];
    [Parameter] public DateTime ObservedAtUtc { get; set; }
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    private readonly List<string> Results = [];
    private List<UnitMonitoringDTO> MessageTargets = [];
    private string Message = "";
    private string? Feedback;
    private bool Busy, Disposed;
    private bool MenuOpen, ShowMessage, ShowResults;
    private CancellationTokenSource? Batch;
    private object? Confirmation;
    private List<UnitMonitoringDTO> OnlineUnits => Units.Where(u => u.IsAvailableOnline(ObservedAtUtc)).ToList();

    protected override void OnParametersSet()
    {
        if (!Enabled) { MenuOpen = ShowMessage = false; Batch?.Cancel(); }
    }
    private void Cancel() => Batch?.Cancel();
    private void HandleKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") MenuOpen = false; }
    private void ComposeMessage()
    {
        if (Busy || !Enabled) return;
        MenuOpen = false;
        MessageTargets = OnlineUnits;
        ShowMessage = MessageTargets.Count > 0;
    }
    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(Message)) return;
        ShowMessage = false;
        await RunAsync(WorkstationCommandKind.SendMessage, MessageTargets);
    }

    private async Task RunAsync(WorkstationCommandKind kind, IReadOnlyList<UnitMonitoringDTO>? messageTargets = null)
    {
        MenuOpen = false;
        if (Busy || !Enabled) return;
        var targets = (messageTargets ?? OnlineUnits).ToList();
        if (targets.Count == 0) return;
        var message = kind == WorkstationCommandKind.SendMessage ? Message.Trim() : null;
        Busy = true;
        Batch = new CancellationTokenSource();
        var token = Batch.Token;
        try
        {
            await BusyChanged.InvokeAsync(true);
            if (kind is WorkstationCommandKind.Restart or WorkstationCommandKind.Shutdown)
            {
                var action = kind == WorkstationCommandKind.Restart ? "Restart" : "Shut down";
                var names = string.Join(", ", targets.Take(5).Select(u => $"{u.Name} ({u.Laboratory})"));
                if (targets.Count > 5) names += $", and {targets.Count - 5} more";
                var approval = Dialogs.ShowConfirmDialogAsync($"{action} {targets.Count} selected workstation(s): {names}? Ask users to save their work.", $"{action} selected workstations");
                Confirmation = Dialogs.CurrentRequest;
                if (!await approval
                    || Disposed || token.IsCancellationRequested) return;
                Confirmation = null;
            }
            Results.Clear();
            foreach (var unit in targets)
            {
                if (token.IsCancellationRequested) break;
                Feedback = $"Sending {Results.Count + 1} of {targets.Count}...";
                StateHasChanged();
                string result;
                try
                {
                    var status = await Commands.ExecuteAsync(unit.Id, kind, message, token);
                    result = status switch
                    {
                        WorkstationCommandStatus.MessageReceived => "Desktop notification submitted",
                        WorkstationCommandStatus.NotificationsDisabled => "Enable notifications in the workstation agent and OS settings",
                        WorkstationCommandStatus.Applied => "Lock accepted",
                        WorkstationCommandStatus.Requested => "OS request submitted; check completion",
                        WorkstationCommandStatus.Expired => "Expired",
                        WorkstationCommandStatus.Unsupported => "Update the workstation agent",
                        _ => "Failed; check workstation permissions"
                    };
                }
                catch (UnauthorizedAccessException) { Results.Add("Administrator access changed. Sign in again."); break; }
                catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { result = ex.Message; }
                catch (Exception ex)
                {
                    Logger.LogWarning("Quick control confirmation failed ({ExceptionType}).", ex.GetType().Name);
                    result = "No confirmation; check workstation before retrying";
                }
                Results.Add($"{unit.Name} ({unit.Laboratory}): {result}");
                if (!Disposed) StateHasChanged();
            }
            Feedback = token.IsCancellationRequested ? "Stopped sending. Commands already sent may still run."
                : "Finished. Review each workstation's result.";
        }
        finally
        {
            Busy = false;
            Batch.Dispose();
            Batch = null;
            if (!Disposed) await BusyChanged.InvokeAsync(false);
        }
    }

    public void Dispose()
    {
        Disposed = true;
        Batch?.Cancel();
        if (Confirmation is not null && ReferenceEquals(Confirmation, Dialogs.CurrentRequest)) Dialogs.Cancel();
    }
}
