@using CLMS.Web.Models
@using CLMS.Application.DTOs.Monitoring

<Modal Show="@(Unit is not null)" Title="@(Unit?.Name ?? "Unit details")" MaxWidthClass="max-w-3xl" OnClose="OnClose">
    @if (Unit is not null)
    {
    <div class="mb-5">
        <div class="flex items-center justify-between gap-3">
            <p class="text-sm text-muted">@Unit.Laboratory</p>
            <span class="rounded-full px-2.5 py-1 text-xs font-medium @Status.CssClass()">@Status.Label()</span>
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <section aria-labelledby="screen-preview-heading">
            <h3 id="screen-preview-heading" class="mb-3 text-sm font-semibold text-gray-800">Screen preview</h3>
            <UnitScreenView @key="Unit.Id" UnitId="Unit.Id" UnitName="@Unit.Name" Online="@(Status != UnitMonitoringStatus.Offline)" />
        </section>

        <section aria-labelledby="connection-heading">
            <h3 id="connection-heading" class="mb-3 text-sm font-semibold text-gray-800">Connection &amp; session</h3>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-3"><dt class="text-muted">Unit number</dt><dd class="font-medium text-gray-800">@Unit.Number.ToString("D2")</dd></div>
                <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Last IP address</dt><dd class="min-w-0 break-all text-right text-gray-600">@(Unit.IpAddress ?? "Not reported")</dd></div>
                <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Last heartbeat</dt><dd class="text-right text-gray-600">@UnitMonitoringDisplay.FormatUtc(Unit.LastHeartbeatUtc)</dd></div>
                @if (ShowSession)
                {
                    <div class="flex justify-between gap-3">
                        <dt class="shrink-0 text-muted">@(Session is not null && Status == UnitMonitoringStatus.Offline ? "Last reported CLMS user" : "Current CLMS user")</dt>
                        <dd class="min-w-0 break-words text-right text-gray-600">@(SessionsAvailable ? Session?.UserName ?? "No active session" : "Unavailable")</dd>
                    </div>
                    @if (Session is not null)
                    {
                        <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Session started</dt><dd class="text-right text-gray-600">@UnitMonitoringDisplay.FormatUtc(Session.StartedUtc)</dd></div>
                    }
                }
            </dl>
        </section>

        <section aria-labelledby="resources-heading">
            <h3 id="resources-heading" class="mb-3 text-sm font-semibold text-gray-800">System resources</h3>
            <div class="grid grid-cols-3 gap-2 text-center">
                @foreach (var resource in new[] { "CPU", "Memory", "Disk" })
                {
                    <div class="rounded-lg bg-surface px-2 py-3">
                        <p class="text-xs text-muted">@resource</p>
                        <p class="mt-1 text-lg text-gray-500" aria-label="@(resource + " data unavailable")">—</p>
                    </div>
                }
            </div>
            <p class="mt-2 text-xs text-muted">CPU, memory, and disk readings are not connected yet.</p>
            <div class="mt-3 rounded-lg bg-surface px-3 py-3">
                <p class="text-xs text-muted">Network</p>
                @if (HasFreshNetworkReading)
                {
                    <dl class="mt-2 space-y-1 text-sm">
                        <div class="flex justify-between gap-3"><dt class="text-muted">Download</dt><dd>@UnitMonitoringDisplay.FormatNetworkRate(Unit.NetworkResources!.DownloadBytesPerSecond)</dd></div>
                        <div class="flex justify-between gap-3"><dt class="text-muted">Upload</dt><dd>@UnitMonitoringDisplay.FormatNetworkRate(Unit.NetworkResources!.UploadBytesPerSecond)</dd></div>
                    </dl>
                    <p class="mt-2 text-xs text-muted">Average traffic across active adapters. Updated every 15 seconds.</p>
                }
                else
                {
                    <p class="mt-1 text-sm text-muted">Network readings unavailable.</p>
                }
            </div>
        </section>

        <section aria-labelledby="controls-heading">
            <h3 id="controls-heading" class="sr-only">Unit controls</h3>
            <WorkstationActions UnitId="@Unit.Id" UnitName="@Unit.Name" Online="@(Status != UnitMonitoringStatus.Offline)" />
        </section>
    </div>
    }
</Modal>

@code {
    [Parameter] public UnitMonitoringDTO? Unit { get; set; }
    [Parameter] public DateTime ObservedAtUtc { get; set; }
    [Parameter] public WorkstationSession? Session { get; set; }
    [Parameter] public bool ShowSession { get; set; }
    [Parameter] public bool SessionsAvailable { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private UnitMonitoringStatus Status => Unit?.GetStatus(ObservedAtUtc) ?? UnitMonitoringStatus.Offline;
    private bool HasFreshNetworkReading => Status != UnitMonitoringStatus.Offline
        && Unit?.NetworkResources is { IsValid: true } && Unit.NetworkResourcesUtc.HasValue
        && Unit.NetworkResourcesUtc.Value >= ObservedAtUtc.AddSeconds(-45);
}
