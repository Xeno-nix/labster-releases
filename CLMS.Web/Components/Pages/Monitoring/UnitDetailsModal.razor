@using CLMS.Web.Models
@using CLMS.Application.DTOs.Monitoring

<Modal Show="@(Unit is not null)" Title="@(Unit?.Name ?? "Unit details")" MaxWidthClass="max-w-3xl" OnClose="OnClose">
    @if (Unit is not null)
    {
    <div class="mb-5">
        <div class="flex items-center justify-between gap-3">
            <p class="text-sm text-muted">@Unit.Laboratory</p>
            <span class="rounded-full px-2.5 py-1 text-xs font-medium @Status.CssClass()">@Status.Label()</span>
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <section aria-labelledby="screen-preview-heading">
            <h3 id="screen-preview-heading" class="mb-3 text-sm font-semibold text-gray-800">Screen preview</h3>
            <div class="flex aspect-video flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-black/15 bg-surface p-4 text-center">
                <svg class="text-muted" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="13" rx="2" /><path d="M8 21h8m-4-5v5" />
                </svg>
                <p class="text-sm text-muted">No screen feed connected</p>
                <p class="text-xs text-muted">Screen monitoring will appear here.</p>
            </div>
        </section>

        <section aria-labelledby="connection-heading">
            <h3 id="connection-heading" class="mb-3 text-sm font-semibold text-gray-800">Connection &amp; session</h3>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between gap-3"><dt class="text-muted">Unit number</dt><dd class="font-medium text-gray-800">@Unit.Number.ToString("D2")</dd></div>
                <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Serial number</dt><dd class="min-w-0 break-words text-right text-gray-600">@(Unit.SerialNumber ?? "Not assigned")</dd></div>
                <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Last IP address</dt><dd class="min-w-0 break-all text-right text-gray-600">@(Unit.IpAddress ?? "Not reported")</dd></div>
                <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Last heartbeat</dt><dd class="text-right text-gray-600">@UnitMonitoringDisplay.FormatUtc(Unit.LastHeartbeatUtc)</dd></div>
                <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Session user</dt><dd class="min-w-0 break-words text-right text-gray-600">@(Unit.CurrentUser ?? "Not identified")</dd></div>
                <div class="flex justify-between gap-3"><dt class="shrink-0 text-muted">Open session since</dt><dd class="text-right text-gray-600">@(Unit.SessionStartedUtc.HasValue ? UnitMonitoringDisplay.FormatUtc(Unit.SessionStartedUtc) : "No open session")</dd></div>
            </dl>
            @if (Unit.SessionStartedUtc.HasValue && Status == UnitMonitoringStatus.Offline)
            {
                <p class="mt-3 text-xs text-muted">An open session is recorded, but the unit has no fresh online signal.</p>
            }
        </section>

        <section aria-labelledby="resources-heading">
            <h3 id="resources-heading" class="mb-3 text-sm font-semibold text-gray-800">System resources</h3>
            <div class="grid grid-cols-3 gap-2 text-center">
                @foreach (var resource in new[] { "CPU", "Memory", "Disk" })
                {
                    <div class="rounded-lg bg-surface px-2 py-3">
                        <p class="text-xs text-muted">@resource</p>
                        <p class="mt-1 text-lg text-gray-500" aria-label="@(resource + " data unavailable")">—</p>
                    </div>
                }
            </div>
            <p class="mt-2 text-xs text-muted">Resource readings are not connected yet.</p>
        </section>

        <section aria-labelledby="controls-heading">
            <h3 id="controls-heading" class="mb-3 text-sm font-semibold text-gray-800">Unit controls</h3>
            <div class="grid grid-cols-2 gap-2">
                <button type="button" disabled aria-describedby="controls-description" class="cursor-not-allowed rounded-lg border border-black/10 bg-surface px-3 py-2 text-sm text-gray-500">View screen</button>
                <button type="button" disabled aria-describedby="controls-description" class="cursor-not-allowed rounded-lg border border-black/10 bg-surface px-3 py-2 text-sm text-gray-500">Send message</button>
            </div>
            <p id="controls-description" class="mt-2 text-xs text-muted">Remote actions are not available yet.</p>
        </section>
    </div>
    }
</Modal>

@code {
    [Parameter] public UnitMonitoringDTO? Unit { get; set; }
    [Parameter] public DateTime ObservedAtUtc { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private UnitMonitoringStatus Status => Unit?.GetStatus(ObservedAtUtc) ?? UnitMonitoringStatus.Offline;
}
