@using Microsoft.AspNetCore.Components.Authorization

<nav class="mb-4 flex shrink-0 gap-2 border-b border-black/10 pb-3" aria-label="Monitoring views">
    <a href="/unit-monitoring" aria-current="@(!Abnormal ? "page" : null)" class="rounded-lg px-4 py-2 text-sm @(!Abnormal ? "bg-primary text-white" : "text-primary hover:bg-surface")">Units</a>
    <AuthorizeView Roles="Admin,Faculty">
        <a href="/unit-monitoring/activities" aria-current="@(Abnormal ? "page" : null)" class="rounded-lg px-4 py-2 text-sm @(Abnormal ? "bg-primary text-white" : "text-primary hover:bg-surface")">Abnormal Activity</a>
    </AuthorizeView>
</nav>

@code { [Parameter] public bool Abnormal { get; set; } }
