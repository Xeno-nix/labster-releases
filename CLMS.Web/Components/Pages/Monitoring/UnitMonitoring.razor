@using CLMS.Web.Models
@using CLMS.Application.DTOs.Monitoring
@using CLMS.Application.Identity.Interfaces
@using CLMS.Infrastructure.Repositories
@using CLMS.Application.DTOs.Booking
@inject CLMS.Application.Services.LaboratoryService LaboratoryService
@inherits MonitoringPageBase
@inject ICurrentUser CurrentUser
@inject WorkstationSessionRepository WorkstationSessions

<PageTitle>Unit Monitoring | CLMS</PageTitle>

<div class="monitoring-page">
    <header class="flex shrink-0 flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="mb-1 text-2xl text-primary">Unit Monitoring</h1>
            <p class="text-xs text-muted" role="status">
                @if (LastUpdatedUtc.HasValue)
                {
                    <span>Last loaded @UnitMonitoringDisplay.FormatUtc(LastUpdatedUtc)</span>
                }
                else if (Loading)
                {
                    <span>Loading workstations…</span>
                }
            </p>
        </div>
        <ActionMenu Horizontal="true" Label="Unit monitoring options">
            <a href="@ScreensUrl" target="_blank" rel="noopener noreferrer" aria-label="View all screens (opens in a new tab)">View all screens</a>
            @if (CanViewSessions)
            {
                <a href="/unit-monitoring/sessions">Session history</a>
            }
            <button type="button" disabled="@(SelectedLabId is null)" @onclick="() => ShowSummary = true">Workstation summary</button>
            <details class="view-options">
                <summary>View</summary>
                <button type="button" aria-pressed="@(!ListView ? "true" : "false")" @onclick="() => ListView = false">Grid</button>
                <button type="button" aria-pressed="@(ListView ? "true" : "false")" @onclick="() => ListView = true">List</button>
            </details>
        </ActionMenu>
    </header>

    @if (Error is not null)
    {
        <p role="alert" class="shrink-0 rounded-lg border border-error/20 bg-error/5 px-4 py-3 text-sm text-error">@Error</p>
    }

    @if (Laboratories.Count > 0)
    {
        <nav class="lab-tabs tab-strip segmented-tabs" aria-label="Laboratories">
            @foreach (var lab in Laboratories)
            {
                <button type="button" @key="lab.Id" aria-pressed="@(SelectedLabId == lab.Id ? "true" : "false")"
                        @onclick="() => SelectLab(lab.Id)">@lab.Name</button>
            }
        </nav>
    }
    <div class="monitoring-toolbar">
        <label for="monitoring-search" class="search-label">Search</label>
        <div class="search-control">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
            </svg>
            <input id="monitoring-search" type="search" @bind="Search" @bind:event="oninput"
                   aria-label="Search by PC name or unit number" placeholder="Search by PC name or unit number"
                   class="w-full pl-10 pr-4 py-2 border border-black/10 rounded-lg bg-surface text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
        </div>
        <label class="filter-control">Filter
            <select @bind="Status" class="rounded-lg border border-black/10 bg-white px-3 py-2 text-sm">
                <option>All</option>
                <option>Online</option>
                <option>Offline</option>
            </select>
        </label>
        <button type="button" @onclick="LoadAsync" disabled="@Loading"
                class="refresh-button rounded-lg border border-black/10 bg-white px-4 py-2 text-sm text-primary disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-primary">
            @(Loading ? "Refreshing…" : "Refresh")
        </button>
    </div>

    @if (LastUpdatedUtc.HasValue)
    {
        <section class="workstations-section" aria-label="Workstations">
            <p class="shrink-0 text-xs text-muted" role="status">Showing @VisibleUnits.Count of @LaboratoryUnits.Count workstations</p>
            <div class="pc-card-scroll" tabindex="0" role="region" aria-label="Scrollable workstations">

            @if (VisibleUnits.Count == 0)
            {
                <div class="rounded-lg border border-dashed border-black/15 bg-white px-5 py-12 text-center">
                    <h3 class="text-sm font-semibold text-gray-800">@(Laboratories.Count == 0 ? "No laboratories registered" : LaboratoryUnits.Count == 0 ? "No registered workstations in this laboratory" : "No matching workstations")</h3>
                    @if (LaboratoryUnits.Count > 0)
                    {
                        <p class="mt-1 text-sm text-muted">Try another PC name, unit number, or status.</p>
                        <button type="button" @onclick="ClearFilters" class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Clear filters</button>
                    }
                    else
                    {
                        <p class="mt-1 text-sm text-muted">Workstations will appear here once they have been registered.</p>
                    }
                </div>
            }
            else
            {
                <div class="@(ListView ? "pc-list" : "pc-grid")">
                    @foreach (var unit in VisibleUnits)
                    {
                        <UnitMonitorCard @key="unit.Id" Unit="unit" ObservedAtUtc="ObservedAtUtc"
                                         ListView="ListView" OnSelect="SelectUnit" />
                    }
                </div>
            }
            </div>
        </section>
    }
</div>

<UnitDetailsModal Unit="SelectedUnit" ObservedAtUtc="ObservedAtUtc" OnClose="CloseDetails"
                  Session="@(SelectedUnit is null ? null : ActiveSessions.GetValueOrDefault(SelectedUnit.Id))"
                  ShowSession="CanViewSessions" SessionsAvailable="SessionsAvailable" />
<UnitSummaryModal Show="ShowSummary" Units="LaboratoryUnits" ObservedAtUtc="ObservedAtUtc"
                  LaboratoryName="@(Laboratories.FirstOrDefault(l => l.Id == SelectedLabId)?.Name ?? string.Empty)"
                  OnClose="() => ShowSummary = false" />

@code {
    [SupplyParameterFromQuery(Name = "lab")] public int? LabId { get; set; }
    private bool ShowSummary;
    private bool ListView;
    private string ScreensUrl => SelectedLabId is int id ? $"/unit-monitoring/screens?lab={id}" : "/unit-monitoring/screens";
    private int? SelectedLabId;
    private int? previousQueryLab;
    private List<LaboratoryDTO> Laboratories = [];
    private string Search { get; set; } = "";
    private string Status { get; set; } = "All";
    private UnitMonitoringDTO? SelectedUnit { get; set; }
    private bool CanViewSessions;
    private bool SessionsAvailable;
    private IReadOnlyDictionary<Guid, WorkstationSession> ActiveSessions = new Dictionary<Guid, WorkstationSession>();

    protected override async Task RefreshDetailsAsync(CancellationToken cancellationToken)
    {
        Laboratories = (await LaboratoryService.GetAllAsync()).OrderBy(lab => lab.Name).ThenBy(lab => lab.Id).ToList();
        CanViewSessions = false;
        SessionsAvailable = false;
        ActiveSessions = new Dictionary<Guid, WorkstationSession>();
        try
        {
            await CurrentUser.RequireAdminAsync();
            CanViewSessions = true;
            ActiveSessions = await WorkstationSessions.GetActiveAsync(cancellationToken);
            SessionsAvailable = true;
        }
        catch (UnauthorizedAccessException) { }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception ex)
        {
            Logger.LogWarning("Could not load active workstation sessions ({ErrorType}).", ex.GetType().Name);
        }
    }

    private List<UnitMonitoringDTO> LaboratoryUnits => Units
        .Where(u => u.LaboratoryId == SelectedLabId).OrderBy(u => u.Number).ToList();

    private List<UnitMonitoringDTO> VisibleUnits => LaboratoryUnits
        .Where(u => Status == "All" || u.GetStatus(ObservedAtUtc).Label() == Status)
        .Where(u => string.IsNullOrWhiteSpace(Search)
            || u.Name.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)
            || u.Number.ToString("D2").Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override void OnParametersSet()
    {
        if (LabId == previousQueryLab) return;
        previousQueryLab = LabId;
        SelectLab(LabId);
        OnDataUpdated();
    }

    protected override void OnDataUpdated()
    {
        if (!Laboratories.Any(lab => lab.Id == SelectedLabId))
            SelectLab(Laboratories.FirstOrDefault(lab => lab.Id == LabId)?.Id ?? Laboratories.FirstOrDefault()?.Id);

        if (SelectedUnit is not null)
            SelectedUnit = Units.FirstOrDefault(unit => unit.Id == SelectedUnit.Id && unit.LaboratoryId == SelectedLabId);
    }

    private void SelectLab(int? id)
    {
        if (id == SelectedLabId) return;
        SelectedLabId = id;
        Search = "";
        SelectedUnit = null;
        ShowSummary = false;
    }

    private void SelectUnit(UnitMonitoringDTO unit)
    {
        SelectedUnit = unit;
    }

    private void CloseDetails() => SelectedUnit = null;

    private void ClearFilters()
    {
        Search = "";
        Status = "All";
    }
}
