@using CLMS.Web.Models
@using CLMS.Application.DTOs.Monitoring
@using CLMS.Application.Identity.Interfaces
@using CLMS.Infrastructure.Repositories
@inherits MonitoringPageBase
@inject ICurrentUser CurrentUser
@inject WorkstationSessionRepository WorkstationSessions

<PageTitle>Unit Monitoring | CLMS</PageTitle>

<div class="monitoring-page">
    <header class="flex shrink-0 flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="mb-1 text-2xl text-primary">Unit Monitoring</h1>
            <p class="text-xs text-muted" role="status">
                @if (LastUpdatedUtc.HasValue)
                {
                    <span>Last loaded @UnitMonitoringDisplay.FormatUtc(LastUpdatedUtc). Updates every 5 seconds.</span>
                }
                else if (Loading)
                {
                    <span>Loading workstations…</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
        @if (CanViewSessions)
        {
            <a href="/unit-monitoring/sessions" class="rounded-lg border border-black/10 bg-white px-4 py-2 text-sm text-primary">Session history</a>
        }
        <button type="button" @onclick="() => ShowSummary = true" disabled="@(!LastUpdatedUtc.HasValue)"
                aria-label="View workstation summary" aria-haspopup="dialog" title="Workstation summary"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-black/10 text-sm font-semibold text-primary hover:bg-surface disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-primary">?</button>
        <a href="@ScreensUrl" target="_blank" rel="noopener noreferrer" title="Open all screens in a new tab"
           aria-label="View all screens (opens in a new tab)"
           class="rounded-lg bg-primary px-4 py-2 text-sm text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">View all screens</a>
        <button type="button" @onclick="LoadAsync" disabled="@Loading"
                class="rounded-lg border border-black/10 bg-white px-4 py-2 text-sm text-primary disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-primary">
            @(Loading ? "Refreshing…" : "Refresh")
        </button>
        </div>
    </header>

    @if (Error is not null)
    {
        <p role="alert" class="shrink-0 rounded-lg border border-error/20 bg-error/5 px-4 py-3 text-sm text-error">@Error</p>
    }

    @if (LastUpdatedUtc.HasValue)
    {
    <div class="monitoring-toolbar">
        <div class="laboratory-control">
            <label for="monitoring-laboratory" class="mb-1.5 block text-sm font-medium text-gray-700">Laboratory</label>
            <select id="monitoring-laboratory" @bind="Laboratory" @bind:after="UpdateSelection"
                    class="w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-primary">
                <option value="">All laboratories</option>
                @foreach (var laboratory in Units.GroupBy(u => u.LaboratoryId).Select(g => g.First()))
                {
                    <option value="@laboratory.LaboratoryId">@laboratory.Laboratory</option>
                }
            </select>
        </div>
        <div class="search-control">
            <label for="monitoring-search" class="mb-1.5 block text-sm font-medium text-gray-700">Find a workstation</label>
            <input id="monitoring-search" type="search" @bind="Search" @bind:event="oninput" @bind:after="UpdateSelection"
                   placeholder="Search by PC name or unit number"
                   class="w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-primary" />
        </div>
        <div class="status-filters" role="group" aria-label="Filter by unit status">
                    @foreach (var filter in new[] { "All", "Online", "Offline" })
                    {
                        <button type="button" @onclick="() => SetStatus(filter)" aria-pressed="@(Status == filter)"
                                class="rounded-lg px-3 py-2 text-xs font-medium focus-visible:outline-2 focus-visible:outline-primary @(Status == filter ? "bg-primary text-white" : "bg-white text-gray-600 hover:bg-surface")">@filter</button>
                    }
                </div>
    </div>

        <section class="workstations-section" aria-label="Workstations">
            <p class="shrink-0 text-xs text-muted" role="status">Showing @VisibleUnits.Count of @LaboratoryUnits.Count workstations</p>
            <div class="pc-card-scroll pc-grid-container" tabindex="0" role="region" aria-label="Scrollable workstation cards">

            @if (VisibleUnits.Count == 0)
            {
                <div class="rounded-lg border border-dashed border-black/15 bg-white px-5 py-12 text-center">
                    <h3 class="text-sm font-semibold text-gray-800">@(Units.Count == 0 ? "No registered workstations" : "No matching workstations")</h3>
                    @if (Units.Count > 0)
                    {
                        <p class="mt-1 text-sm text-muted">Try another PC name, laboratory, or status.</p>
                        <button type="button" @onclick="ClearFilters" class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Clear filters</button>
                    }
                    else
                    {
                        <p class="mt-1 text-sm text-muted">Workstations will appear here once they have been registered.</p>
                    }
                </div>
            }
            else
            {
                <div class="pc-grid">
                    @foreach (var unit in VisibleUnits)
                    {
                        <UnitMonitorCard @key="unit.Id" Unit="unit" ObservedAtUtc="ObservedAtUtc"
                                         Session="ActiveSessions.GetValueOrDefault(unit.Id)" ShowSession="CanViewSessions"
                                         SessionsAvailable="SessionsAvailable" Selected="@(SelectedUnit?.Id == unit.Id)" OnSelect="SelectUnit" />
                    }
                </div>
            }
            </div>
        </section>
    }
</div>

<UnitDetailsModal Unit="SelectedUnit" ObservedAtUtc="ObservedAtUtc" OnClose="CloseDetails"
                  Session="@(SelectedUnit is null ? null : ActiveSessions.GetValueOrDefault(SelectedUnit.Id))"
                  ShowSession="CanViewSessions" SessionsAvailable="SessionsAvailable" />
<UnitSummaryModal Show="ShowSummary" Units="LaboratoryUnits" ObservedAtUtc="ObservedAtUtc"
                  LaboratoryName="@(LaboratoryUnits.FirstOrDefault()?.Laboratory is string name && Laboratory.Length > 0 ? name : "All laboratories")"
                  OnClose="() => ShowSummary = false" />

@code {
    [SupplyParameterFromQuery(Name = "lab")] public int? LabId { get; set; }
    private bool ShowSummary;
    private string ScreensUrl => Laboratory.Length == 0 ? "/unit-monitoring/screens" : $"/unit-monitoring/screens?lab={Laboratory}";
    private string Laboratory { get; set; } = "";
    private string Search { get; set; } = "";
    private string Status { get; set; } = "All";
    private UnitMonitoringDTO? SelectedUnit { get; set; }
    private bool CanViewSessions;
    private bool SessionsAvailable;
    private IReadOnlyDictionary<Guid, WorkstationSession> ActiveSessions = new Dictionary<Guid, WorkstationSession>();

    protected override async Task RefreshDetailsAsync(CancellationToken cancellationToken)
    {
        CanViewSessions = false;
        SessionsAvailable = false;
        ActiveSessions = new Dictionary<Guid, WorkstationSession>();
        try
        {
            await CurrentUser.RequireAdminAsync();
            CanViewSessions = true;
            ActiveSessions = await WorkstationSessions.GetActiveAsync(cancellationToken);
            SessionsAvailable = true;
        }
        catch (UnauthorizedAccessException) { }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception ex)
        {
            Logger.LogWarning("Could not load active workstation sessions ({ErrorType}).", ex.GetType().Name);
        }
    }

    private List<UnitMonitoringDTO> LaboratoryUnits => Units
        .Where(u => Laboratory.Length == 0 || u.LaboratoryId.ToString() == Laboratory).ToList();

    private List<UnitMonitoringDTO> VisibleUnits => LaboratoryUnits
        .Where(u => Status == "All" || u.GetStatus(ObservedAtUtc).Label() == Status)
        .Where(u => string.IsNullOrWhiteSpace(Search)
            || u.Name.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase)
            || u.Number.ToString("D2").Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override void OnParametersSet() => Laboratory = LabId?.ToString() ?? "";

    protected override void OnDataUpdated()
    {
        if (Laboratory.Length > 0 && !Units.Any(u => u.LaboratoryId.ToString() == Laboratory))
            Laboratory = "";
        UpdateSelection();
    }

    private void SelectUnit(UnitMonitoringDTO unit)
    {
        SelectedUnit = unit;
    }

    private void CloseDetails() => SelectedUnit = null;

    private void SetStatus(string status)
    {
        Status = status;
        UpdateSelection();
    }

    private void UpdateSelection()
    {
        var visible = VisibleUnits;
        SelectedUnit = visible.FirstOrDefault(u => u.Id == SelectedUnit?.Id);
    }

    private void ClearFilters()
    {
        Laboratory = Search = "";
        Status = "All";
        UpdateSelection();
    }

}
