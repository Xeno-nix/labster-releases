@using CLMS.Web.Models
@using CLMS.Application.DTOs.Monitoring

<button type="button" class="unit-tile @(ListView ? "unit-row" : null) @(Offline ? "offline" : "online")" aria-haspopup="dialog"
        aria-label="@($"View details for Unit {Unit.Number:D2}, {Unit.Laboratory}, {Unit.GetStatus(ObservedAtUtc).Label()}")"
        title="View unit details" @onclick="() => OnSelect.InvokeAsync(Unit)">
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="13" rx="2" />
        <path d="M8 21h8m-4-5v5" />
        @if (Offline)
        {
            <path d="M2 2l20 20" />
        }
    </svg>
    <span>Unit @Unit.Number.ToString("D2")</span>
    @if (ListView)
    {
        <span class="pc-name">@Unit.Name</span>
        <span class="presence">@Unit.GetStatus(ObservedAtUtc).Label()</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public UnitMonitoringDTO Unit { get; set; } = default!;
    [Parameter] public bool ListView { get; set; }
    [Parameter] public DateTime ObservedAtUtc { get; set; }
    [Parameter] public EventCallback<UnitMonitoringDTO> OnSelect { get; set; }
    private bool Offline => Unit.GetStatus(ObservedAtUtc) == UnitMonitoringStatus.Offline;
}
