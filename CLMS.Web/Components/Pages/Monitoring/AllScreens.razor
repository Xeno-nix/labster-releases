@page "/unit-monitoring/screens"
@layout ScreenWallLayout
@attribute [Authorize(Policy = Privileges.Prefix + Privileges.MonitoringLabScreens)]
@inherits MonitoringPageBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject CLMS.Web.Services.ScreenCasting.LabScreenCastService LabScreenCasts
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@using CLMS.Application.DTOs.Monitoring
@using CLMS.Web.Models

<PageTitle>All Screens | CLMS</PageTitle>

<div class="screen-wall-page flex h-full flex-col">
    <header class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-b border-white/10 px-4 py-3">
        <div>
            <h1 class="text-lg font-semibold">Lab screen-cast session</h1>
            <p class="text-xs text-gray-400">Select a lab and start a session. Live previews run for the PCs on the current page.</p>
            <p class="text-xs text-gray-400" role="status">
                @if (LastUpdatedUtc.HasValue)
                {
                    <span>@VisibleUnits.Count workstations<span class="subtitle-divider">·</span>@VisibleUnits.Count(u => u.IsAvailableOnline(ObservedAtUtc)) online</span>
                }
                else if (Loading)
                {
                    <span>Loading workstations…</span>
                }
            </p>
            </div>
        </div>
        <div class="monitor-utilities">
            <span class="session-badge @(LabSessionId.HasValue ? "session-active" : "")"><span></span>@(LabSessionId.HasValue ? "Monitoring live" : "Not monitoring")</span>
            <CLMS.Web.Components.Notification.DesktopNotificationCenter Compact="true" />
            <button type="button" @onclick="LoadAsync" disabled="@Loading" class="monitor-icon-button" aria-label="Refresh workstations" title="Refresh workstations">
                <svg class="@(Loading ? "refresh-spinning" : "")" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.1 6a8 8 0 0 1 13.7 5M4.2 13A8 8 0 0 0 18 18"/></svg>
            </button>
        </div>
        </div>
        <div class="screen-toolbar">
          <div class="screen-monitor-controls" role="group" aria-label="Workstation monitoring">
            <label for="screen-wall-laboratory">Laboratory</label>
            <select id="screen-wall-laboratory" @bind="Laboratory" @bind:after="ChangeLaboratory"
                    disabled="@(LabSessionId.HasValue || SessionBusy || SharingActive)"
                    class="monitor-lab-select">
                <option value="">Select a laboratory</option>
                @foreach (var laboratory in Units.GroupBy(u => u.LaboratoryId).Select(g => g.First()))
                {
                    <option value="@laboratory.LaboratoryId">@laboratory.Laboratory</option>
                }
            </select>
            @if (LabSessionId.HasValue)
            {
                <button type="button" @onclick="EndLabSessionAsync" disabled="@SessionBusy" class="monitor-session-button session-end"><span class="stop-square" aria-hidden="true"></span>End session</button>
            }
            else
            {
                <button type="button" @onclick="StartLabSessionAsync" disabled="@(SessionBusy || Loading || Laboratory.Length == 0)" class="monitor-session-button"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 4 12 8-12 8z"/></svg>Start session</button>
            }
          </div>
          <div class="screen-toolbar-actions">
            <AuthorizeView Roles="Admin">
                <Authorized Context="commandUser">
                    <button type="button" @onclick="ToggleSelectionMode" disabled="@(!LabSessionId.HasValue || CommandsBusy)"
                            aria-pressed="@SelectionMode" class="screen-select-button @(SelectionMode ? "is-selecting" : "")">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="m7 12 3 3 7-7"/></svg>
                        Select units
                    </button>
                    <QuickControls @key="LabSessionId" Units="SelectedOnlineUnits" ObservedAtUtc="ObservedAtUtc"
                                   Enabled="@(LabSessionId.HasValue && !SessionBusy)" BusyChanged="SetCommandsBusy" />
                </Authorized>
            </AuthorizeView>
            <span class="toolbar-divider" aria-hidden="true"></span>
            <FacultyLiveStream Light="true" LaboratoryName="@(Units.FirstOrDefault(u => u.LaboratoryId.ToString() == Laboratory)?.Laboratory)"
                               MonitoringSessionId="@LabSessionId"
                               SharingChanged="@((bool active) => SharingActive = active)" />
          </div>
        </div>
    </header>

    <AuthorizeView Roles="Admin">
        <Authorized Context="selectionUser">
            @if (SelectionMode)
            {
                <div class="screen-selection-bar">
                    <div class="selection-summary"><span class="selection-count">@SelectedUnits.Count</span><span>workstation@(SelectedUnits.Count == 1 ? "" : "s") selected</span><span class="selection-hint">Choose a command above</span></div>
                    <div class="selection-actions">
                        <button type="button" @onclick="SelectOnlineUnits" disabled="@CommandsBusy">Select all online</button>
                        <button type="button" @onclick="() => SelectedUnits.Clear()" disabled="@(CommandsBusy || SelectedUnits.Count == 0)">Clear</button>
                        <button type="button" @onclick="ToggleSelectionMode" disabled="@CommandsBusy" class="selection-done">Done</button>
                    </div>
                </div>
            }
        </Authorized>
    </AuthorizeView>

    @if (Error is not null)
    {
        <p role="alert" class="monitor-error">@Error</p>
    }
    @if (!LabSessionId.HasValue && SessionMessage != "No screen-cast session is active.")
    {
        <p role="status" class="monitor-session-message">@SessionMessage</p>
    }
    <div class="screen-wall-area" @ref="WallArea">
    @if (!LabSessionId.HasValue)
    {
        <div class="screen-empty">
            <span class="screen-empty-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="3" width="18" height="13" rx="2"/><path d="M8 21h8m-4-5v5"/></svg></span>
            <h2>Start monitoring your laboratory</h2>
            <p>Choose a laboratory and start a session to see workstation screens.</p>
        </div>
    }
    else if (LastUpdatedUtc.HasValue && VisibleUnits.Count == 0)
    {
        <div class="screen-empty"><h2>No workstations yet</h2><p>Registered workstations in this laboratory will appear here.</p></div>
    }
    else if (VisibleUnits.Count > 0)
    {
        <div class="screen-wall" aria-label="All workstation screens">
            @foreach (var unit in PageUnits)
            {
                <div @key="(unit.Id, LabSessionId)"
                     class="screen-tile min-h-0 min-w-0 overflow-hidden @(SelectedUnits.Contains(unit.Id) ? "screen-tile-selected" : "")">
                    <UnitScreenView UnitId="unit.Id" UnitName="@unit.Name" Compact="true" LightChrome="true" AutoStart="true"
                                    LabSessionId="LabSessionId"
                                    Online="@(unit.GetStatus(ObservedAtUtc) != UnitMonitoringStatus.Offline)" />
                    <AuthorizeView Roles="Admin">
                        <Authorized Context="tileUser">
                            @if (SelectionMode)
                            {
                                <label class="screen-unit-select">
                                    <input type="checkbox" checked="@SelectedUnits.Contains(unit.Id)"
                                           disabled="@(CommandsBusy || !unit.IsAvailableOnline(ObservedAtUtc))"
                                           @onchange="e => SelectUnit(unit.Id, e.Value is true)" />
                                    <span aria-hidden="true">@(SelectedUnits.Contains(unit.Id) ? "Selected" : "Select")</span>
                                    <span class="sr-only">Select @unit.Name for commands</span>
                                </label>
                            }
                        </Authorized>
                    </AuthorizeView>
                </div>
            }
        </div>
    }
    </div>
    <nav class="screen-pagination" aria-label="Screen pages">
        <button type="button" @onclick="() => CurrentPage--" disabled="@(CurrentPage <= 1)">Previous</button>
        <span role="status"><strong>@CurrentPage</strong> / @PageCount</span>
        <button type="button" @onclick="() => CurrentPage++" disabled="@(CurrentPage >= PageCount)">Next</button>
    </nav>
</div>

@code {
    [SupplyParameterFromQuery(Name = "lab")] public int? LabId { get; set; }
    private string Laboratory = "";
    private bool SharingActive;
    private int? LabSessionId;
    private bool SessionBusy;
    private bool SessionDisposed;
    private bool StartLease;
    private string SessionMessage = "No screen-cast session is active.";
    private System.Security.Claims.ClaimsPrincipal Viewer = new();
    private bool SelectionMode, CommandsBusy;
    private readonly HashSet<Guid> SelectedUnits = [];
    private List<UnitMonitoringDTO> SelectedOnlineUnits => VisibleUnits
        .Where(u => SelectedUnits.Contains(u.Id) && u.IsAvailableOnline(ObservedAtUtc)).ToList();
    private List<UnitMonitoringDTO> VisibleUnits => Units
        .Where(u => u.LaboratoryId.ToString() == Laboratory).ToList();
    private string BackUrl => Laboratory.Length == 0 ? "/unit-monitoring" : $"/unit-monitoring?lab={Laboratory}";

    protected override void OnParametersSet()
    {
        if (!LabSessionId.HasValue) Laboratory = LabId?.ToString() ?? "";
    }

    protected override void OnDataUpdated()
    {
        if (!LabSessionId.HasValue && LastUpdatedUtc.HasValue && Laboratory.Length > 0 && !Units.Any(u => u.LaboratoryId.ToString() == Laboratory))
            Laboratory = "";
        CurrentPage = Math.Min(CurrentPage, PageCount);
        SelectedUnits.IntersectWith(VisibleUnits.Where(u => u.IsAvailableOnline(ObservedAtUtc)).Select(u => u.Id));
    }

    private ElementReference WallArea;
    private IJSObjectReference? Module;
    private DotNetObjectReference<AllScreens>? Reference;
    private int PageSize = 1;
    private int CurrentPage = 1;
    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)VisibleUnits.Count / PageSize));
    private IEnumerable<UnitMonitoringDTO> PageUnits => VisibleUnits.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void ChangeLaboratory()
    {
        CurrentPage = 1;
        SelectedUnits.Clear();
        SelectionMode = false;
    }

    private void ToggleSelectionMode()
    {
        if (CommandsBusy || !LabSessionId.HasValue) return;
        SelectionMode = !SelectionMode;
        if (!SelectionMode) SelectedUnits.Clear();
    }
    private void SelectUnit(Guid id, bool selected)
    {
        if (CommandsBusy || !SelectionMode || !LabSessionId.HasValue) return;
        if (selected && VisibleUnits.Any(u => u.Id == id && u.IsAvailableOnline(ObservedAtUtc))) SelectedUnits.Add(id);
        else SelectedUnits.Remove(id);
    }
    private void SelectOnlineUnits()
    {
        if (!CommandsBusy && LabSessionId.HasValue)
            SelectedUnits.UnionWith(VisibleUnits.Where(u => u.IsAvailableOnline(ObservedAtUtc)).Select(u => u.Id));
    }
    private void SetCommandsBusy(bool busy) => CommandsBusy = busy;

    private async Task StartLabSessionAsync()
    {
        if (SessionBusy || SessionDisposed || LabSessionId.HasValue || !int.TryParse(Laboratory, out var lab)) return;
        SessionBusy = true;
        try
        {
            Viewer = (await Authentication.GetAuthenticationStateAsync()).User;
            LabSessionId = await LabScreenCasts.StartAsync(Viewer, lab);
            if (SessionDisposed) { await LabScreenCasts.EndAsync(Viewer, LabSessionId.Value); return; }
            CurrentPage = 1;
            StartLease = true;
            SessionMessage = $"Session #{LabSessionId} is active. Offline PCs appear when their agents connect; use Refresh if needed.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { SessionMessage = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not start lab screen casting.");
            SessionMessage = "Could not start the session. Check the screen-cast database tables and try again.";
        }
        finally { SessionBusy = false; }
    }

    private async Task EndLabSessionAsync()
    {
        if (SessionBusy || LabSessionId is not { } id) return;
        SessionBusy = true;
        LabSessionId = null;
        SelectedUnits.Clear();
        SelectionMode = CommandsBusy = false;
        StartLease = false;
        try
        {
            await LabScreenCasts.EndAsync(Viewer, id);
            SessionMessage = $"Session #{id} ended.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save the end of lab screen-cast session {SessionId}.", id);
            SessionMessage = "Capture stopped. The server will retry saving the session end.";
        }
        finally
        {
            SessionBusy = false;
            if (Module is not null)
            {
                try { await Module.InvokeVoidAsync("stopLease", WallArea); }
                catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { }
            }
        }
    }

    [JSInvokable]
    public Task LabSessionEnded(int id) => InvokeAsync(async () =>
    {
        if (LabSessionId != id || SessionDisposed) return;
        await EndLabSessionAsync();
        SessionMessage = "The session ended or the browser stopped responding. Start a new session to resume.";
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            Module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Monitoring/AllScreens.razor.js");
            Reference = DotNetObjectReference.Create(this);
            await Module.InvokeVoidAsync("observe", WallArea, Reference);
        }
        if (StartLease && LabSessionId is { } id && Module is not null)
        {
            StartLease = false;
            try { await Module.InvokeVoidAsync("startLease", WallArea, id, Reference); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
                await EndLabSessionAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task ResizeWall(int capacity) => InvokeAsync(() =>
    {
        // The server permits at most sixteen simultaneous sessions per viewer.
        PageSize = Math.Clamp(capacity, 1, 16);
        CurrentPage = Math.Min(CurrentPage, PageCount);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        SessionDisposed = true;
        Dispose();
        await EndLabSessionAsync();
        if (Module is not null)
        {
            try
            {
                await Module.InvokeVoidAsync("disconnect", WallArea);
                await Module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        Reference?.Dispose();
    }
}
