@page "/unit-monitoring/screens"
@layout ScreenWallLayout
@attribute [Authorize(Roles = "Admin")]
@inherits MonitoringPageBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@using CLMS.Application.DTOs.Monitoring
@using CLMS.Web.Models

<PageTitle>All Screens | CLMS</PageTitle>

<div class="flex h-full flex-col">
    <header class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-b border-white/10 px-4 py-3">
        <div>
            <h1 class="text-lg font-semibold">All Screens</h1>
            <p class="text-xs text-gray-400" role="status">
                @if (LastUpdatedUtc.HasValue)
                {
                    <span>@VisibleUnits.Count workstations · Updated @UnitMonitoringDisplay.FormatUtc(LastUpdatedUtc)</span>
                }
                else if (Loading)
                {
                    <span>Loading workstations…</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <label for="screen-wall-laboratory" class="sr-only">Laboratory</label>
            <select id="screen-wall-laboratory" @bind="Laboratory" @bind:after="ChangeLaboratory"
                    class="max-w-full rounded-lg border border-white/20 bg-gray-900 px-3 py-2 text-sm text-white focus-visible:outline-2 focus-visible:outline-accent">
                <option value="">All laboratories</option>
                @foreach (var laboratory in Units.GroupBy(u => u.LaboratoryId).Select(g => g.First()))
                {
                    <option value="@laboratory.LaboratoryId">@laboratory.Laboratory</option>
                }
            </select>
            <button type="button" @onclick="LoadAsync" disabled="@Loading" class="rounded-lg border border-white/20 px-3 py-2 text-sm hover:bg-gray-800 disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-accent">@(Loading ? "Refreshing…" : "Refresh")</button>
            <a href="@BackUrl" class="rounded-lg bg-white px-3 py-2 text-sm font-medium text-gray-900 focus-visible:outline-2 focus-visible:outline-accent">Back to units</a>
        </div>
    </header>

    @if (Error is not null)
    {
        <p role="alert" class="shrink-0 px-4 py-2 text-sm text-red-300">@Error</p>
    }
    <div class="screen-wall-area" @ref="WallArea">
    @if (LastUpdatedUtc.HasValue && VisibleUnits.Count == 0)
    {
        <p class="m-auto p-6 text-center text-sm text-gray-400">No registered workstations in this view.</p>
    }
    else if (VisibleUnits.Count > 0)
    {
        <div class="screen-wall" aria-label="All workstation screens">
            @foreach (var unit in PageUnits)
            {
                <button @key="unit.Id" type="button" @onclick="() => SelectedUnit = unit" aria-haspopup="dialog"
                        aria-label="@($"View details for {unit.Name}, {unit.Laboratory}")"
                        class="screen-tile flex min-h-0 min-w-0 flex-col overflow-hidden rounded-lg border border-white/15 bg-gray-900 text-left hover:border-white/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
                    <div class="flex shrink-0 items-center justify-between gap-2 bg-gray-800 px-3 py-2">
                        <p class="truncate text-sm font-medium" title="@unit.Name">@unit.Name</p>
                        <span class="shrink-0 rounded bg-white/10 px-2 py-0.5 text-xs text-gray-200">@unit.GetStatus(ObservedAtUtc).Label()</span>
                    </div>
                    <div class="flex min-h-0 flex-1 items-center justify-center p-2 text-center">
                        <p class="text-xs text-gray-400">Screen feed unavailable</p>
                    </div>
                    <p class="shrink-0 truncate px-3 pb-2 text-xs text-gray-400" title="@unit.Laboratory">@unit.Laboratory</p>
                </button>
            }
        </div>
    }
    </div>
    <nav class="screen-pagination" aria-label="Screen pages">
        <button type="button" @onclick="() => CurrentPage--" disabled="@(CurrentPage <= 1)">Previous</button>
        <span role="status">Page @CurrentPage of @PageCount · @VisibleUnits.Count workstations</span>
        <button type="button" @onclick="() => CurrentPage++" disabled="@(CurrentPage >= PageCount)">Next</button>
    </nav>
</div>

<UnitDetailsModal Unit="SelectedUnit" ObservedAtUtc="ObservedAtUtc" OnClose="() => SelectedUnit = null" />

@code {
    [SupplyParameterFromQuery(Name = "lab")] public int? LabId { get; set; }
    private string Laboratory = "";
    private UnitMonitoringDTO? SelectedUnit;
    private List<UnitMonitoringDTO> VisibleUnits => Units
        .Where(u => Laboratory.Length == 0 || u.LaboratoryId.ToString() == Laboratory).ToList();
    private string BackUrl => Laboratory.Length == 0 ? "/unit-monitoring" : $"/unit-monitoring?lab={Laboratory}";

    protected override void OnParametersSet() => Laboratory = LabId?.ToString() ?? "";

    protected override void OnDataUpdated()
    {
        if (Laboratory.Length > 0 && !Units.Any(u => u.LaboratoryId.ToString() == Laboratory))
            Laboratory = "";
        CurrentPage = Math.Min(CurrentPage, PageCount);
        UpdateSelection();
    }

    private void UpdateSelection() => SelectedUnit = VisibleUnits.FirstOrDefault(u => u.Id == SelectedUnit?.Id);

    private ElementReference WallArea;
    private IJSObjectReference? Module;
    private DotNetObjectReference<AllScreens>? Reference;
    private int PageSize = 1;
    private int CurrentPage = 1;
    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)VisibleUnits.Count / PageSize));
    private IEnumerable<UnitMonitoringDTO> PageUnits => VisibleUnits.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void ChangeLaboratory()
    {
        CurrentPage = 1;
        UpdateSelection();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (!firstRender) return;
        Module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Monitoring/AllScreens.razor.js");
        Reference = DotNetObjectReference.Create(this);
        await Module.InvokeVoidAsync("observe", WallArea, Reference);
    }

    [JSInvokable]
    public Task ResizeWall(int capacity) => InvokeAsync(() =>
    {
        PageSize = Math.Max(1, capacity);
        CurrentPage = Math.Min(CurrentPage, PageCount);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (Module is not null)
        {
            try
            {
                await Module.InvokeVoidAsync("disconnect", WallArea);
                await Module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        Reference?.Dispose();
    }
}
