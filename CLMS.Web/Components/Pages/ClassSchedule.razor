@page "/schedules/create"
@rendermode InteractiveServer

@inject IClassScheduleService ScheduleService
@inject ICourseService CourseService
@inject IUserService InstructorService
@inject ILaboratoryService LaboratoryService
@inject IAcademicTermService AcademicTermService
@inject NavigationManager Navigation

<PageTitle>Add Class Schedule</PageTitle>

<div class="modal-backdrop-page">
    <div class="modal-card">

        <div class="modal-card-header">
            <h5>Add Class Schedule</h5>
            <a href="/schedule" class="close-btn">&times;</a>
        </div>

        <div class="modal-card-body">

            @if (!string.IsNullOrEmpty(generalError))
            {
                <div class="alert alert-danger py-2 px-3 mb-3">@generalError</div>
            }

            @if (!courses.Any() || !instructors.Any() || !laboratories.Any() || !terms.Any())
            {
                <div class="alert alert-warning py-2 px-3 mb-3">
                    <strong>Heads up:</strong> Some dropdowns are empty. Make sure you have at least one
                    @(!courses.Any() ? "course, " : "")
                    @(!instructors.Any() ? "instructor, " : "")
                    @(!laboratories.Any() ? "laboratory, " : "")
                    @(!terms.Any() ? "academic term " : "")
                    registered in the system before adding a schedule.
                </div>
            }

            <EditForm Model="formModel" OnValidSubmit="Submit">
                <DataAnnotationsValidator />

                <div class="field">
                    <label>Course</label>
                    <InputSelect @bind-Value="formModel.CourseId" class="field-input">
                        <option value="0">Select a course</option>
                        @foreach (var course in courses)
                        {
                            <option value="@course.Id">@course.CourseCode — @course.CourseName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => formModel.CourseId)" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Semester</label>
                        <InputSelect @bind-Value="formModel.AcademicTermId" class="field-input">
                            <option value="0">Select a term</option>
                            @foreach (var term in terms)
                            {
                                <option value="@term.Id">@Capitalize(term.Semester) semester</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label>School Year</label>
                        <InputSelect @bind-Value="formModel.AcademicTermId" class="field-input">
                            <option value="0">Select a term</option>
                            @foreach (var term in terms)
                            {
                                <option value="@term.Id">@term.AcademicYear</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <ValidationMessage For="@(() => formModel.AcademicTermId)" />

                <div class="field">
                    <label>Assigned Instructor</label>
                    <InputSelect @bind-Value="formModel.InstructorId" class="field-input">
                        <option value="">Select Instructor</option>
                        @foreach (var instructor in instructors)
                        {
                            <option value="@instructor.Id">@instructor.LastName, @instructor.FirstName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => formModel.InstructorId)" />
                </div>

                <div class="field">
                    <label>Target Laboratory</label>
                    <InputSelect @bind-Value="formModel.LaboratoryId" class="field-input">
                        <option value="0">Select a laboratory</option>
                        @foreach (var lab in laboratories)
                        {
                            <option value="@lab.Id">@lab.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => formModel.LaboratoryId)" />
                </div>

                <div class="field-row">
                    <div class="field">
                        <label>Day of Week</label>
                        <InputSelect @bind-Value="formModel.DayOfWeek" class="field-input">
                            <option value="">Select a day</option>
                            @foreach (var day in daysOfWeek)
                            {
                                <option value="@day">@day</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => formModel.DayOfWeek)" />
                    </div>

                    <div class="field">
                        <label>Time Slot</label>
                        <div class="time-slot">
                            <input type="time" class="field-input" value="@startTime?.ToString("HH:mm")" @onchange="OnStartTimeChanged" />
                            <input type="time" class="field-input" value="@endTime?.ToString("HH:mm")" @onchange="OnEndTimeChanged" />
                        </div>
                    </div>
                </div>

                <div class="modal-card-footer">
                    <a href="/schedule" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-submit" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Add Class Schedule")
                    </button>
                </div>

            </EditForm>

        </div>
    </div>
</div>

<style>
    .modal-backdrop-page {
        display: flex;
        justify-content: center;
        padding: 3rem 1rem;
    }

    .modal-card {
        width: 100%;
        max-width: 520px;
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
    }

    .modal-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem 0.5rem;
    }

    .modal-card-header h5 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 600;
    }

    .close-btn {
        color: #888;
        font-size: 1.25rem;
        text-decoration: none;
        line-height: 1;
    }

    .modal-card-body {
        padding: 0.5rem 1.5rem 1.5rem;
    }

    .field {
        margin-bottom: 1rem;
        flex: 1;
    }

    .field label {
        display: block;
        font-size: 0.8rem;
        color: #666;
        margin-bottom: 0.35rem;
    }

    .field-input {
        width: 100%;
        padding: 0.5rem 0.65rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .field-row {
        display: flex;
        gap: 1rem;
    }

    .time-slot {
        display: flex;
        gap: 0.5rem;
    }

    .modal-card-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 1.25rem;
    }

    .btn-cancel {
        padding: 0.55rem 1.25rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        color: #444;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .btn-submit {
        padding: 0.55rem 1.25rem;
        background: #7a1f2b;
        border: none;
        border-radius: 6px;
        color: #fff;
        font-size: 0.9rem;
    }

    .btn-submit:disabled {
        opacity: 0.6;
    }
</style>

@code {
    private IEnumerable<CourseDTO> courses = Enumerable.Empty<CourseDTO>();
    private IEnumerable<UserDTO> instructors = Enumerable.Empty<UserDTO>();
    private IEnumerable<LaboratoryDTO> laboratories = Enumerable.Empty<LaboratoryDTO>();
    private IEnumerable<AcademicTermDTO> terms = Enumerable.Empty<AcademicTermDTO>();

    private readonly string[] daysOfWeek =
        { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    private UpsertClassScheduleDTO formModel = new();

    private TimeOnly? startTime;
    private TimeOnly? endTime;

    private bool isSaving;
    private string? generalError;

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseService.GetAllAsync();
        instructors = await InstructorService.GetFacultyAsync();
        laboratories = await LaboratoryService.GetAllAsync();
        terms = await AcademicTermService.GetAllAsync();
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var start))
        {
            startTime = start;
            endTime = start.AddHours(3);
        }
        else
        {
            startTime = null;
        }
    }

    private void OnEndTimeChanged(ChangeEventArgs e)
    {
        endTime = TimeOnly.TryParse(e.Value?.ToString(), out var end) ? end : null;
    }

    private static string Capitalize(string value) =>
        string.IsNullOrEmpty(value) ? value : char.ToUpper(value[0]) + value[1..];

    private async Task Submit()
    {
        generalError = null;

        if (startTime is null)
        {
            generalError = "Invalid start time.";
            return;
        }

        if (endTime is null)
        {
            generalError = "Invalid end time.";
            return;
        }

        if (startTime >= endTime)
        {
            generalError = "Start time must be earlier than end time.";
            return;
        }

        formModel.TimeStart = startTime.Value;
        formModel.TimeEnd = endTime.Value;

        isSaving = true;

        try
        {
            await ScheduleService.CreateAsync(formModel);
        }
        catch (Exception ex)
        {
            generalError = "Unable to save the schedule.";
            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
}