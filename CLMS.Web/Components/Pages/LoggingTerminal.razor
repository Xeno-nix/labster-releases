@page "/logging-terminal"
@layout PublicLayout
@rendermode InteractiveServer
@using CLMS.Application.Logging
@using CLMS.Application.Logging.Dtos
@inject LoggingAppService LoggingAppService

<PageTitle>Labster — Logging Terminal</PageTitle>

<div class="bg-surface antialiased min-h-dvh flex flex-col">

    <header class="bg-white border-b border-black/10">
        <div class="max-w-4xl mx-auto px-6 py-4 flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center">
                <img src="/images/labster-logo.svg" alt="" width="36" height="36" />
            </div>
            <div>
                <p class="text-primary font-heading font-semibold text-base leading-tight">Labster</p>
                <p class="text-xs text-muted">USeP — Computer Laboratory Management</p>
            </div>
        </div>
    </header>

    <main class="page-body flex-1 py-6 px-3 sm:py-10 sm:px-6">
        <div class="max-w-2xl mx-auto">

            @* Header *@
            <div class="text-center mb-8">
                <h1 class="text-primary text-2xl sm:text-3xl mb-2">Laboratory Logging Terminal</h1>
                <p class="text-muted text-sm">
                    Record your laboratory visit. Select visitor if you do not have a student number.
                </p>
            </div>

            @* Success / error flash *@
            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div role="status" class="mb-6 px-4 py-3 rounded-lg bg-success/10 border border-success/30 text-sm text-success">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 2v4" />
                            <path d="M16 2v4" />
                            <rect width="18" height="18" x="3" y="4" rx="2" />
                            <path d="M3 10h18" />
                        </svg>
                        <span>@SuccessMessage</span>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div role="alert" class="mb-6 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    @ErrorMessage
                </div>
            }

            @* Action tabs *@
            <div class="bg-white rounded-lg border border-black/10 shadow-sm overflow-hidden">

                <div class="tab-strip segmented-tabs grid grid-cols-3">
                    <button type="button" @onclick='() => SetMode("student_in")' aria-pressed='@(Mode == "student_in")' class="justify-center px-2 py-3 text-muted hover:text-primary">
                        Student in
                    </button>
                    <button type="button" @onclick='() => SetMode("guest_in")' aria-pressed='@(Mode == "guest_in")' class="justify-center px-2 py-3 text-muted hover:text-primary">
                        Visitor in
                    </button>
                    <button type="button" @onclick='() => SetMode("time_out")' aria-pressed='@(Mode == "time_out")' class="justify-center px-2 py-3 text-muted hover:text-primary">
                        Check out
                    </button>
                </div>

                @* ─── STUDENT TIME IN ─── *@
                @if (Mode == "student_in")
                {
                    <div class="p-6">
                        <EditForm Model="StudentModel" OnValidSubmit="HandleStudentTimeIn" class="space-y-4">
                            <DataAnnotationsValidator />

                            <div>
                                <label for="si_student_id" class="block text-sm font-medium text-[#2c2c2c] mb-2">
                                    Student Number <span class="text-primary">*</span>
                                </label>
                                <InputText id="si_student_id"
                                           @bind-Value="StudentModel.StudentId"
                                           placeholder="e.g. 2024-00123"
                                           class="w-full px-4 py-4 border border-black/10 rounded-lg bg-surface text-base
                                                  focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                                <ValidationMessage For="@(() => StudentModel.StudentId)" class="text-xs text-red-500 mt-1" />
                            </div>

                            <p class="text-xs text-muted">
                                The laboratory, course, and instructor will be detected from your active class schedule.
                            </p>

                            <button type="submit" disabled="@IsBusy"
                                    class="w-full px-6 py-4 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-base font-medium disabled:opacity-60">
                                @(IsBusy ? "Signing In..." : "Sign In")
                            </button>
                        </EditForm>
                    </div>
                }

                @* ─── GUEST TIME IN ─── *@
                @if (Mode == "guest_in")
                {
                    <div class="p-6">
                        <EditForm Model="GuestModel" OnValidSubmit="HandleGuestTimeIn" class="space-y-4">
                            <DataAnnotationsValidator />

                            <div>
                                <label for="g_booked_under" class="block text-sm font-medium text-[#2c2c2c] mb-2">
                                    Reservation Booked Under <span class="text-primary">*</span>
                                </label>
                                <InputText id="g_booked_under"
                                           @bind-Value="GuestModel.BookedUnder"
                                           placeholder="Name on the reservation (e.g. your group leader)"
                                           class="w-full px-4 py-4 border border-black/10 rounded-lg bg-surface text-base
                                                  focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                                <ValidationMessage For="@(() => GuestModel.BookedUnder)" class="text-xs text-red-500 mt-1" />
                            </div>

                            <div>
                                <label for="g_name" class="block text-sm font-medium text-[#2c2c2c] mb-2">
                                    Your Full Name <span class="text-primary">*</span>
                                </label>
                                <InputText id="g_name"
                                           @bind-Value="GuestModel.GuestName"
                                           placeholder="Your own name — for individual attendance"
                                           class="w-full px-4 py-4 border border-black/10 rounded-lg bg-surface text-base
                                                  focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                                <ValidationMessage For="@(() => GuestModel.GuestName)" class="text-xs text-red-500 mt-1" />
                            </div>

                            <p class="text-xs text-muted">
                                Each attendee signs in with the same reservation name but their own full name.
                                Don't have a reservation?
                                <a href="/reserve" class="text-primary underline">Book one here</a>.
                            </p>

                            <button type="submit" disabled="@IsBusy"
                                    class="w-full px-6 py-4 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-base font-medium disabled:opacity-60">
                                @(IsBusy ? "Signing In..." : "Sign In as Visitor")
                            </button>
                        </EditForm>
                    </div>
                }

                @* ─── TIME OUT (unified) ─── *@
                @if (Mode == "time_out")
                {
                    <div class="p-6">
                        <EditForm Model="TimeOutModel" OnValidSubmit="HandleTimeOut" class="space-y-4">
                            <DataAnnotationsValidator />

                            <div>
                                <label for="to_identifier" class="block text-sm font-medium text-[#2c2c2c] mb-2">
                                    Student Number or Full Name <span class="text-primary">*</span>
                                </label>
                                <InputText id="to_identifier"
                                           @bind-Value="TimeOutModel.Identifier"
                                           placeholder="Students: e.g. 2024-00123    Visitors: your full name"
                                           class="w-full px-4 py-4 border border-black/10 rounded-lg bg-surface text-base
                                                  focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
                                <ValidationMessage For="@(() => TimeOutModel.Identifier)" class="text-xs text-red-500 mt-1" />
                            </div>

                            <p class="text-xs text-muted">
                                This will end your current laboratory session.
                            </p>

                            <button type="submit" disabled="@IsBusy"
                                    class="w-full px-6 py-4 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-base font-medium disabled:opacity-60">
                                @(IsBusy ? "Signing Out..." : "Sign Out")
                            </button>
                        </EditForm>
                    </div>
                }

            </div>
        </div>
    </main>

    <footer class="border-t border-black/10 py-4">
        <div class="max-w-4xl mx-auto px-6 text-center text-xs text-muted">
            University of Southeastern Philippines — Tagum-Mabini
        </div>
    </footer>

</div>

@code {
    private string Mode { get; set; } = "student_in";
    private bool IsBusy { get; set; }

    private string? SuccessMessage { get; set; }
    private string? ErrorMessage { get; set; }

    private StudentTimeInRequest StudentModel { get; set; } = new();
    private GuestTimeInRequest GuestModel { get; set; } = new();
    private TimeOutRequest TimeOutModel { get; set; } = new();

    private void SetMode(string mode)
    {
        Mode = mode;
        ClearMessages();
    }

    private void ClearMessages()
    {
        SuccessMessage = null;
        ErrorMessage = null;
    }

    private Task HandleStudentTimeIn() => RunAsync(async () =>
    {
        var result = await LoggingAppService.StudentTimeInAsync(StudentModel);
        ApplyResult(result);
        if (result.Success) StudentModel = new();
    });

    private Task HandleGuestTimeIn() => RunAsync(async () =>
    {
        var result = await LoggingAppService.GuestTimeInAsync(GuestModel);
        ApplyResult(result);
        if (result.Success) GuestModel = new();
    });

    private Task HandleTimeOut() => RunAsync(async () =>
    {
        var result = await LoggingAppService.TimeOutAsync(TimeOutModel);
        ApplyResult(result);
        if (result.Success) TimeOutModel = new();
    });

    private void ApplyResult(LoggingResult result)
    {
        if (result.Success)
        {
            SuccessMessage = result.Message;
            ErrorMessage = null;
        }
        else
        {
            ErrorMessage = result.Message;
            SuccessMessage = null;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        IsBusy = true;
        try
        {
            await action();
        }
        finally
        {
            IsBusy = false;
        }
    }
}
