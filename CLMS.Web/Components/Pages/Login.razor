@page "/login"

@inject CLMS.Application.Authentication.Services.AuthenticationService authService;

<div class="min-h-screen flex items-center justify-center p-6 bg-[#f8f8f8]">
    <div class="w-full max-w-md">
        
        <div class="text-center mb-8">
            <h1 class="text-3xl text-primary font-medium mb-2">CLMS Login</h1>
            <p class="text-gray-600">Computer Laboratory Management System</p>
            <p class="text-gray-600">USeP TMC - Tagum Unit</p>
        </div>
        
        @* card *@
        <div class="border-[#d5d5d5] border px-6 mb-8 py-8 w-full rounded-xl bg-white shadow-lg">
            <form
                method="post"
                action="/auth/cookie-login"
                class="space-y-6">
                <div>
                    <label class="block mb-2">Email Address</label>
                    <input 
                        name="Email"
                        type="email" 
                        placeholder="Enter your email" 
                        required
                        class="w-full px-4 py-3 border border-[#d5d5d5] rounded-lg bg-gray-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"/>
                </div>
                <div>
                    <label class="block mb-2">Password</label>
                    <div class="relative">
                        <input 
                            name="Password"
                            type="@(_showPassword ? "text" : "password")" 
                            placeholder="Enter your password"
                            required
                            class="overflow-clip w-full pl-4 pr-12 py-3 border border-[#d5d5d5] rounded-lg bg-gray-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"/>
                        <button 
                            type="button" 
                            @onclick="ToggleShowPassword"
                            class="absolute right-4 top-1/2 -translate-y-1/2 hover:cursor-pointer  z-10">
                            <svg height="24" width="24" viewBox="0 0 24 24" color="#777777">
                                <use href="@Assets[!_showPassword ? "/svg/eye-on.svg" : "/svg/eye-off.svg"]"></use>
                            </svg>
                        </button>
                    </div>
                </div>
                <button
                    type="submit"
                    class="bg-primary w-full px-4 py-3 rounded-lg text-white font-bold hover:bg-primary-dark duration-75">
                    Login
                </button>
                <div class="w-full text-center">
                    <a href="#" class="text-primary hover:underline">
                        Forgot Password?
                    </a>
                </div>
            </form>
        </div>
        
        @if (Error is "Invalid")
        {
            <div class="border-error-dark border px-2 py-4 w-full bg-error shadow-lg text-center relative">
                <svg height="24" width="24" viewBox="0 0 24 24" color="#ffffff" class="inline-block absolute left-5">
                    <use href="@Assets["/svg/info.svg"]"></use>
                </svg>
                <p class="inline-block text-white font-medium">Invalid Credentials...</p>
            </div>
        }
        
    </div>
</div>

@code {
    private bool _showPassword = false;
    
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private void ToggleShowPassword()
    {
        _showPassword = !_showPassword;
    }
}