@page "/login"
@layout PublicLayout

@rendermode InteractiveServer

@using CLMS.Application.Identity.Services
@using CLMS.Web.Models
@using CLMS.Web.Services

@inject AuthenticationService authService;
@inject NavigationManager Navigation;
@inject IConfiguration Configuration;
@inject ToastService Toasts

<PageTitle>CLMS - Login</PageTitle>


<div class="min-h-dvh grid grid-cols-1 lg:grid-cols-2 bg-[#f8f8f8] text-fg-primary">
    <div class="flex min-w-0 justify-center items-center px-4 py-10 sm:px-6 lg:min-h-dvh">
        <div class="w-full max-w-lg">
            <div class="text-center mb-8">
                <h1 class="text-3xl text-primary font-medium mb-2">Labster Login</h1>
                <p class="text-gray-600">Computer Laboratory Management System</p>
                <p class="text-gray-600">USeP TMC - Tagum Unit</p>
            </div>

            @* card *@
            <div class="w-full min-w-0 mb-8 py-6 sm:px-6 sm:py-8">
                <form
                    method="post"
                    action="/auth/cookie-login"
                    class="space-y-2">
                    <AntiforgeryToken />
                    <div>
                        <label class="block mb-2">Email Address</label>
                        <input
                            value="@Model.Email"
                            type="email"
                            name="Email"
                            required
                            placeholder="Enter your email"
                            class="w-full px-4 py-3 border border-[#d5d5d5] rounded-sm bg-gray-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"/>
                    </div>
                    <div>
                        <label class="block mb-2">Password</label>
                        <div class="relative">
                            <input
                                id="passwordFld"
                                value="@Model.Password"
                                type="password"
                                name="Password"
                                required
                                minlength="8"
                                placeholder="Enter your password"
                                class="overflow-clip w-full pl-4 pr-12 py-3 border border-[#d5d5d5] rounded-sm bg-gray-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all"/>
                            <button
                                id="toggleShowPasswordBtn"
                                type="button"
                                onclick="toggleShowPassword()"
                                class="absolute right-4 top-1/2 -translate-y-1/2 hover:cursor-pointer  z-10">
                                <svg height="24" width="24" viewBox="0 0 24 24" color="#898989">
                                    <use id="toggleShowPasswordBtnIcon" href="/svg/eye-on.svg"></use>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
                        <span>
                            <input id="rememberMe" 
                                   type="checkbox"
                                   value="true"
                                   name="rememberMe"/>
                            <label for="rememberMe">Remember Me</label>
                        </span>
                        <a href="/forgot-password">Forgot Password? </a>
                    </div>
                    <button
                        type="submit"
                        class="bg-primary w-full px-4 py-3 rounded-sm text-white font-bold hover:bg-primary-dark duration-75">
                        Login
                    </button>
                    <a href="/auth/google/start" class="block w-full">
                        <div class="gsi-material-button">
                            <div class="gsi-material-button-state"></div>
                            <div class="gsi-material-button-content-wrapper">
                                <div class="gsi-material-button-icon">
                                    <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;">
                                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
                                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
                                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
                                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
                                        <path fill="none" d="M0 0h48v48H0z"></path>
                                    </svg>
                                </div>
                                <span class="gsi-material-button-contents">Sign in with Google</span>
                                <span style="display: none;">Sign in with Google</span>
                            </div>
                        </div>
                    </a>
                </form>
                
                @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("message=password_changed"))
                {
                    <p role="status" class="mt-5 rounded-lg border border-primary/20 p-4 text-sm">Password changed successfully. Sign in with your new password.</p>
                }
                @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("message=password_reset"))
                {
                    <p role="status">Password reset successfully. Sign in using your new password and email code.</p>
                }
                @if (Error is "verification_expired" or "verification_unavailable")
                {
                    <p role="alert">Email verification expired or is unavailable. Sign in again. If email delivery fails, retry shortly or contact your administrator.</p>
                }
                @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("message=two_factor_updated"))
                {
                    <p role="status">Your 2FA setting was saved. Sign in again.</p>
                }
                @if (!String.IsNullOrWhiteSpace(Error) &&
                     Error is "invalid" or "google_account_not_authorized" or "google_verification_failed"
                     )
                {
                    <div role="alert" class="mt-5 flex flex-col items-start gap-3 rounded-sm border border-error/50 bg-error/20 p-4">
                        <div class="w-full flex flex-start gap-2 items-center">
                            <i class="fa-solid fa-info-circle text-error-dark"></i>
                            
                            <p class="text-sm font-semibold text-error-dark">
                                @if (Error is "invalid")
                                {
                                    <text>Sign-in failed</text>
                                } 
                                else if (Error is "google_account_not_authorized")
                                {
                                    <text>Google account not registered</text>
                                }
                                else if (Error is "google_verification_failed")
                                {
                                    <text>Google verification unsuccessful</text>
                                }
                            </p>
                        </div>
                        <p class="mt-1 text-sm leading-relaxed text-fg-primary break-words">
                            @if (Error is "invalid")
                            {
                                <text>Email or password is incorrect!</text>
                            } 
                            else if (Error is "google_account_not_authorized")
                            {
                                <text>
                                    This Google account is not registered or is not an allowed organization account. Contact your administrator.
                                </text>
                            }
                            else if (Error is "google_verification_failed")
                            {
                                <text>Google sign-in was cancelled or could not be completed. Try again with your organization account.</text>
                            }
                        </p>
                    </div> 
                }
            </div>
        </div>
        </div>
    <div aria-hidden="true" class="bg-primary bg-[url('/svg/blob-scene-haikei.svg')] bg-no-repeat bg-cover min-h-64 lg:min-h-dvh">
    </div>
</div>
<script>
    function toggleShowPassword()
    {
        const toggleShowPasswordBtn = document.getElementById("toggleShowPasswordBtn");
        const toggleShowPasswordBtnIcon = document.getElementById("toggleShowPasswordBtnIcon");
        const passwordFld = document.getElementById("passwordFld");
        
        let showPassword = passwordFld.getAttribute('type') === "password";
        
        toggleShowPasswordBtnIcon.setAttribute('href',showPassword ? "/svg/eye-on.svg" : "/svg/eye-off.svg");
        passwordFld.setAttribute('type', showPassword ? "text" : "password") ;
        showPassword = !showPassword;
    }
</script>

@code {
    [SupplyParameterFromForm(FormName = "LoginForm")]
    private LoginFormModel Model { get; set; } =  new ();
    
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "attemptsLeft")]
    private int? AttemptsLeft { get; set; }

    [SupplyParameterFromQuery(Name = "minutes")]
    private int? LockoutMinutes { get; set; }

    private async Task HandleSubmit()
    {
        Navigation.NavigateTo("/auth/cookie-login");
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || Error is null) return;

        if (Error is "locked")
        {
            var retry = LockoutMinutes switch
            {
                null or < 1 => "Try again later.",
                1 => "Try again in 1 minute.",
                _ => $"Try again in {LockoutMinutes} minutes."
            };
            Toasts.Show($"Account temporarily locked. Too many failed login attempts. {retry}", ToastService.ToastType.Error);
        }
        else if (AttemptsLeft is > 0)
        {
            // heads-up: the account is close to being locked
            Toasts.Show(AttemptsLeft == 1
                    ? "Email or password is incorrect. This is your last attempt before your account is temporarily locked."
                    : $"Email or password is incorrect. You have {AttemptsLeft} attempts left before your account is temporarily locked.",
                ToastService.ToastType.Warning);
        }
        else
        {
            Toasts.Show("Email or password is incorrect.", ToastService.ToastType.Error);
        }

        // drop ?error=... so a refresh doesn't show the toast again
        Navigation.NavigateTo("/login", replace: true);
    }
}
