<div class="flex flex-col items-center justify-center py-24 text-center">
    <div class="w-16 h-16 bg-surface rounded-full flex items-center justify-center mb-4">
        @ChildContent
    </div>
    <h1 class="text-primary text-xl mb-2">@Title</h1>
    <p class="text-muted text-sm max-w-sm">This page hasn't been implemented yet. Check back soon.</p>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
