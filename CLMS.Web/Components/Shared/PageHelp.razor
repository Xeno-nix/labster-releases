@using CLMS.Web.Models

<button type="button" class="page-help-trigger" aria-label="@($"Help for {guide.Title}")"
        aria-haspopup="dialog" aria-controls="@DialogId"
        data-open-page-help="@DialogId">
    <span class="page-help-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M5.5 5.5a2.5 2.5 0 1 1 3.7 2.2C8.4 8.1 8 8.7 8 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="8" cy="12.5" r=".9" fill="currentColor" />
        </svg>
    </span>
    <span class="page-help-tooltip" aria-hidden="true">Help for @guide.Title</span>
</button>

<Modal NativeId="@DialogId" Title="@($"{guide.Title} help")">
    <div class="page-help-copy">
        <p>@guide.Introduction</p>
        <ol>
            @foreach (var step in guide.Steps)
            {
                <li>@step</li>
            }
        </ol>
        @if (ChildContent is not null)
        {
            <div class="page-help-note">@ChildContent</div>
        }
    </div>
</Modal>

@code {
    [Parameter, EditorRequired] public string Guide { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string DialogId = $"page-help-{Guid.NewGuid():N}";
    private PageHelpGuide guide = default!;
    protected override void OnParametersSet() => guide = PageHelpGuide.Guides[Guide];
}
