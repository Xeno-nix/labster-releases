@using CLMS.Application.DTOs.Monitoring
@using CLMS.Web.Models
@inject IWebHostEnvironment Environment

@if (Environment.IsDevelopment())
{
    <aside class="fixed bottom-5 right-5 z-50 max-w-sm" aria-label="Unit availability debugger">
        @if (Open)
        {
            <div id="availability-debug-panel" class="mb-3 max-h-[65vh] overflow-y-auto rounded-xl border border-gray-200 bg-white p-4 shadow-xl">
                <h3 class="text-sm font-semibold text-gray-800">Unit status preview</h3>
                <p class="mt-1 text-xs text-muted">Preview only on this page. Database records stay unchanged. Closing this panel restores live statuses.</p>
                <p class="my-3 text-xs font-medium text-primary" role="status">@(Overrides.Count == 0 ? "Live data" : $"Demo active: {Overrides.Count} unit(s) overridden")</p>
                <div class="mb-3 flex flex-wrap gap-2">
                    @foreach (var status in Enum.GetValues<UnitMonitoringStatus>())
                    {
                        <button type="button" disabled="@(Units.Count == 0)" @onclick="() => SetAllAsync(status)" class="rounded-lg border border-gray-200 px-2 py-1 text-xs text-primary disabled:opacity-50">All @status.Label()</button>
                    }
                    <button type="button" @onclick="ResetAsync" class="rounded-lg border border-gray-200 px-2 py-1 text-xs text-primary">Reset to live</button>
                </div>
                @if (Units.Count == 0)
                {
                    <p class="text-xs text-muted">Register a workstation to preview its status.</p>
                }
                @foreach (var unit in Units)
                {
                    <label @key="unit.Id" class="mb-2 flex items-center justify-between gap-3 text-xs text-gray-700">
                        <span>@unit.Name <span class="block text-muted">@unit.Laboratory</span></span>
                        <select aria-label="@($"Preview status for {unit.Name}, {unit.Laboratory}")" value="@SelectedValue(unit.Id)" @onchange="e => SetUnitAsync(unit.Id, e.Value?.ToString())" class="rounded-lg border border-gray-200 bg-white px-2 py-1">
                            <option value="">Live</option>
                            @foreach (var status in Enum.GetValues<UnitMonitoringStatus>())
                            {
                                <option value="@status">@status.Label()</option>
                            }
                        </select>
                    </label>
                }
            </div>
        }
        <button type="button" @onclick="ToggleAsync" aria-expanded="@Open" aria-controls="availability-debug-panel" class="float-right rounded-full bg-primary px-4 py-3 text-sm font-medium text-white shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            @(Open ? "Close debug" : "Debug units")
        </button>
    </aside>
}

@code {
    [Parameter] public IReadOnlyList<UnitMonitoringDTO> Units { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyDictionary<Guid, UnitMonitoringStatus>> OnChange { get; set; }
    private bool Open;
    private readonly Dictionary<Guid, UnitMonitoringStatus> Overrides = new();
    private string SelectedValue(Guid id) => Overrides.TryGetValue(id, out var status) ? status.ToString() : "";

    private async Task ToggleAsync()
    {
        Open = !Open;
        if (!Open) await ResetAsync();
    }

    private Task NotifyAsync() => OnChange.InvokeAsync(new Dictionary<Guid, UnitMonitoringStatus>(Overrides));

    private Task ResetAsync()
    {
        Overrides.Clear();
        return NotifyAsync();
    }

    private Task SetAllAsync(UnitMonitoringStatus status)
    {
        Overrides.Clear();
        foreach (var unit in Units) Overrides[unit.Id] = status;
        return NotifyAsync();
    }

    private Task SetUnitAsync(Guid id, string? value)
    {
        if (Enum.TryParse<UnitMonitoringStatus>(value, out var status) && Enum.IsDefined(status))
            Overrides[id] = status;
        else
            Overrides.Remove(id);
        return NotifyAsync();
    }
}
