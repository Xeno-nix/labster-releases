@implements IDisposable

<button type="button" class="action-menu-trigger" data-action-menu="@id" aria-expanded="false"
        aria-label="@Label" title="@Label" @onclick="Open">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="12" cy="4" r="2" />
        <circle cx="12" cy="12" r="2" />
        <circle cx="12" cy="20" r="2" />
    </svg>
</button>

@code {
    [Parameter] public string Label { get; set; } = "More actions";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private ActionMenuHost? Host { get; set; }

    private readonly string id = $"actions-{Guid.NewGuid():N}";

    private void Open() => Host?.Open(id, Label, ChildContent);

    public void Dispose() => Host?.Release(id);
}
