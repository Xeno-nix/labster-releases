@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" class="@(Compact ? "ui-dialog" : "ui-sheet")" aria-label="@Label">
    @if (!Compact)
    {
        <button type="button" class="sheet-grip" aria-label="Expand sheet" aria-expanded="false">
            <span aria-hidden="true"></span>
        </button>
    }
    <div class="sheet-content">
        @ChildContent
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "Details";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Compact { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<UiSheet>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui-sheet.js");
        _controller = await _module.InvokeAsync<IJSObjectReference>("openSheet", _dialog, _reference);
    }

    [JSInvokable]
    public async Task<bool> RequestClose()
    {
        if (Busy || !OnClose.HasDelegate) return false;
        await OnClose.InvokeAsync();
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_controller is not null)
            {
                await _controller.InvokeVoidAsync("dispose");
                await _controller.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
}
