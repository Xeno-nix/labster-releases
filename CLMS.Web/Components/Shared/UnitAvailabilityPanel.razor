@inherits CLMS.Web.Components.Pages.Monitoring.MonitoringPageBase
@using CLMS.Web.Models
@using CLMS.Application.DTOs.Monitoring

<section class="mb-6 rounded-lg border border-gray-200 bg-white p-5" aria-label="Unit availability">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h4 class="text-base font-heading font-semibold text-gray-800">Unit availability</h4>
        <a href="/unit-monitoring" class="text-sm text-primary">View monitoring →</a>
    </div>
    <p class="mb-3 text-xs text-muted">Updates every 5 seconds. Units without a heartbeat for 2 minutes appear offline.</p>
    @if (Error is not null)
    {
        <p role="alert" class="mb-3 text-sm text-error">@Error</p>
    }
    @if (!LastUpdatedUtc.HasValue)
    {
        <p class="text-sm text-muted">@(Loading ? "Loading unit availability…" : "Unit availability unavailable.")</p>
    }
    else
    {
        <p class="mb-3 text-sm text-gray-700" role="status">@Units.Count(u => u.GetStatus(ObservedAtUtc) == UnitMonitoringStatus.Available) available · @Units.Count(u => u.GetStatus(ObservedAtUtc) == UnitMonitoringStatus.InUse) in use · @Units.Count(u => u.GetStatus(ObservedAtUtc) == UnitMonitoringStatus.Offline) offline</p>
        @if (Units.Count == 0)
        {
            <p class="text-sm text-muted">No registered workstations.</p>
        }
        @foreach (var lab in Units.GroupBy(u => u.LaboratoryId))
        {
            <div class="mb-3 last:mb-0">
                <a href="@($"/unit-monitoring?lab={lab.Key}")" class="text-sm font-medium text-primary">@lab.First().Laboratory</a>
                <div class="mt-2 flex flex-wrap gap-2">
                    @foreach (var unit in lab)
                    {
                        <a @key="unit.Id" href="@($"/unit-monitoring?lab={lab.Key}")" class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700" title="@($"Last heartbeat: {UnitMonitoringDisplay.FormatUtc(unit.LastHeartbeatUtc)}")">
                            <span>@unit.Name</span>
                            <UnitAvailabilityBadge Status="@unit.GetStatus(ObservedAtUtc)" />
                        </a>
                    }
                </div>
            </div>
        }
        <p class="mt-3 text-xs text-muted">Last loaded @UnitMonitoringDisplay.FormatUtc(LastUpdatedUtc)</p>
    }
</section>

<UnitAvailabilityDebug Units="Units" OnChange="SetPreviewStatuses" />
