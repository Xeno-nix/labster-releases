@inherits CLMS.Web.Components.Pages.Monitoring.MonitoringPageBase
@using CLMS.Web.Models
@using CLMS.Application.DTOs.Monitoring

<section class="rounded-lg border border-gray-200 bg-white p-5" aria-label="Unit availability">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h4 class="text-base font-heading font-semibold text-gray-800">Unit availability</h4>
        <a href="/unit-monitoring" class="text-sm text-primary">View monitoring →</a>
    </div>
    <p class="mb-4 text-xs text-muted">All laboratories · Updates every 5 seconds</p>
    @if (Error is not null)
    {
        <p role="alert" class="mb-3 text-sm text-error">@Error</p>
    }
    @if (!LastUpdatedUtc.HasValue)
    {
        <p class="text-sm text-muted">@(Loading ? "Loading unit availability…" : "Unit availability unavailable.")</p>
    }
    else
    {
        <dl class="grid grid-cols-3 gap-4 sm:gap-6" aria-live="polite" aria-atomic="true">
            @foreach (var status in Enum.GetValues<UnitMonitoringStatus>())
            {
                <div class="py-3 text-left">
                    <dt class="text-xs font-medium text-muted sm:text-sm">@status.Label()</dt>
                    <dd class="mt-2 text-3xl font-heading font-semibold text-gray-800">@Units.Count(u => u.GetStatus(ObservedAtUtc) == status)</dd>
                </div>
            }
        </dl>
        @if (Units.Count == 0)
        {
            <p class="mt-3 text-xs text-muted">No registered workstations.</p>
        }
        else
        {
            <p class="mt-3 text-xs text-muted">@Units.Count registered units</p>
        }
    }
</section>

<UnitAvailabilityDebug Units="Units" OnChange="SetPreviewStatuses" />
