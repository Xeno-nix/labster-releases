@* Generic centered confirm dialog: icon + title + body + Cancel/Confirm buttons. *@

@if (Show)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4" @onclick="Cancel">
        <div class="bg-white rounded-xl w-full max-w-md shadow-2xl" @onclick:stopPropagation="true">
            <div class="p-6 text-center">
                <div class="w-12 h-12 @IconBgClass rounded-full flex items-center justify-center mx-auto mb-4">
                    @IconContent
                </div>
                <h3 class="font-heading font-semibold text-[#2c2c2c] text-lg mb-1">@Title</h3>
                @Body
                <div class="flex justify-center gap-3 mt-5">
                    <button type="button" @onclick="Cancel"
                            class="px-5 py-2.5 border border-black/10 rounded-lg hover:bg-surface transition-colors text-sm">
                        Cancel
                    </button>
                    <button type="button" @onclick="Confirm"
                            class="px-5 py-2.5 @ConfirmButtonClass rounded-lg transition-colors text-sm font-medium">
                        @ConfirmLabel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public string IconBgClass { get; set; } = "bg-primary/10";
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";
    [Parameter] public string ConfirmButtonClass { get; set; } = "bg-primary text-white hover:bg-primary-dark";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private Task Cancel() => OnCancel.InvokeAsync();
    private Task Confirm() => OnConfirm.InvokeAsync();
}
