@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using CLMS.Shared.Dtos
@using CLMS.Application.Identity.Services
@using CLMS.Domain.Enums

@inject AuthenticationService AuthService;
@inject CLMS.Web.Services.ToastService Toast;
@inject NavigationManager Navigation;

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">

        <div class="w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-xl bg-white shadow-xl">
            <div class="flex items-center justify-between
                        border-b border-gray-200 px-6 py-4">
                <h2 class="text-xl text-gray-900">Register User</h2>
                <button
                    type="button"
                    @onclick="Close"
                    class="text-2xl text-gray-400 hover:text-gray-600">
                    &times;
                </button>
            </div>
            
            <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-5 px-6 py-6">
                    <!-- Personal Information -->
                    <div>
                        <h3 class="mb-3 text-sm font-semibold text-gray-900">Personal Information</h3>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700">First Name</label>

                                <InputText
                                    readonly="@AccountCreated"
                                    @bind-Value="Model.FirstName"
                                    class="w-full rounded-lg border border-gray-300
                                           px-3 py-2 text-sm outline-none
                                           focus:border-primary
                                           focus:ring-2 focus:ring-primary/20" />

                                <ValidationMessage
                                    For="() => Model.FirstName"
                                    class="mt-1 text-xs text-error" />
                            </div>


                            <!-- Last Name -->
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700">
                                    Last Name
                                </label>

                                <InputText
                                    readonly="@AccountCreated"
                                    @bind-Value="Model.LastName"
                                    class="w-full rounded-lg border border-gray-300
                                           px-3 py-2 text-sm outline-none
                                           focus:border-primary
                                           focus:ring-2 focus:ring-primary/20" />

                                <ValidationMessage
                                    For="() => Model.LastName"
                                    class="mt-1 text-xs text-error" />
                            </div>


                            <!-- Middle Name -->
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700">
                                    Middle Name
                                    <span class="font-normal text-muted">
                                        (Optional)
                                    </span>
                                </label>

                                <InputText
                                    readonly="@AccountCreated"
                                    @bind-Value="Model.MiddleName"
                                    class="w-full rounded-lg border border-gray-300
                                           px-3 py-2 text-sm outline-none
                                           focus:border-primary
                                           focus:ring-2 focus:ring-primary/20" />
                            </div>


                            <!-- Suffix -->
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700">
                                    Suffix
                                    <span class="font-normal text-muted">
                                        (Optional)
                                    </span>
                                </label>

                                <InputText
                                    readonly="@AccountCreated"
                                    @bind-Value="Model.Suffix"
                                    placeholder="Jr., Sr., III"
                                    class="w-full rounded-lg border border-gray-300
                                           px-3 py-2 text-sm outline-none
                                           focus:border-primary
                                           focus:ring-2 focus:ring-primary/20" />
                            </div>
                        </div>
                    </div>


                    <!-- Account Information -->
                    <div>

                        <h3 class="mb-3 text-sm font-semibold text-gray-900">
                            Account Information
                        </h3>

                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                            <!-- Email -->
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700">
                                    Email
                                </label>

                                <InputText
                                    type="email"
                                    readonly="@AccountCreated"
                                    @bind-Value="Model.Email"
                                    class="w-full rounded-lg border border-gray-300
                                           px-3 py-2 text-sm outline-none
                                           focus:border-primary
                                           focus:ring-2 focus:ring-primary/20" />

                                <ValidationMessage
                                    For="() => Model.Email"
                                    class="mt-1 text-xs text-error" />
                            </div>


                            <!-- Role -->
                            <div>
                                <label class="mb-1 block text-sm font-medium text-gray-700">
                                    Role
                                </label>

                                <InputSelect disabled="@AccountCreated"
                                    @bind-Value="Model.UserRole"
                                    class="w-full rounded-lg border border-gray-300
                                           bg-white px-3 py-2 text-sm outline-none
                                           focus:border-primary
                                           focus:ring-2 focus:ring-primary/20">

                                    @foreach (var role in Enum.GetValues<Role>())
                                    {
                                        <option value="@role">
                                            @role
                                        </option>
                                    }

                                </InputSelect>

                            </div>




                        </div>

                    </div>


                    <div class="grid grid-cols-1 gap-4 px-0 sm:grid-cols-2">
                        <div>
                            <label for="register-password" class="mb-1 block text-sm font-medium">Initial password</label>
                            <InputText id="register-password" type="@(ShowPasswords ? "text" : "password")" @bind-Value="Model.Password" readonly="@AccountCreated" autocomplete="new-password" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
                            <ValidationMessage For="() => Model.Password" class="mt-1 text-xs text-error" />
                        </div>
                        <div>
                            <label for="register-confirm-password" class="mb-1 block text-sm font-medium">Confirm password</label>
                            <InputText id="register-confirm-password" type="@(ShowPasswords ? "text" : "password")" @bind-Value="Model.ConfirmPassword" readonly="@AccountCreated" autocomplete="new-password" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
                            <ValidationMessage For="() => Model.ConfirmPassword" class="mt-1 text-xs text-error" />
                        </div>
                        <button type="button" aria-pressed="@ShowPasswords" @onclick="() => ShowPasswords = !ShowPasswords" class="text-left text-sm text-primary underline">@(ShowPasswords ? "Hide passwords" : "Show passwords")</button>
                    </div>
                    <p class="text-sm text-muted">The account is created immediately. Its credentials and support contact are emailed to the user, who must change the initial password when signing in.</p>
                    <!-- =================================================
                         APPLICATION ERROR
                         ================================================= -->
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <div class="rounded-lg border border-error/20
                                    bg-error/10 px-4 py-3 text-sm text-error">

                            @ErrorMessage

                        </div>
                    }

                </div>


                <!-- =================================================
                     FOOTER
                     ================================================= -->
                <div class="flex justify-end gap-3
                            border-t border-gray-200 px-6 py-4">

                    <button
                        type="button"
                        @onclick="Close"
                        class="rounded-lg border border-gray-300
                               px-4 py-2.5 text-sm font-medium
                               text-gray-700 hover:bg-gray-50">
                        Cancel
                    </button>

                    <button
                        type="submit"
                        disabled="@(IsSubmitting || AccountCreated)"
                        class="rounded-lg bg-primary px-4 py-2.5
                               text-sm font-medium text-white
                               hover:bg-primary-dark
                               disabled:cursor-not-allowed
                               disabled:opacity-50">

                        @(IsSubmitting ? "Registering..." : "Register User")

                    </button>

                </div>

            </EditForm>

        </div>

    </div>
}


@code {

    // =============================================================
    // COMPONENT PARAMETERS
    // =============================================================

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    // Parent gets notified after successful registration.
    [Parameter]
    public EventCallback OnRegistered { get; set; }


    // =============================================================
    // FORM STATE
    // =============================================================

    private RegisterFormModel Model = new();
    private string? ErrorMessage;
    private bool IsSubmitting;
    private bool AccountCreated;
    private bool ShowPasswords;

    // =============================================================
    // SUBMIT
    // =============================================================
    
    private async Task HandleSubmit()
    {
        if (IsSubmitting || AccountCreated)
            return;

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var request = new RegisterDto(
                Model.FirstName,
                Model.LastName,
                Model.MiddleName,
                Model.Suffix,
                Model.Email,
                Model.UserRole,
                Model.Password
            );

            var result = await AuthService.RegisterAsync(request);
            AccountCreated = true;

            // Tell parent that registration succeeded.
            await OnRegistered.InvokeAsync();

            if (!result.EmailSent)
            {
                ErrorMessage = "Account created, but the credentials email could not be sent. Record these credentials and contact the user. Do not register this account again.";
                return;
            }
            Toast.Show("Account created. Credentials email sent.", CLMS.Web.Services.ToastService.ToastType.Success);
            await Close();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            // For example:
            // "A user with this email already exists."

            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
    private sealed class RegisterFormModel
    {
        [Required(ErrorMessage = "First name is required.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required.")]
        public string LastName { get; set; } = string.Empty;

        public string? MiddleName { get; set; }

        public string? Suffix { get; set; }

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        public Role UserRole { get; set; }
        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8)]
        public string Password { get; set; } = string.Empty;
    
        [Required(ErrorMessage = "Enter your password.")]
        [Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    // =============================================================
    // CLOSE
    // =============================================================

    private async Task Close()
    {
        Navigation.NavigateTo("/admin/users");
        Model = new();
        AccountCreated = false;
        ShowPasswords = false;
        ErrorMessage = null;

        await IsOpenChanged.InvokeAsync(false);
    }

    

}