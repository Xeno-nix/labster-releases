@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4"
         @onclick="Close">

        <div class="w-full max-w-md rounded-xl bg-white shadow-xl"
             @onclick:stopPropagation>

            <div class="flex items-center gap-3 border-b border-gray-200 px-5 py-4">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <span class="text-lg">ⓘ</span>
                </div>

                <h2 class="text-lg font-semibold text-gray-900">
                    @Title
                </h2>
            </div>

            <div class="px-5 py-5">
                <p class="text-sm text-gray-600">
                    @Message
                </p>
            </div>

            <div class="flex justify-end border-gray-200 px-5 pb-4">
                <button type="button"
                        @onclick="Close"
                        class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white
                               hover:bg-primary-dark focus:outline-none
                               focus:ring-2 focus:ring-primary/20">
                    OK
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = "Message";

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}