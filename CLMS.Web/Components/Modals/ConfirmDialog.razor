@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4"
         @onclick="Cancel">

        <div class="w-full max-w-md rounded-xl bg-white shadow-xl"
             @onclick:stopPropagation>

            <div class="flex items-center gap-3 border-b border-gray-200 px-5 py-4">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <span class="text-lg">?</span>
                </div>

                <h2 class="text-lg font-semibold text-gray-900">
                    @Title
                </h2>
            </div>

            <div class="px-5 py-5">
                <p class="text-sm text-gray-600">
                    @Message
                </p>
            </div>

            <div class="flex justify-end gap-3 border-t border-gray-200 px-5 py-4">
                <button type="button"
                        @onclick="Cancel"
                        class="rounded-lg border border-gray-300 px-4 py-2
                               text-sm font-medium text-gray-700
                               hover:bg-gray-50">
                    No
                </button>

                <button type="button"
                        @onclick="Confirm"
                        class="rounded-lg bg-primary px-4 py-2
                               text-sm font-medium text-white
                               hover:bg-primary-dark
                               focus:outline-none
                               focus:ring-2 focus:ring-primary/20">
                    Yes
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirm";

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<bool> OnResult { get; set; }

    private async Task Confirm()
    {
        IsOpen = false;
        await OnResult.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        IsOpen = false;
        await OnResult.InvokeAsync(false);
    }
}